# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public feed default
GARAGE_TEMP_FEED_URL=https://garage.robmcd.name/

# OpenWeather (home page weather block)
NEXT_PUBLIC_OPENWEATHER_API_KEY=
NEXT_PUBLIC_OPENWEATHER_CITY_ID=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_TOKEN=

# Email (Cloudflare Email binding + from/to addresses)
SMTP_MAIL_FROM=
SMTP_MAIL_TO=

# Stripe billing (member = CSV, pro = SMS/push/share/webhooks)
# Create monthly + annual prices in Stripe Dashboard, then paste IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_PRO_ANNUAL=

# Display-only prices for /pricing (USD, no currency symbol)
STRIPE_DISPLAY_MEMBER_MONTHLY=
STRIPE_DISPLAY_MEMBER_ANNUAL=
STRIPE_DISPLAY_PRO_MONTHLY=
STRIPE_DISPLAY_PRO_ANNUAL=

# Twilio SMS (Pro alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Site URL (OAuth callbacks, Stripe redirects)
SITE_URL=https://garage-temp.example.com
ORIGIN=https://garage-temp.example.com

# Background jobs (manual cron trigger)
CRON_SECRET=

# Optional ops alerts when cron jobs fail (email uses SMTP_MAIL_TO above)
OPS_DISCORD_WEBHOOK_URL=
