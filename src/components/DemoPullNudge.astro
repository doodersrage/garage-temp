---
import DemoPullQuickStart from "./DemoPullQuickStart";
import { getExampleFeedUrl } from "../lib/exampleFeed";

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const exampleFeedUrl = getExampleFeedUrl(Astro.site);
---

{show && (
  <section class="card" id="demo-pull-nudge">
    <h2 class="card-title">Try without hardware</h2>
    <p class="card-subtitle mb-4">
      Not ready for ESP wiring? Add our public example HTTPS feed — probe keys auto-import and Home shows
      simulated shop temperatures in one click.
    </p>
    <DemoPullQuickStart client:visible exampleFeedUrl={exampleFeedUrl} />
    <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
      Or open <a class="text-link" href="/dashboard/temperature?tab=pull#example-feed">Pull feeds</a> to paste the URL yourself.
    </p>
  </section>
)}
