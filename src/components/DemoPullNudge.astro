---
import DemoPullQuickStart from "./DemoPullQuickStart";
import { getExampleFeedUrl } from "../lib/exampleFeed";

interface Props {
  show: boolean;
  redirectTo?: string;
}

const { show, redirectTo = "/dashboard" } = Astro.props;
const exampleFeedUrl = getExampleFeedUrl(Astro.site);
---

{show && (
  <section class="card" id="demo-pull-nudge">
    <h2 class="card-title">Try without hardware</h2>
    <p class="card-subtitle mb-4">
      One click adds our public example HTTPS feed. Overview shows live temperatures with no ESP required.
    </p>
    <DemoPullQuickStart
      client:visible
      exampleFeedUrl={exampleFeedUrl}
      redirectTo={redirectTo}
      buttonLabel="Try demo feed"
    />
  </section>
)}
