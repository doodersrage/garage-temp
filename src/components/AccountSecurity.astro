---
import DashboardCard from "./dashboard/DashboardCard.astro";
import MfaEnroll from "./MfaEnroll.tsx";
---
<DashboardCard>
  <h2 class="card-title">Security (MFA)</h2>
  <p class="card-subtitle mb-3">
    Add an authenticator app (TOTP) or register a YubiKey OTP for two-factor sign-in.
  </p>
  <MfaEnroll client:visible />
</DashboardCard>
