---
interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
}

const { hasDevices, hasSensors, hasHistory } = Astro.props;

const steps = [
  {
    done: hasDevices,
    href: "/dashboard/temperature",
    title: "Connect a device or feed",
    detail: "Add a push ingest device (ESP/Arduino) or an HTTPS JSON pull feed.",
  },
  {
    done: hasSensors,
    href: "/dashboard/temperature",
    title: "Label your sensors",
    detail: "Map keys to friendly names so home and history cards are readable.",
  },
  {
    done: hasHistory,
    href: "/dashboard/history",
    title: "Review saved history",
    detail: "Snapshots collect automatically while feeds or devices are online (including hourly jobs).",
  },
];

const completedCount = steps.filter((step) => step.done).length;
---
<section class="card animate-slide-up-fade">
  <h2 class="card-title">Getting started</h2>
  <p class="card-subtitle">
    {completedCount} of {steps.length} setup steps complete
  </p>
  <div class="dashboard-onboarding">
    {steps.map((step, index) => (
      <a class="dashboard-onboarding-item" href={step.href}>
        <span class="dashboard-onboarding-step">{step.done ? "✓" : index + 1}</span>
        <span>
          <strong>{step.title}</strong>
          <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
        </span>
      </a>
    ))}
  </div>
</section>
