---
interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
  hasAlertsConfigured?: boolean;
  hasHouseholdMembers?: boolean;
  dismissed?: boolean;
}

const {
  hasDevices,
  hasSensors,
  hasHistory,
  hasAlertsConfigured = false,
  hasHouseholdMembers = false,
  dismissed = false,
} = Astro.props;

const coreSteps = [
  {
    done: hasDevices,
    href: "/dashboard/temperature",
    title: "Connect a device or feed",
    detail: "Add a push ingest device (ESP/Arduino) or an HTTPS JSON pull feed.",
  },
  {
    done: hasSensors,
    href: "/dashboard/temperature",
    title: "Label your sensors",
    detail: "Map keys to friendly names so home and history cards are readable.",
  },
  {
    done: hasHistory,
    href: "/dashboard/history",
    title: "Review saved history",
    detail: "Snapshots collect automatically while feeds or devices are online (including hourly jobs).",
  },
];

const nextSteps = [
  {
    done: hasAlertsConfigured,
    href: "/dashboard/alerts",
    title: "Set up alerts",
    detail: "Get freeze, humidity, and outage notifications.",
  },
  {
    done: hasHouseholdMembers,
    href: "/dashboard/household",
    title: "Invite your household",
    detail: "Share devices and history with family by email.",
  },
];

const coreDone = coreSteps.every((step) => step.done);
const optionalDone = nextSteps.every((step) => step.done);
const fullyDone = coreDone && optionalDone;
const completedCount = coreSteps.filter((step) => step.done).length;
const steps = coreDone ? nextSteps : coreSteps;
const hidden = dismissed || fullyDone;
---

{hidden ? (
  <section class="card">
    <p class="m-0 text-sm text-[var(--color-text-muted)]">
      {fullyDone
        ? "Setup complete."
        : "Getting started checklist is hidden."}
      {" "}
      <form action="/api/user/onboarding" method="post" class="inline">
        <input type="hidden" name="action" value="reset" />
        <input type="hidden" name="redirect" value="/dashboard" />
        <button type="submit" class="text-link bg-transparent border-0 p-0 cursor-pointer text-sm">
          Show checklist
        </button>
      </form>
    </p>
  </section>
) : (
  <section class="card animate-slide-up-fade">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="card-title">{coreDone ? "Next steps" : "Getting started"}</h2>
        <p class="card-subtitle mb-0">
          {coreDone
            ? "Core setup is done. Optional polish:"
            : `${completedCount} of ${coreSteps.length} setup steps complete`}
        </p>
      </div>
      {coreDone && (
        <form action="/api/user/onboarding" method="post">
          <input type="hidden" name="action" value="dismiss" />
          <input type="hidden" name="redirect" value="/dashboard" />
          <button class="btn-ghost" type="submit">Dismiss</button>
        </form>
      )}
    </div>
    <div class="dashboard-onboarding mt-4">
      {steps.map((step, index) => (
        <a class="dashboard-onboarding-item" href={step.href}>
          <span class="dashboard-onboarding-step">
            {step.done ? "✓" : index + 1}
          </span>
          <span>
            <strong>{step.title}</strong>
            <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
          </span>
        </a>
      ))}
    </div>
    {coreDone && (
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
        Quick links:
        <a class="text-link" href="/dashboard/share">Share</a> ·
        <a class="text-link" href="/dashboard/alerts">Alerts</a> ·
        <a class="text-link" href="/dashboard/household">Household</a> ·
        <a class="text-link" href="/dashboard#plans">Plans</a>
      </p>
    )}
  </section>
)}
