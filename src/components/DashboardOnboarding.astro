---
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
  hasAlertsEnabled?: boolean;
  hasEmailAlerts?: boolean;
  hasTestAlert?: boolean;
  hasHouseholdMembers?: boolean;
  hasLiveSensors?: boolean;
  hasHousehold?: boolean;
  dismissed?: boolean;
}

const {
  hasDevices,
  hasSensors,
  hasHistory,
  hasAlertsEnabled = false,
  hasEmailAlerts = false,
  hasTestAlert = false,
  hasHouseholdMembers = false,
  hasLiveSensors = false,
  hasHousehold = false,
  dismissed = false,
} = Astro.props;

const showFreezeMapCta = hasLiveSensors && hasHousehold;
const ingestVerified = hasLiveSensors || hasHistory;

/** Path most users need before winter. */
const essentialSteps = [
  {
    done: hasDevices,
    href: "/dashboard/temperature",
    title: "Connect a device or feed",
    detail: "Dashboard → Devices: add push ingest (ESP/Arduino) or an HTTPS JSON pull feed.",
  },
  {
    done: hasAlertsEnabled,
    href: "/dashboard/alerts#alert-section-triggers",
    title: "Set a freeze threshold",
    detail: "Open Triggers, pick the temperature that should fire before pipes or goods are at risk.",
  },
  {
    done: hasEmailAlerts,
    href: "/dashboard/alerts#alert-section-channels",
    title: "Enable email alerts",
    detail: "Check Email under Channels, confirm your address, and save.",
  },
  {
    done: hasTestAlert,
    href: "/dashboard/alerts#send-test-alert",
    title: "Send a test alert",
    detail: "Confirm delivery once so you trust the path before a real freeze night.",
  },
];

const kitSteps = [
  {
    done: hasSensors,
    href: "/dashboard/temperature#add-sensor",
    title: "Map sensor keys",
    detail: "Add a temp + humidity pair (or a single key) so ingest maps to readable names on Home.",
  },
  {
    done: ingestVerified,
    href: "/dashboard/temperature#verify-ingest-step",
    title: "Verify with a test POST",
    detail: "curl the ingest URL or follow the Arduino wiring guides until Home shows a live reading.",
  },
  {
    done: hasSensors,
    href: "/about/kit-qr-onboarding",
    title: "Optional: QR sticker",
    detail: "Print the in-app ingest QR from Devices for one-scan phone setup.",
  },
];

const nextSteps = [
  {
    done: hasHistory,
    required: true,
    href: "/dashboard/history",
    title: "Review saved history",
    detail: "Snapshots collect while feeds or devices are online.",
  },
  {
    done: hasHouseholdMembers,
    required: true,
    href: "/dashboard/household",
    title: "Invite your household",
    detail: "Share devices and alerts with family by email.",
  },
  {
    done: false,
    required: false,
    href: "/about/install-pwa",
    title: "Install on your phone",
    detail: "Add ThermalTrace to your home screen for faster access and optional push alerts.",
  },
];

const essentialDone = essentialSteps.every((step) => step.done);
const kitDone = kitSteps.every((step) => step.done);
const optionalDone = nextSteps.filter((step) => step.required).every((step) => step.done);
const fullyDone = essentialDone && kitDone && optionalDone;

const activeSteps = !essentialDone ? essentialSteps : !kitDone ? kitSteps : nextSteps;
const completedCount = activeSteps.filter((step) => step.done).length;
const progressPct = activeSteps.length
  ? Math.round((completedCount / activeSteps.length) * 100)
  : 100;

const sectionTitle = !essentialDone
  ? "Getting started"
  : !kitDone
    ? "Hardware setup"
    : "Next steps";
const sectionSubtitle = !essentialDone
  ? `${completedCount} of ${essentialSteps.length} essentials — device, threshold, email, test`
  : !kitDone
    ? `${completedCount} of ${kitSteps.length} hardware steps`
    : `${completedCount} of ${nextSteps.length} optional steps`;

if (dismissed || fullyDone) {
  return null;
}
---
<DashboardCard>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="card-title">{sectionTitle}</h2>
      <p class="card-subtitle mb-0">{sectionSubtitle}</p>
      <div
        class="onboarding-progress mt-3"
        role="progressbar"
        aria-label={`Setup progress: ${completedCount} of ${activeSteps.length} steps complete`}
        aria-valuenow={progressPct}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <div class="onboarding-progress-bar" style={`width: ${progressPct}%`}></div>
      </div>
    </div>
    {essentialDone && (
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value="dismiss" />
        <input type="hidden" name="redirect" value="/dashboard" />
        <button class="btn-ghost" type="submit">Dismiss</button>
      </form>
    )}
  </div>
  <div class="dashboard-onboarding mt-4">
    {activeSteps.map((step, index) => (
      <a class="dashboard-onboarding-item" href={step.href}>
        <span class="dashboard-onboarding-step">
          {step.done ? "✓" : index + 1}
        </span>
        <span>
          <strong>{step.title}</strong>
          <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
        </span>
      </a>
    ))}
  </div>
  {essentialDone && (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      Guides:
      <a class="text-link" href="/about/esp32-ota-firmware">ESP32 OTA</a> ·
      <a class="text-link" href="/about/kit-qr-onboarding">Kit QR</a> ·
      <a class="text-link" href="/about/ingest-and-webhooks">Ingest API</a> ·
      <a class="text-link" href="/freeze-map">Freeze map</a>
      {showFreezeMapCta && (
        <>
          {" · "}
          <a class="text-link" href="/dashboard/household">Opt in on map</a>
        </>
      )}
    </p>
  )}
</DashboardCard>
