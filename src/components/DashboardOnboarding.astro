---
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
  hasAlertsConfigured?: boolean;
  hasHouseholdMembers?: boolean;
  /** Live sensors present — show optional freeze-map CTA. */
  hasLiveSensors?: boolean;
  hasHousehold?: boolean;
  dismissed?: boolean;
}

const {
  hasDevices,
  hasSensors,
  hasHistory,
  hasAlertsConfigured = false,
  hasHouseholdMembers = false,
  hasLiveSensors = false,
  hasHousehold = false,
  dismissed = false,
} = Astro.props;

const showFreezeMapCta = hasLiveSensors && hasHousehold;

const kitSteps = [
  {
    done: hasDevices,
    href: "/dashboard/temperature",
    title: "Create a push device",
    detail: "Dashboard → Devices → add a push ingest device and copy the one-time key.",
  },
  {
    done: hasSensors,
    href: "/dashboard/temperature#add-sensor",
    title: "Add sensor keys",
    detail: "Match firmware keys (temp1, door1, …) so ingest maps correctly.",
  },
  {
    done: hasHistory || hasSensors,
    href: "/about/ingest-and-webhooks",
    title: "Verify with a test POST",
    detail: "curl the ingest URL, or follow the Arduino wiring / sketches guides.",
  },
  {
    done: hasHistory || hasSensors,
    href: "/dashboard/temperature",
    title: "Optional: QR sticker",
    detail: "After create/rotate on Devices, download or print the in-app ingest QR (no external generator).",
  },
  {
    done: hasAlertsConfigured,
    href: "/dashboard/alerts",
    title: "Enable freeze alerts",
    detail: "Turn on alerts and set a freeze threshold before winter.",
  },
];

const coreSteps = [
  {
    done: hasDevices,
    href: "/dashboard/temperature",
    title: "Connect a device or feed",
    detail: "Add a push ingest device (ESP/Arduino) or an HTTPS JSON pull feed.",
  },
  {
    done: hasSensors,
    href: "/dashboard/temperature",
    title: "Label your sensors",
    detail: "Map keys to friendly names so home and history cards are readable.",
  },
  {
    done: hasHistory,
    href: "/dashboard/history",
    title: "Review saved history",
    detail: "Snapshots collect automatically while feeds or devices are online (including hourly jobs).",
  },
];

const nextSteps = [
  {
    done: hasAlertsConfigured,
    href: "/dashboard/alerts",
    title: "Set up alerts",
    detail: "Get freeze, humidity, forecast, and outage notifications.",
  },
  {
    done: hasHouseholdMembers,
    href: "/dashboard/household",
    title: "Invite your household",
    detail: "Share devices and history with family by email.",
  },
];

const coreDone = coreSteps.every((step) => step.done);
const kitDone = kitSteps.every((step) => step.done);
const optionalDone = nextSteps.every((step) => step.done);
const fullyDone = coreDone && optionalDone && kitDone;
const activeSteps = !coreDone ? coreSteps : !kitDone ? kitSteps : nextSteps;
const completedCount = activeSteps.filter((step) => step.done).length;
const progressPct = activeSteps.length
  ? Math.round((completedCount / activeSteps.length) * 100)
  : 100;
const steps = activeSteps;
const sectionTitle = !coreDone
  ? "Getting started"
  : !kitDone
    ? "Hardware kit setup"
    : "Next steps";
const sectionSubtitle = !coreDone
  ? `${completedCount} of ${coreSteps.length} setup steps complete`
  : !kitDone
    ? `${completedCount} of ${kitSteps.length} kit steps complete`
    : `${completedCount} of ${nextSteps.length} optional steps complete`;

if (dismissed || fullyDone) {
  return null;
}
---
<DashboardCard>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="card-title">{sectionTitle}</h2>
      <p class="card-subtitle mb-0">{sectionSubtitle}</p>
      <div
        class="onboarding-progress mt-3"
        role="progressbar"
        aria-valuenow={progressPct}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <div class="onboarding-progress-bar" style={`width: ${progressPct}%`}></div>
      </div>
    </div>
    {(coreDone || kitDone) && (
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value="dismiss" />
        <input type="hidden" name="redirect" value="/dashboard" />
        <button class="btn-ghost" type="submit">Dismiss</button>
      </form>
    )}
  </div>
  <div class="dashboard-onboarding mt-4">
    {steps.map((step, index) => (
      <a class="dashboard-onboarding-item" href={step.href}>
        <span class="dashboard-onboarding-step">
          {step.done ? "✓" : index + 1}
        </span>
        <span>
          <strong>{step.title}</strong>
          <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
        </span>
      </a>
    ))}
  </div>
  {coreDone && (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      Guides:
      <a class="text-link" href="/about/ingest-and-webhooks">Ingest</a> ·
      <a class="text-link" href="/about/arduino-sketches">Arduino sketches</a> ·
      <a class="text-link" href="/about/arduino-circuit-wiring">Wiring</a> ·
      <a class="text-link" href="/freeze-map">Freeze map</a>
      {showFreezeMapCta && (
        <>
          {" · "}
          <a class="text-link" href="/dashboard/household">Freeze-map opt-in</a>
        </>
      )}
    </p>
  )}
</DashboardCard>
