---
const dsn = import.meta.env.SENTRY_DSN?.trim();
const enabled = import.meta.env.PROD && dsn && dsn !== "off";
---
{enabled && (
  <script
    define:vars={{ dsn }}
    is:inline
  >
    (function () {
      if (!dsn) return;
      var script = document.createElement("script");
      script.src = "https://browser.sentry-cdn.com/8.45.0/bundle.tracing.min.js";
      script.crossOrigin = "anonymous";
      script.onload = function () {
        if (window.Sentry) {
          window.Sentry.init({ dsn: dsn, tracesSampleRate: 0.1 });
        }
      };
      document.head.appendChild(script);
    })();
  </script>
)}
