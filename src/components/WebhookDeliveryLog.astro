---
import type { WebhookDeliveryRow } from "../lib/webhookDeliveries";
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  deliveries: WebhookDeliveryRow[];
}

const { deliveries } = Astro.props;

function typeLabel(type: string): string {
  if (type === "reading") return "Reading";
  if (type === "outbound_alert") return "Alert";
  return type;
}
---
<DashboardCard>
  <h2 class="card-title">Webhook delivery log</h2>
  <p class="card-subtitle mb-4">
    Recent POST attempts for outbound alert and reading webhooks (host only. URLs are not stored).
  </p>
  {deliveries.length === 0 ? (
    <p class="mb-0 text-sm text-[var(--color-text-muted)]">No webhook deliveries recorded yet.</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-[var(--color-text-muted)]">
            <th class="py-2 pr-3">When</th>
            <th class="py-2 pr-3">Type</th>
            <th class="py-2 pr-3">Host</th>
            <th class="py-2 pr-3">Status</th>
            <th class="py-2">Duration</th>
          </tr>
        </thead>
        <tbody>
          {deliveries.map((row) => (
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3 whitespace-nowrap">{new Date(row.created_at).toLocaleString()}</td>
              <td class="py-2 pr-3">{typeLabel(row.webhook_type)}</td>
              <td class="py-2 pr-3 font-mono text-xs">{row.url_host}</td>
              <td class="py-2 pr-3">
                {row.success ? (
                  <span class="text-[var(--color-success)]">{row.status_code ?? "OK"}</span>
                ) : (
                  <span class="text-[var(--color-danger)]" title={row.error_message ?? undefined}>
                    {row.status_code ?? "Failed"}
                  </span>
                )}
              </td>
              <td class="py-2">{row.duration_ms != null ? `${row.duration_ms}ms` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardCard>
