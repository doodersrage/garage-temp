---
import type { UserSubscription } from "../lib/stripeSubscriptions";
import { isActiveSubscriptionStatus } from "../lib/stripe";
import type { Entitlements } from "../lib/entitlements";
import { formatHistoryRetention } from "../lib/entitlements";
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  canDownloadCsv: boolean;
  subscription: UserSubscription | null;
  entitlements?: Entitlements | null;
  subscriptionNotice?: string | null;
  title?: string;
  showCsvNote?: boolean;
}

const {
  canDownloadCsv,
  subscription,
  entitlements = null,
  subscriptionNotice = null,
  title = "Plans",
  showCsvNote = true,
} = Astro.props;

const hasActiveSubscription =
  subscription !== null && isActiveSubscriptionStatus(subscription.status);
// "Pro or above" -- Portfolio is a strict superset of Pro (see entitlements.ts),
// so it needs to be included everywhere this gates "already has Pro-tier access"
// (upgrade-button visibility, etc.) rather than showing a Portfolio subscriber
// "Upgrade to Pro" buttons for a tier they've already surpassed.
const isProOrAbove =
  entitlements?.tier === "pro" ||
  entitlements?.tier === "portfolio" ||
  entitlements?.tier === "admin" ||
  subscription?.plan_tier === "pro" ||
  subscription?.plan_tier === "portfolio";
const tierLabel =
  entitlements?.tier ?? (isProOrAbove ? "pro" : canDownloadCsv ? "member" : "free");
const activeSubscriptionLabel =
  entitlements?.tier === "portfolio" ? "Portfolio" : isProOrAbove ? "Pro" : "Member";
---

<DashboardCard id="plans">
  <h2 class="card-title">{title}</h2>
  <p class="card-subtitle">
    Member unlocks CSV export, 90-day history, and forecast freeze warnings. Pro adds NWS cold-risk alerts, SMS, browser push, guest share links, a claims evidence pack, inbound/outbound webhooks, embed widgets, and a 14-day free trial.
    Annual billing is discounted versus monthly when those prices are configured in Stripe.
  </p>

  {subscriptionNotice === "success" && (
    <div class="alert-success mb-4" role="status">
      <p class="m-0">Subscription activated.</p>
    </div>
  )}

  {subscriptionNotice === "cancelled" && (
    <div class="alert-warning mb-4" role="status">
      <p class="m-0">Checkout was cancelled. You can subscribe whenever you are ready.</p>
    </div>
  )}

  <p class="mb-4 text-sm text-[var(--color-text-muted)]">
    Current plan: <strong class="text-[var(--color-text)]">{tierLabel}</strong>
    {entitlements ? ` · up to ${entitlements.maxDevices} push devices · ${formatHistoryRetention(entitlements.historyDays)} history` : ""}
    {" · "}
    <a class="text-link" href="/pricing">Full comparison</a>
  </p>

  {canDownloadCsv || isProOrAbove ? (
    <div class="card-muted">
      {showCsvNote && (
        <p class="m-0 mb-3 text-sm">
          {hasActiveSubscription
            ? `Your ${activeSubscriptionLabel} subscription is active.`
            : "Your account includes CSV export access."}
        </p>
      )}
      {hasActiveSubscription && (
        <form action="/api/stripe/portal" method="post" class="inline-block mr-3">
          <button class="btn-secondary" type="submit">
            Manage billing
          </button>
        </form>
      )}
      {hasActiveSubscription && !isProOrAbove && (
        <div class="inline-flex flex-wrap gap-2 mt-3 sm:mt-0">
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="monthly" />
            <button class="btn-primary" type="submit">Upgrade to Pro (monthly)</button>
          </form>
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="annual" />
            <button class="btn-secondary" type="submit">Pro annual</button>
          </form>
        </div>
      )}
      {!hasActiveSubscription && !isProOrAbove && (
        <div class="flex flex-wrap gap-2">
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="monthly" />
            <button class="btn-primary" type="submit">Upgrade to Pro (monthly)</button>
          </form>
          <form action="/api/stripe/checkout" method="post">
            <input type="hidden" name="plan" value="pro" />
            <input type="hidden" name="interval" value="annual" />
            <button class="btn-secondary" type="submit">Pro annual</button>
          </form>
        </div>
      )}
    </div>
  ) : (
    <div class="card-muted space-y-3">
      <div class="flex flex-wrap gap-2">
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="member" />
          <input type="hidden" name="interval" value="monthly" />
          <button class="btn-primary" type="submit">
            Member monthly
          </button>
        </form>
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="member" />
          <input type="hidden" name="interval" value="annual" />
          <button class="btn-secondary" type="submit">
            Member annual
          </button>
        </form>
      </div>
      <div class="flex flex-wrap gap-2">
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="pro" />
          <input type="hidden" name="interval" value="monthly" />
          <button class="btn-primary" type="submit">
            Pro monthly
          </button>
        </form>
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="pro" />
          <input type="hidden" name="interval" value="annual" />
          <button class="btn-secondary" type="submit">
            Pro annual
          </button>
        </form>
      </div>
    </div>
  )}
</DashboardCard>
