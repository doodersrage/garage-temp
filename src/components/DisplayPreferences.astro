---
import type { UserPreferences } from "../lib/userPreferences";

interface Props {
  preferences: UserPreferences;
  redirectTo?: string;
}

const { preferences, redirectTo = "/" } = Astro.props;
---

<form action="/api/user/preferences" method="post" class="card animate-zoom-in">
  <input type="hidden" name="redirect" value={redirectTo} />
  <h2 class="card-title">Home page display</h2>
  <p class="card-subtitle">Choose which blocks appear on the home page while you are signed in.</p>

  <div class="mb-6 flex flex-col gap-4">
    <label class="checkbox-row">
      <input
        type="checkbox"
        name="show_garage_temps"
        value="true"
        checked={preferences.showGarageTemps}
      />
      <span>Show garage temperatures</span>
    </label>

    <label class="checkbox-row">
      <input
        type="checkbox"
        name="show_weather"
        value="true"
        checked={preferences.showWeather}
      />
      <span>Show current weather</span>
    </label>

    <fieldset class="checkbox-group-nested">
      <legend class="checkbox-group-label">Weather location</legend>
      <div class="form-field mb-0">
        <label class="form-label" for="weather_city_id">OpenWeather city ID</label>
        <input
          type="text"
          name="weather_city_id"
          id="weather_city_id"
          class="form-input"
          value={preferences.weatherCityId ?? ""}
          placeholder="Leave blank to use the site default"
          inputmode="numeric"
          pattern="\d*"
        />
        <p class="preference-hint">
          Optional override for your home page weather block. Find city IDs in the
          <a
            class="text-link"
            href="https://openweathermap.org/find"
            target="_blank"
            rel="noreferrer"
          >
            OpenWeather city list
          </a>.
        </p>
      </div>
    </fieldset>
  </div>

  <button type="submit" class="btn-primary">
    Save display preferences
  </button>
</form>
