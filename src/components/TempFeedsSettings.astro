---
import type { TempFeedConfig } from "../lib/tempFeedConfig";
import { MAX_TEMP_FEEDS } from "../lib/tempFeedConfig";
import FeedTestButton from "./FeedTestButton";

interface Props {
  feeds: TempFeedConfig[];
  redirectTo?: string;
}

const { feeds, redirectTo = "/dashboard/temperature" } = Astro.props;

const feedRows = [...feeds];
if (feedRows.length < MAX_TEMP_FEEDS) {
  feedRows.push({ id: "", name: "", url: "", enabled: true });
}
---

<form action="/api/user/temp-feeds" method="post" class="card animate-zoom-in">
  <input type="hidden" name="redirect" value={redirectTo} />
  <h2 class="card-title">Feed URLs</h2>
  <p class="card-subtitle">
    Add HTTPS JSON feeds we should pull. Each feed should expose a <code>temp</code> object with probe keys.
    Optional top-level <code>battery_pct</code> and <code>rssi</code> update device health for pull feeds.
    Changes save as household <strong>Devices</strong> (pull source).
  </p>

  <div class="mb-6 flex flex-col gap-3">
    {feedRows.map((feed, index) => (
      <div class="config-row">
        <div class="config-row-actions">
          <span class="config-row-title">{feed.name || `Feed ${index + 1}`}</span>
          {feed.id && feed.url && (
            <button
              type="submit"
              class="btn-danger"
              formaction="/api/user/temp-feeds/delete"
              formmethod="post"
              name="feed_id"
              value={feed.id}
              onclick="return confirm('Delete this feed?');"
            >
              Delete feed
            </button>
          )}
        </div>
        <input type="hidden" name={`feed_${index}_id`} value={feed.id} />
        <div class="config-row-grid">
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_name`}>Feed name</label>
            <input
              class="form-input"
              type="text"
              id={`feed_${index}_name`}
              name={`feed_${index}_name`}
              value={feed.name}
              placeholder="Garage"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_url`}>Feed URL</label>
            <input
              class="form-input"
              type="url"
              id={`feed_${index}_url`}
              name={`feed_${index}_url`}
              value={feed.url}
              placeholder="https://example.com/temperature.json"
            />
            <FeedTestButton client:visible inputId={`feed_${index}_url`} />
          </div>
        </div>
        <label class="checkbox-row mt-3">
          <input
            type="checkbox"
            name={`feed_${index}_enabled`}
            value="true"
            checked={feed.enabled}
          />
          <span>Enabled</span>
        </label>
      </div>
    ))}
  </div>

  <button type="submit" class="btn-primary">Save feeds</button>
</form>
