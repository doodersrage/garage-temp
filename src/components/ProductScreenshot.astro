---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ProductShotId } from "../lib/productScreenshots";
import insightsImg from "../assets/marketing/thermaltrace-dashboard-insights.jpg";
import historyImg from "../assets/marketing/thermaltrace-dashboard-history.jpg";
import historyChartImg from "../assets/marketing/thermaltrace-dashboard-history-chart.jpg";
import devicesImg from "../assets/marketing/thermaltrace-dashboard-devices.jpg";
import overviewCardsImg from "../assets/marketing/thermaltrace-dashboard-overview-cards.jpg";
import overviewStatusImg from "../assets/marketing/thermaltrace-dashboard-overview-status.jpg";

interface Props {
  shot: ProductShotId;
  caption?: string;
  class?: string;
  /** Tighter framing for side-by-side layouts. */
  compact?: boolean;
  /** Max-width inset that scales the full shot (no vertical crop). */
  peek?: boolean;
}

type ShotMeta = { image: ImageMetadata; alt: string; defaultCaption: string };

const shots: Record<ProductShotId, ShotMeta> = {
  insights: {
    image: insightsImg,
    alt: "ThermalTrace Insights with seven-day probe curves, freeze threshold line, and nights-at-risk forecast",
    defaultCaption: "Insights — probe curves with your freeze threshold.",
  },
  history: {
    image: historyImg,
    alt: "ThermalTrace Reading History chart with probe traces and 34°F freeze line",
    defaultCaption: "History — week of probe traces against the freeze line.",
  },
  "history-chart": {
    image: historyChartImg,
    alt: "ThermalTrace temperature trend with humidity percent, dew point overlay, house thermostat reference, and 34°F freeze line",
    defaultCaption: "Temperature trend with humidity, dew point, and freeze guide.",
  },
  devices: {
    image: devicesImg,
    alt: "ThermalTrace Devices page showing Garage pull device health and connection options",
    defaultCaption: "Devices — ESP push, pull feeds, MQTT, and Home Assistant.",
  },
  "overview-cards": {
    image: overviewCardsImg,
    alt: "ThermalTrace Overview cards for freeze setup, connecting a device, and receiving live data",
    defaultCaption: "Overview — from first device to live readings.",
  },
  "overview-status": {
    image: overviewStatusImg,
    alt: "ThermalTrace Overview status strip showing last reading, sensors, feeds, and alerts",
    defaultCaption: "Overview status — last reading, sensors, feeds, alerts.",
  },
};

const { shot, caption, class: className, compact = false, peek = false } = Astro.props;
const item = shots[shot];
const captionText = caption ?? item.defaultCaption;
---
<figure class:list={["product-shot", compact && "product-shot--compact", peek && "product-shot--peek", className]}>
  <Image
    src={item.image}
    alt={item.alt}
    widths={compact || peek ? [400, 640, 800] : [480, 768, 1024, 1200]}
    sizes={compact || peek ? "(max-width: 767px) 100vw, 420px" : "(max-width: 767px) 100vw, 720px"}
    class="product-shot-img"
  />
  <figcaption class="product-shot-caption">{captionText}</figcaption>
</figure>
