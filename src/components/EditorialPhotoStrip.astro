---
import { Image } from "astro:assets";
import { getAboutPhoto, type AboutPhotoId } from "../lib/aboutPhotos";
import "../styles/about.css";

interface Props {
  photoIds: AboutPhotoId[];
  /** Optional short labels (e.g. which comparison each photo represents). */
  labels?: string[];
  /** Optional hrefs paired with labels. */
  hrefs?: string[];
  class?: string;
}

const { photoIds, labels = [], hrefs = [], class: className } = Astro.props;
const photos = photoIds.map((id, index) => ({
  ...getAboutPhoto(id),
  label: labels[index],
  href: hrefs[index],
}));
---

<section class:list={["editorial-photo-strip", className]} aria-label="Editorial photos">
  <div class="editorial-photo-strip-grid">
    {
      photos.map((photo) => (
        <figure class="editorial-photo-strip-item">
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 50vw, 25vw"
            class="editorial-photo-strip-img"
          />
          <figcaption>
            {photo.label ? (
              photo.href ? (
                <a class="editorial-photo-strip-label" href={photo.href}>{photo.label}</a>
              ) : (
                <span class="editorial-photo-strip-label">{photo.label}</span>
              )
            ) : null}
            <a
              class="about-figure-credit"
              href={photo.sourceUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              {photo.credit}
            </a>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .editorial-photo-strip-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .editorial-photo-strip-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .editorial-photo-strip-item {
    margin: 0;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .editorial-photo-strip-img {
    display: block;
    width: 100%;
    height: 7.5rem;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .editorial-photo-strip-img {
      height: 9rem;
    }
  }

  .editorial-photo-strip-item figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.4rem 0.6rem 0.55rem;
  }

  .editorial-photo-strip-label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    text-decoration: none;
  }

  a.editorial-photo-strip-label:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .editorial-photo-strip-item .about-figure-credit {
    font-size: 0.65rem;
    line-height: 1.3;
  }
</style>
