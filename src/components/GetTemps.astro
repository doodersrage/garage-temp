---
Astro.cache.set({
  maxAge: 1300,
  swr: 600,
});
import { fetchTemps } from '../lib/FetchTemps';
const temps = await fetchTemps();

const probes = [
  { label: 'Probe 0', data: temps.temp["0"] },
  { label: 'Probe 1', data: temps.temp["1"] },
  { label: 'Average', data: temps.temp["avg"] },
];
---

<section class="card animate-slide-in-left">
  <h2 class="card-title">Garage Temperatures</h2>
  <p class="card-subtitle">Live readings from the garage temperature sensors.</p>
  <div class="stat-grid">
    {probes.map(({ label, data }) => (
      <article class="stat-item">
        <span class="stat-label">{label}</span>
        <p class="stat-value">{data.f}°F</p>
        <p class="stat-detail">{data.c}°C · {data.h}% humidity</p>
      </article>
    ))}
  </div>
</section>
