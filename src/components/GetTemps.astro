---
import { fetchTemps } from '../lib/FetchTemps';
import type { TempFeedConfig, TempProbeConfig } from '../lib/tempFeedConfig';
import {
  buildDisplayProbes,
  getDefaultTempFeeds,
  getDefaultTempProbes,
  usesDefaultTempConfig,
} from '../lib/tempFeedConfig';

interface Props {
  feeds?: TempFeedConfig[];
  probes?: TempProbeConfig[];
}

const {
  feeds = getDefaultTempFeeds(),
  probes = getDefaultTempProbes(),
} = Astro.props;

if (usesDefaultTempConfig(feeds, probes)) {
  Astro.cache.set({
    maxAge: 1300,
    swr: 600,
  });
}

const feedResults = await fetchTemps({ feeds, probes, saveToDatabase: true });
const displayProbes = buildDisplayProbes(feedResults, probes);
const feedErrors = feedResults.filter((feed) => feed.error);
const multipleFeeds = feeds.filter((feed) => feed.enabled).length > 1;
---

<section class="card animate-slide-in-left">
  <h2 class="card-title">Garage Temperatures</h2>
  <p class="card-subtitle">Live readings from your configured temperature feeds.</p>

  {feedErrors.length > 0 && (
    <div class="alert-warning mb-4">
      {feedErrors.map((feed) => (
        <p class="m-0">{feed.name}: {feed.error}</p>
      ))}
    </div>
  )}

  {displayProbes.length === 0 ? (
    <div class="empty-state">
      <p>No probe readings are available. Update your feed and probe settings on the dashboard.</p>
    </div>
  ) : (
    <div class="stat-grid">
      {displayProbes.map(({ id, label, feedName, data }) => (
        <article class="stat-item">
          <span class="stat-label">
            {multipleFeeds ? `${feedName} · ${label}` : label}
          </span>
          <p class="stat-value">{data.f}°F</p>
          <p class="stat-detail">{data.c}°C · {data.h}% humidity</p>
        </article>
      ))}
    </div>
  )}
</section>
