---
import type { PaginatedGarageTemps, ChartPoint } from "../lib/garageTempsHistory";
import HistoryChart from "./HistoryChart";
import {
  formatReadingTimestamp,
  getReadingFeedName,
  getReadingProbeLabel,
} from "../lib/garageTempsHistory";

interface Props {
  history: PaginatedGarageTemps;
  chartPoints: ChartPoint[];
  basePath?: string;
  canDownloadCsv?: boolean;
  feedFilter?: string;
  probeFilter?: string;
  filterOptions?: {
    feeds: string[];
    probes: { key: string; label: string }[];
  };
}

const {
  history,
  chartPoints,
  basePath = "/dashboard/history",
  canDownloadCsv = false,
  feedFilter = "",
  probeFilter = "",
  filterOptions = { feeds: [], probes: [] },
} = Astro.props;
const { readings, page, pageSize, totalCount, totalPages, error } = history;

const showingFrom = totalCount === 0 ? 0 : (page - 1) * pageSize + 1;
const showingTo = totalCount === 0 ? 0 : Math.min(page * pageSize, totalCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < totalPages ? page + 1 : null;

function buildFilterUrl(nextFeed: string, nextProbe: string, nextPage = 1): string {
  const params = new URLSearchParams();
  params.set("page", String(nextPage));
  if (nextFeed) params.set("feed", nextFeed);
  if (nextProbe) params.set("probe", nextProbe);
  return `${basePath}?${params.toString()}`;
}
---

<section class="card">
  <div class="card-header-row">
    <div>
      <h2 class="card-title">Historic probe readings</h2>
      <p class="card-subtitle">
        Temperature and humidity snapshots saved for your configured feeds and probes when you load the home page while signed in.
      </p>
    </div>
    {!error && totalCount > 0 && canDownloadCsv && (
      <a class="btn-secondary" href="/api/garage-temps/export.csv" download>
        Download CSV
      </a>
    )}
  </div>

  {(filterOptions.feeds.length > 0 || filterOptions.probes.length > 0) && (
    <form class="history-filters" method="get" action={basePath}>
      <div class="form-field mb-0">
        <label class="form-label" for="feed-filter">Feed</label>
        <select class="form-input" id="feed-filter" name="feed">
          <option value="">All feeds</option>
          {filterOptions.feeds.map((feed) => (
            <option value={feed} selected={feedFilter === feed}>{feed}</option>
          ))}
        </select>
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="probe-filter">Probe</label>
        <select class="form-input" id="probe-filter" name="probe">
          <option value="">All probes</option>
          {filterOptions.probes.map((probe) => (
            <option value={probe.key} selected={probeFilter === probe.key}>{probe.label}</option>
          ))}
        </select>
      </div>
      <button type="submit" class="btn-secondary self-end">Apply filters</button>
    </form>
  )}

  <HistoryChart client:visible points={chartPoints} />

  {error ? (
    <div class="empty-state">
      <p>Unable to load historic readings: {error}</p>
    </div>
  ) : readings.length === 0 ? (
    <div class="empty-state">
      <p>No historic readings have been saved yet. Load the home page while signed in to record readings from your configured feeds and probes.</p>
    </div>
  ) : (
    <>
      <div class="table-wrap">
        <table class="data-table data-table-history">
          <thead>
            <tr>
              <th scope="col">Recorded</th>
              <th scope="col">Feed</th>
              <th scope="col">Probe</th>
              <th scope="col">Temperature (°F)</th>
              <th scope="col">Temperature (°C)</th>
              <th scope="col">Humidity</th>
            </tr>
          </thead>
          <tbody>
            {readings.map((reading) => (
              <tr>
                <td>{formatReadingTimestamp(reading.timestamp)}</td>
                <td>{getReadingFeedName(reading)}</td>
                <td>{getReadingProbeLabel(reading)}</td>
                <td>{Number(reading.tempf).toFixed(1)}</td>
                <td>{Number(reading.tempc).toFixed(1)}</td>
                <td>{Number(reading.humidity).toFixed(1)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p class="pagination-summary">
          Showing {showingFrom}–{showingTo} of {totalCount} readings
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={buildFilterUrl(feedFilter, probeFilter, prevPage)}>Previous</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Previous</span>
          )}
          <span class="pagination-current">Page {page} of {totalPages}</span>
          {nextPage ? (
            <a class="btn-secondary" href={buildFilterUrl(feedFilter, probeFilter, nextPage)}>Next</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Next</span>
          )}
        </div>
      </div>
    </>
  )}
</section>
