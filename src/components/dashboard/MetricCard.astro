---
interface Props {
  label: string;
  value: string;
  detail?: string | null;
  href?: string | null;
  tone?: "neutral" | "success" | "warning" | "danger";
  class?: string;
}

const {
  label,
  value,
  detail = null,
  href = null,
  tone = "neutral",
  class: className,
} = Astro.props;

const toneClass =
  tone === "success"
    ? "text-[var(--color-success-text)]"
    : tone === "warning"
      ? "text-amber-400"
      : tone === "danger"
        ? "text-[var(--color-danger)]"
        : "text-foreground";

const Tag = href ? "a" : "article";
---
<Tag
  href={href ?? undefined}
  class:list={[
    "col-span-12 sm:col-span-6 lg:col-span-3 rounded-xl border border-border bg-card p-4",
    href && "transition-colors hover:border-[var(--color-border-strong)]",
    className,
  ]}
>
  <span class="block text-xs font-medium uppercase tracking-wide text-muted-foreground mb-1">
    {label}
  </span>
  <p class:list={["m-0 text-lg font-semibold leading-tight", toneClass]}>{value}</p>
  {detail && (
    <p class="m-0 mt-1 text-sm text-muted-foreground">{detail}</p>
  )}
</Tag>
