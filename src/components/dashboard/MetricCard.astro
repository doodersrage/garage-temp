---
interface Props {
  label: string;
  value: string;
  detail?: string | null;
  href?: string | null;
  tone?: "neutral" | "success" | "warning" | "danger";
  class?: string;
}

const {
  label,
  value,
  detail = null,
  href = null,
  tone = "neutral",
  class: className,
} = Astro.props;

const toneClass =
  tone === "success"
    ? "text-[var(--color-success-text)]"
    : tone === "warning"
      ? "text-[var(--color-warning-text)]"
      : tone === "danger"
        ? "text-[var(--color-danger)]"
        : "text-foreground";

const Tag = href ? "a" : "article";
---
<Tag
  href={href ?? undefined}
  class:list={[
    "stat-item col-span-12 sm:col-span-6 lg:col-span-3",
    href && "no-underline transition-colors hover:border-[var(--color-border-strong)]",
    className,
  ]}
>
  <span class="stat-label">{label}</span>
  <p class:list={["stat-value !text-lg", toneClass]}>{value}</p>
  {detail && <p class="stat-detail">{detail}</p>}
</Tag>
