---
interface Props {
  show: boolean;
}

const { show } = Astro.props;
---
{show && (
  <section class="card" id="probe-simulator-nudge" aria-labelledby="probe-simulator-nudge-title">
    <h2 class="card-title" id="probe-simulator-nudge-title">Still exploring?</h2>
    <p class="card-subtitle mb-4">
      Cause a cold snap or door draft in the interactive simulator — same Overview space-status logic,
      no hardware required. When you’re ready, come back and connect a real probe.
    </p>
    <div class="flex flex-wrap gap-3">
      <a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">Open probe simulator</a>
      <a class="btn-ghost" href="/about/probe-demo?preset=doorDraft">Try door draft</a>
    </div>
  </section>
)}
