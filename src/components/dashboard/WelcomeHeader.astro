---
interface Props {
  email: string | null | undefined;
  planTier: string;
  passwordUpdated?: boolean;
  prefsSaved?: boolean | string | null;
  prefsError?: boolean | string | null;
}

const {
  passwordUpdated = false,
  prefsSaved = false,
  prefsError = false,
} = Astro.props;
---
<header class="dashboard-overview-header">
  <div class="dashboard-overview-copy">
    <p class="dashboard-overview-kicker">Operations</p>
    <p class="dashboard-overview-lead mb-0">
      Sensor health, freeze risk, and account controls in one place.
    </p>
  </div>
  <div class="dashboard-overview-aside">
    <a class="btn-secondary" href="/dashboard/temperature">Devices</a>
    <a class="btn-primary" href="/dashboard/alerts">Alerts</a>
  </div>
  {(passwordUpdated || prefsSaved || prefsError) && (
    <div class="dashboard-overview-notices">
      {passwordUpdated && (
        <p class="alert-success mt-0 mb-0" role="status">Password updated.</p>
      )}
      {prefsSaved && (
        <p class="alert-success mt-0 mb-0" role="status">Display preferences saved.</p>
      )}
      {prefsError && (
        <p class="alert-warning mt-0 mb-0" role="alert">Could not save display preferences.</p>
      )}
    </div>
  )}
</header>
