---
import DashboardCard from "./DashboardCard.astro";

interface Props {
  email: string | null | undefined;
  planTier: string;
  passwordUpdated?: boolean;
  prefsSaved?: boolean | string | null;
  prefsError?: boolean | string | null;
}

const {
  email,
  planTier,
  passwordUpdated = false,
  prefsSaved = false,
  prefsError = false,
} = Astro.props;
---
<DashboardCard class="col-span-12 animate-slide-in-left">
  <h1 class="card-title">Welcome back</h1>
  <p class="card-subtitle">{email}</p>
  <p class="mb-0 text-foreground">
    Manage your home page display, alerts, household sharing, and probe readings.
  </p>
  <p class="mt-3 mb-0 text-sm text-muted-foreground">
    Plan: <strong class="text-foreground">{planTier}</strong>
    {" · "}
    <a class="text-link" href="/dashboard/plans">Compare plans</a>
  </p>
  {passwordUpdated && (
    <p class="alert-success mt-4 mb-0" role="status">Password updated.</p>
  )}
  {prefsSaved && (
    <p class="alert-success mt-4 mb-0" role="status">Display preferences saved.</p>
  )}
  {prefsError && (
    <p class="alert-warning mt-4 mb-0" role="alert">Could not save display preferences.</p>
  )}
</DashboardCard>
