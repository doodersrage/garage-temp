---
interface Props {
  dismissedKey?: string;
}

const { dismissedKey = "dashboard_story_dismiss" } = Astro.props;
---
<aside class="card card-muted dashboard-story-card" data-nudge-key={dismissedKey} role="note">
  <div class="dashboard-story-body">
    <p class="dashboard-story-eyebrow">Real-world freeze alert</p>
    <p class="dashboard-story-title">How probe data caught a garage cold snap before damage</p>
    <p class="dashboard-story-text">
      Read the case study for placement, thresholds, and what the alert trail looked like when pipes were at risk.
    </p>
  </div>
  <div class="dashboard-story-actions">
    <a class="btn-secondary" href="/stories/garage-freeze-alert">Read case study</a>
    <a class="btn-ghost" href="/about/temperature-probe-case-study">Technical deep dive</a>
    <button type="button" class="btn-ghost dashboard-story-dismiss" data-dismiss={dismissedKey}>
      Dismiss
    </button>
  </div>
</aside>

<script is:inline>
  (() => {
    document.querySelectorAll(".dashboard-story-card[data-nudge-key]").forEach((el) => {
      const key = el.getAttribute("data-nudge-key");
      if (key && localStorage.getItem(key) === "1") {
        el.remove();
      }
    });
    document.querySelectorAll(".dashboard-story-dismiss").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-dismiss");
        const card = btn.closest(".dashboard-story-card");
        if (key) localStorage.setItem(key, "1");
        card?.remove();
      });
    });
  })();
</script>
