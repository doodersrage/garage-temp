---
import DashboardCard from "./DashboardCard.astro";
import type { EnergyOverview } from "../../lib/overviewExtras";
import { formatRelativeAge } from "../../lib/relativeTime";

interface Props {
  energy: EnergyOverview;
  coolingRateFPerHour?: number | null;
}

const { energy, coolingRateFPerHour = null } = Astro.props;
const age = formatRelativeAge(energy.at);
---
<DashboardCard>
  <h2 class="card-title">Power draw</h2>
  <p class="card-subtitle mb-3">
    {energy.label} — heater / load proxy from energy sensor.
  </p>
  <p class="stat-value m-0">{energy.latestW.toFixed(0)} W</p>
  <p class="m-0 mt-1 text-sm text-[var(--color-text-muted)]">
    Avg {energy.avgW.toFixed(0)} W · ~{energy.estimatedKWh.toFixed(1)} kWh over samples · {age.label}
  </p>
  {coolingRateFPerHour != null && coolingRateFPerHour < -0.5 && energy.latestW < 50 && (
    <p class="alert-warning mt-3 mb-0 text-sm">
      Space cooling ~{Math.abs(coolingRateFPerHour).toFixed(1)}°F/h while power is low —
      heater may be off or undersized.
    </p>
  )}
  {coolingRateFPerHour != null && coolingRateFPerHour > 0.3 && energy.latestW > 200 && (
    <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
      Load active (~{energy.latestW.toFixed(0)} W) while space is warming.
    </p>
  )}
</DashboardCard>
