---
import DashboardCard from "./DashboardCard.astro";
import type { RegionalBenchmark } from "../../lib/regionalBenchmark";

interface Props {
  benchmark: RegionalBenchmark;
}

const { benchmark } = Astro.props;
const delta = benchmark.deltaF;
const warmer = delta != null && delta > 0;
---
<DashboardCard>
  <h2 class="card-title">Regional comparison</h2>
  <p class="card-subtitle mb-3">
    Your coldest probe vs other opted-in garages in {benchmark.cityLabel}.
  </p>
  <p class="text-2xl font-bold mb-2">
    {benchmark.yourTempF.toFixed(1)}°F
    {benchmark.cityAvgTempF != null && (
      <span class="text-base font-normal text-[var(--color-text-muted)]">
        {" "}· city avg {benchmark.cityAvgTempF.toFixed(1)}°F
      </span>
    )}
  </p>
  <p class="mb-0 text-sm text-[var(--color-text-muted)]">{benchmark.message}</p>
  {delta != null && Math.abs(delta) >= 1.5 && (
    <p class="mt-3 mb-0 text-sm">
      {warmer ? "Warmer" : "Colder"} than typical by about {Math.abs(delta).toFixed(1)}°F right now.
    </p>
  )}
  <p class="mt-4 mb-0 text-xs text-[var(--color-text-muted)]">
    <a class="text-link" href="/freeze-map">Public freeze map</a>
    {" · "}
    <a class="text-link" href="/dashboard/household#freeze-map">Map settings</a>
  </p>
</DashboardCard>
