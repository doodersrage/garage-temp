---
import DashboardCard from "./DashboardCard.astro";

interface Props {
  title: string;
  subtitle?: string;
  headline: string;
  detail: string;
  tone?: "warning" | "info";
  href?: string | null;
  hrefLabel?: string | null;
}

const {
  title,
  subtitle = "",
  headline,
  detail,
  tone = "info",
  href = null,
  hrefLabel = null,
} = Astro.props;
---
<DashboardCard>
  <h2 class="card-title">{title}</h2>
  {subtitle && <p class="card-subtitle mb-3">{subtitle}</p>}
  <div class:list={[tone === "warning" ? "alert-warning" : "alert-info", "mb-0"]}>
    <p class="m-0 mb-1"><strong>{headline}</strong></p>
    <p class="m-0 text-sm">{detail}</p>
  </div>
  {href && hrefLabel && (
    <p class="mt-3 mb-0 text-sm">
      <a class="text-link" href={href}>{hrefLabel}</a>
    </p>
  )}
</DashboardCard>
