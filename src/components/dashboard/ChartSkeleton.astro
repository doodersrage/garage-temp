---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div
  class:list={[
    "flex min-h-[300px] flex-col justify-end gap-3 rounded-lg border border-border/60 bg-muted/50 p-4",
    className,
  ]}
  aria-hidden="true"
>
  <div class="flex flex-1 items-end gap-2">
    <div class="h-[35%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[55%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[42%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[70%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[48%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[62%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[40%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
    <div class="h-[75%] flex-1 animate-pulse rounded-sm bg-border/60"></div>
  </div>
  <div class="h-2 w-1/3 animate-pulse rounded bg-border/60"></div>
</div>
