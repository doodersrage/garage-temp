---
/**
 * Empty / first-device path on Devices — one clear job per intent.
 */
interface Props {
  canEdit: boolean;
  atDeviceLimit: boolean;
  redirectTo: string;
  nestEntitled: boolean;
}

const { canEdit, atDeviceLimit, redirectTo, nestEntitled } = Astro.props;
---
<section class="card devices-first-run" id="devices-first-run" aria-labelledby="devices-first-run-title">
  <h2 class="card-title" id="devices-first-run-title">Connect your first probe</h2>
  <p class="card-subtitle mb-4">
    Pick how you want to get readings in — you can add more paths later.
  </p>

  <div class="devices-intent-grid" role="list">
    <div class="devices-intent" role="listitem">
      <h3 class="devices-intent-title">ESP / Arduino</h3>
      <p class="devices-intent-copy">
        Create a push device, download a pre-filled ESP32 sketch, set Wi‑Fi, and POST once — sensors auto-import.
      </p>
      {canEdit && !atDeviceLimit ? (
        <div class="flex flex-wrap gap-2">
          <form action="/api/devices" method="post">
            <input type="hidden" name="action" value="create_push" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <input type="hidden" name="name" value="Workshop probe" />
            <button class="btn-primary" type="submit">Create push device</button>
          </form>
          <a class="btn-ghost" href="/about/esp32-freeze-kit">Parts list</a>
        </div>
      ) : atDeviceLimit ? (
        <div class="flex flex-wrap gap-2">
          <a class="btn-secondary" href="/dashboard/plans">Upgrade for more devices</a>
          <a class="btn-ghost" href="/about/esp32-freeze-kit">Parts list</a>
        </div>
      ) : (
        <div class="flex flex-wrap gap-2 items-center">
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">View-only — ask an owner to create a device.</p>
          <a class="btn-ghost" href="/about/esp32-freeze-kit">Parts list</a>
        </div>
      )}
    </div>

    <div class="devices-intent" role="listitem">
      <h3 class="devices-intent-title">Demo feed</h3>
      <p class="devices-intent-copy">
        No hardware yet? Pull our public example HTTPS JSON and see Overview fill in.
      </p>
      <a class="btn-secondary" href="#demo-pull-nudge">Try demo feed</a>
    </div>

    <div class="devices-intent" role="listitem">
      <h3 class="devices-intent-title">Home Assistant</h3>
      <p class="devices-intent-copy">
        HACS polls a share link, or push from HA automations with an ingest key.
      </p>
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href="/dashboard/share/links">Create share link</a>
        <a class="btn-ghost" href="/integrations/home-assistant">HACS guide</a>
      </div>
    </div>

    <div class="devices-intent" role="listitem">
      <h3 class="devices-intent-title">MQTT bridge</h3>
      <p class="devices-intent-copy">
        Keep Mosquitto on the LAN; mirror topics to ThermalTrace over HTTPS.
      </p>
      <a class="btn-secondary" href="/about/mqtt-bridge">MQTT recipe</a>
    </div>

    <div class="devices-intent" role="listitem">
      <h3 class="devices-intent-title">Nest / Ecobee</h3>
      <p class="devices-intent-copy">
        {nestEntitled
          ? "Connect house thermostat context on the Pull feeds tab (Pro)."
          : "Indoor house context via Nest/Ecobee OAuth is on Pro — or push climate temp from HA."}
      </p>
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href="/dashboard/temperature?tab=pull#thermostat-connect">
          Pull feeds & thermostats
        </a>
        {!nestEntitled && (
          <a class="btn-ghost" href="/dashboard/plans">View Pro</a>
        )}
      </div>
    </div>
  </div>

  <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
    Still exploring placement?
    {" "}
    <a class="text-link" href="/about/probe-demo">Open the interactive probe simulator</a>
    {" · "}
    <a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>
    {" · "}
    <a class="text-link" href="/docs/api">HTTP API quick reference</a>
  </p>
</section>

<style>
  .devices-intent-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .devices-intent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .devices-intent-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .devices-intent {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface-muted, transparent) 80%, transparent);
  }

  .devices-intent-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .devices-intent-copy {
    margin: 0;
    flex: 1;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }
</style>
