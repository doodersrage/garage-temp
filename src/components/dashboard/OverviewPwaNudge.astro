---
interface Props {
  show: boolean;
}

const { show } = Astro.props;
---
{show && (
  <section class="card" id="overview-pwa-nudge" aria-labelledby="overview-pwa-nudge-title">
    <h2 class="card-title" id="overview-pwa-nudge-title">Install on your phone</h2>
    <p class="card-subtitle mb-4">
      Add ThermalTrace to your home screen for faster access, optional browser push lives under Alerts.
    </p>
    <div class="flex flex-wrap gap-3">
      <a class="btn-secondary" href="/dashboard/settings#pwa-install">Install / PWA</a>
      <a class="btn-ghost" href="/about/install-pwa">Install guide</a>
    </div>
  </section>
)}
