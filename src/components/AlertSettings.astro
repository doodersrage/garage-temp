---
import type { AlertSettings } from "../lib/alerts";
import type { Entitlements } from "../lib/entitlements";
import { CONDITION_OPTIONS } from "../lib/alertRules";

interface Props {
  userEmail: string;
  settings: AlertSettings;
  entitlements: Entitlements;
  vapidPublicKey?: string;
  redirectTo?: string;
  canEdit?: boolean;
}

const {
  userEmail,
  settings,
  entitlements,
  vapidPublicKey = "",
  redirectTo = "/dashboard/alerts",
  canEdit = true,
} = Astro.props;

const templateKinds = [
  "threshold",
  "forecast",
  "rate",
  "outage",
  "rule",
  "battery",
  "rssi",
] as const;

const needsPro =
  !entitlements.canUseSms ||
  !entitlements.canUsePush ||
  !entitlements.canUseOutboundWebhook;

const rulesJson = JSON.stringify(settings.alertRules ?? []);
---
<div class="card animate-slide-up-fade">
{!canEdit && (
  <p class="alert-warning mb-4" role="status">
    View-only — alert settings cannot be changed on this account.
  </p>
)}
<form action="/api/user/alert-settings" method="post" id="alert-settings-form">
  <fieldset disabled={!canEdit} class="border-0 p-0 m-0 min-w-0">
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="alert_rules_json" id="alert_rules_json" value={rulesJson} />
  <h2 class="card-title">When to notify you</h2>
  <p class="card-subtitle">
    Choose thresholds, rules, and channels. Free plans include email, Discord, Telegram, and Slack; SMS, browser push, and outbound webhooks need Pro.
  </p>

  <label class="checkbox-row mb-3">
    <input type="checkbox" name="alerts_enabled" value="true" checked={settings.enabled} />
    <span>Turn on alerts</span>
  </label>

  <label class="checkbox-row mb-4">
    <input type="checkbox" name="digest_enabled" value="true" checked={settings.digestEnabled} />
    <span>Weekly email digest (Mondays)</span>
  </label>

  <label class="checkbox-row mb-4">
    <input type="checkbox" name="monthly_report_enabled" value="true" checked={settings.monthlyReportEnabled} />
    <span>Monthly freeze report email (1st of month, with HTML attachment)</span>
  </label>

  <h3 class="text-base font-semibold mb-2">Snooze & vacation</h3>
  <p class="card-subtitle mb-3">
    Snooze pauses most alerts for 24h (outage still fires). Vacation suppresses non-critical alerts for 7 days.
    {settings.snoozeUntil && (
      <span class="block mt-1">Snoozed until {new Date(settings.snoozeUntil).toLocaleString()}.</span>
    )}
    {settings.vacationUntil && (
      <span class="block mt-1">Vacation until {new Date(settings.vacationUntil).toLocaleString()}.</span>
    )}
  </p>
  <div class="flex flex-wrap gap-2 mb-4">
    <button type="submit" class="btn-secondary" form="alert-snooze-24-form">Snooze 24h</button>
    <button type="submit" class="btn-secondary" form="alert-snooze-vacation-form">Vacation 7d</button>
    {settings.snoozeUntil && (
      <button type="submit" class="btn-secondary" form="alert-snooze-clear-form">Clear snooze</button>
    )}
    {settings.vacationUntil && (
      <button type="submit" class="btn-secondary" form="alert-vacation-clear-form">End vacation</button>
    )}
  </div>

  <h3 class="text-base font-semibold mb-2">Device health alerts</h3>
  <div class="config-row-grid mb-4">
    <label class="checkbox-row mb-0">
      <input type="checkbox" name="battery_alerts_enabled" value="true" checked={settings.batteryAlertsEnabled} />
      <span>Low battery alerts</span>
    </label>
    <label class="checkbox-row mb-0">
      <input type="checkbox" name="battery_trend_alerts_enabled" value="true" checked={settings.batteryTrendAlertsEnabled} />
      <span>Battery trend drop alerts</span>
    </label>
    <div class="form-field mb-0">
      <label class="form-label" for="battery_threshold_pct">Battery below (%)</label>
      <input class="form-input" type="number" id="battery_threshold_pct" name="battery_threshold_pct" value={settings.batteryThresholdPct} />
    </div>
    <label class="checkbox-row mb-0">
      <input type="checkbox" name="rssi_alerts_enabled" value="true" checked={settings.rssiAlertsEnabled} />
      <span>Weak WiFi signal alerts</span>
    </label>
    <div class="form-field mb-0">
      <label class="form-label" for="rssi_threshold">RSSI below (dBm)</label>
      <input class="form-input" type="number" id="rssi_threshold" name="rssi_threshold" value={settings.rssiThreshold} />
    </div>
  </div>

  <h3 class="text-base font-semibold mb-2">Escalation</h3>
  <p class="card-subtitle mb-3">
    Re-send threshold alerts via SMS if the condition persists (requires SMS channel).
  </p>
  <div class="config-row-grid mb-4">
    <label class="checkbox-row mb-0">
      <input type="checkbox" name="escalation_enabled" value="true" checked={settings.escalationEnabled} />
      <span>Escalate to SMS</span>
    </label>
    <div class="form-field mb-0">
      <label class="form-label" for="escalation_minutes">After (minutes)</label>
      <input class="form-input" type="number" id="escalation_minutes" name="escalation_minutes" value={settings.escalationMinutes} min="5" />
    </div>
  </div>
  <input type="hidden" name="alert_templates_json" id="alert_templates_json" value={JSON.stringify(settings.alertTemplates ?? {})} />

  <div class="config-row-grid mb-4">
    <div class="form-field mb-0">
      <label class="form-label" for="freeze_threshold_f">Alert if temperature drops below (°F)</label>
      <input class="form-input" type="number" step="0.5" id="freeze_threshold_f" name="freeze_threshold_f" value={settings.freezeThresholdF} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="humidity_threshold">Alert if humidity rises above (%)</label>
      <input class="form-input" type="number" step="1" id="humidity_threshold" name="humidity_threshold" value={settings.humidityThreshold} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="rate_change_f">Alert me if temp drops faster than (°F / hour)</label>
      <input class="form-input" type="number" step="0.5" id="rate_change_f" name="rate_change_f" value={settings.rateChangeF} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="outage_hours">Alert if no reading for (hours)</label>
      <input class="form-input" type="number" step="0.5" id="outage_hours" name="outage_hours" value={settings.outageHours} />
    </div>
  </div>

  <h3 class="text-base font-semibold mb-2">Forecast freeze risk</h3>
  <label class="checkbox-row mb-2">
    <input type="checkbox" name="forecast_freeze_enabled" value="true" checked={settings.forecastFreezeEnabled} />
    <span>Warn when outdoor forecast may hit freeze threshold</span>
  </label>
  <div class="form-field mb-4">
    <label class="form-label" for="forecast_hours_ahead">Look-ahead hours</label>
    <input class="form-input" type="number" min="3" max="48" step="1" id="forecast_hours_ahead" name="forecast_hours_ahead" value={settings.forecastHoursAhead} />
  </div>

  <h3 class="text-base font-semibold mb-2">Quiet hours</h3>
  <label class="checkbox-row mb-2">
    <input type="checkbox" name="quiet_hours_enabled" value="true" checked={settings.quietHoursEnabled} />
    <span>Suppress non-critical alerts during quiet hours</span>
  </label>
  <label class="checkbox-row mb-3">
    <input type="checkbox" name="quiet_hours_bypass_freeze" value="true" checked={settings.quietHoursBypassFreeze} />
    <span>Always deliver freeze / forecast freeze alerts</span>
  </label>
  <label class="checkbox-row mb-3">
    <input type="checkbox" name="quiet_hours_sms_critical" value="true" checked={settings.quietHoursSmsCritical} disabled={!entitlements.canUseSms} />
    <span>
      During quiet hours, still send critical freeze/forecast via SMS (Pro)
      {!entitlements.canUseSms && (
        <> — <a class="text-link" href="/dashboard#plans">Upgrade</a></>
      )}
    </span>
  </label>
  <div class="config-row-grid mb-4">
    <div class="form-field mb-0">
      <label class="form-label" for="quiet_hours_start">Quiet start (HH:MM)</label>
      <input class="form-input" type="text" id="quiet_hours_start" name="quiet_hours_start" value={settings.quietHoursStart} placeholder="22:00" />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="quiet_hours_end">Quiet end (HH:MM)</label>
      <input class="form-input" type="text" id="quiet_hours_end" name="quiet_hours_end" value={settings.quietHoursEnd} placeholder="07:00" />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="quiet_hours_timezone">Timezone (IANA)</label>
      <input class="form-input" type="text" id="quiet_hours_timezone" name="quiet_hours_timezone" value={settings.quietHoursTimezone} placeholder="America/New_York" />
    </div>
  </div>

  <h3 class="text-base font-semibold mb-2">Composite rules (AND)</h3>
  <p class="card-subtitle mb-3">
    Fire when every condition in a rule is true (e.g. door open AND temperature drop).
  </p>
  <div id="alert-rules-list" class="space-y-3 mb-3"></div>
  <button type="button" class="btn-secondary mb-4" id="add-alert-rule">Add rule</button>

  <h3 class="text-base font-semibold mb-2">Severity routing (optional)</h3>
  <p class="card-subtitle mb-3">
    Leave empty to use the global channel checkboxes. Otherwise only the selected channels fire for that kind.
  </p>
  <input type="hidden" name="channel_severity_json" id="channel_severity_json" value={JSON.stringify(settings.channelSeverity ?? {})} />
  <div class="space-y-3 mb-4" id="severity-routing">
    {(["threshold", "forecast", "rate", "outage", "rule", "battery", "rssi"] as const).map((kind) => {
      const selected = settings.channelSeverity?.[kind] ?? [];
      return (
        <div class="form-field mb-0">
          <label class="form-label">{kind}</label>
          <div class="flex flex-wrap gap-3">
            {(["email", "discord", "telegram", "slack", "sms", "push", "webhook"] as const).map((ch) => (
              <label class="checkbox-row mb-0">
                <input
                  type="checkbox"
                  data-severity-kind={kind}
                  data-severity-channel={ch}
                  checked={selected.includes(ch)}
                />
                <span>{ch}</span>
              </label>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <h3 class="text-base font-semibold mb-2 mt-4">Custom alert messages (optional)</h3>
  <p class="card-subtitle mb-3">
    Override title/body per alert kind. Variables: <code>{`{{kind}}`}</code>, <code>{`{{title}}`}</code>, <code>{`{{body}}`}</code>.
  </p>
  <div class="space-y-3 mb-4" id="alert-templates-editor">
    {templateKinds.map((kind) => {
      const tpl = settings.alertTemplates?.[kind] ?? {};
      return (
        <div class="rounded border border-[var(--color-border)] p-3">
          <p class="text-sm font-semibold mb-2 capitalize">{kind}</p>
          <div class="form-field mb-2">
            <label class="form-label" for={`tpl-title-${kind}`}>Title</label>
            <input
              class="form-input"
              type="text"
              id={`tpl-title-${kind}`}
              data-template-kind={kind}
              data-template-field="title"
              value={tpl.title ?? ""}
              placeholder="Leave blank for default"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`tpl-body-${kind}`}>Body</label>
            <input
              class="form-input"
              type="text"
              id={`tpl-body-${kind}`}
              data-template-kind={kind}
              data-template-field="body"
              value={tpl.body ?? ""}
              placeholder="Leave blank for default"
            />
          </div>
        </div>
      );
    })}
  </div>

  <h3 class="text-base font-semibold mb-2">How to reach you</h3>
  <div class="space-y-2 mb-4">
    <label class="checkbox-row">
      <input type="checkbox" name="channel_email" value="true" checked={settings.channelEmail} />
      <span>Email</span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_discord" value="true" checked={settings.channelDiscord} />
      <span>Discord webhook</span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_telegram" value="true" checked={settings.channelTelegram} />
      <span>Telegram (your bot token)</span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_slack" value="true" checked={settings.channelSlack} />
      <span>Slack Incoming Webhook</span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_sms" value="true" checked={settings.channelSms} disabled={!entitlements.canUseSms} />
      <span>
        SMS (Twilio)
        {!entitlements.canUseSms && (
          <> — Pro · <a class="text-link" href="/dashboard#plans">Upgrade</a></>
        )}
      </span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_push" value="true" checked={settings.channelPush} disabled={!entitlements.canUsePush} />
      <span>
        Browser push
        {!entitlements.canUsePush && (
          <> — Pro · <a class="text-link" href="/dashboard#plans">Upgrade</a></>
        )}
      </span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="channel_webhook" value="true" checked={settings.channelWebhook} disabled={!entitlements.canUseOutboundWebhook} />
      <span>
        Outbound webhook (IFTTT / Home Assistant)
        {!entitlements.canUseOutboundWebhook && (
          <> — Pro · <a class="text-link" href="/dashboard#plans">Upgrade</a></>
        )}
      </span>
    </label>
  </div>

  {needsPro && (
    <p class="mb-4 text-sm text-[var(--color-text-muted)]">
      Unlock SMS, push, and webhooks with
      <a class="text-link" href="/dashboard#plans">Pro</a>.
    </p>
  )}

  <div class="form-field">
    <label class="form-label" for="alert_email">Alert email</label>
    <input class="form-input" type="email" id="alert_email" name="alert_email" value={settings.email ?? userEmail} placeholder={userEmail} />
  </div>

  <div class="form-field">
    <label class="form-label" for="discord_webhook_url">Discord webhook URL</label>
    <input class="form-input" type="url" id="discord_webhook_url" name="discord_webhook_url" value={settings.discordWebhookUrl ?? ""} placeholder="https://discord.com/api/webhooks/..." />
  </div>

  <div class="form-field">
    <label class="form-label" for="telegram_bot_token">Telegram bot token</label>
    <input class="form-input" type="text" id="telegram_bot_token" name="telegram_bot_token" value={settings.telegramBotToken ?? ""} placeholder="123456:ABC..." autocomplete="off" />
  </div>

  <div class="form-field">
    <label class="form-label" for="telegram_chat_id">Telegram chat ID</label>
    <input class="form-input" type="text" id="telegram_chat_id" name="telegram_chat_id" value={settings.telegramChatId ?? ""} placeholder="-100..." />
  </div>

  <div class="form-field">
    <label class="form-label" for="telegram_command_secret">Telegram bot webhook secret</label>
    <input class="form-input" type="text" id="telegram_command_secret" name="telegram_command_secret" value={settings.telegramCommandSecret ?? ""} placeholder="random-secret" autocomplete="off" />
    <p class="form-hint mb-0">
      Set bot webhook to <code>/api/telegram/webhook?secret=…</code> for /status, /snooze, /vacation commands.
    </p>
  </div>

  <div class="form-field">
    <label class="form-label" for="slack_webhook_url">Slack Incoming Webhook URL</label>
    <input class="form-input" type="url" id="slack_webhook_url" name="slack_webhook_url" value={settings.slackWebhookUrl ?? ""} placeholder="https://hooks.slack.com/services/..." />
  </div>

  <div class="form-field">
    <label class="form-label" for="sms_phone">SMS phone number</label>
    <input class="form-input" type="tel" id="sms_phone" name="sms_phone" value={settings.smsPhone ?? ""} placeholder="+15551234567" disabled={!entitlements.canUseSms} />
    <p class="form-hint">Use international format, e.g. +1 for US numbers.</p>
  </div>

  <div class="form-field">
    <label class="form-label" for="outbound_webhook_url">Outbound webhook URL</label>
    <input class="form-input" type="url" id="outbound_webhook_url" name="outbound_webhook_url" value={settings.outboundWebhookUrl ?? ""} placeholder="https://hooks.example.com/..." disabled={!entitlements.canUseOutboundWebhook} />
  </div>

  <div class="form-field">
    <label class="form-label" for="outbound_webhook_secret">Webhook signing secret (optional)</label>
    <input class="form-input" type="text" id="outbound_webhook_secret" name="outbound_webhook_secret" value={settings.outboundWebhookSecret ?? ""} disabled={!entitlements.canUseOutboundWebhook} />
    <p class="form-hint">Used to verify requests from this site (HMAC). Leave blank if your automation does not need it.</p>
  </div>

  <div class="form-field">
    <label class="form-label" for="reading_webhook_url">Reading webhook URL (optional)</label>
    <input class="form-input" type="url" id="reading_webhook_url" name="reading_webhook_url" value={settings.readingWebhookUrl ?? ""} placeholder="https://hooks.example.com/readings" disabled={!entitlements.canUseOutboundWebhook} />
    <p class="form-hint">POST on every successful device ingest with latest readings JSON.</p>
  </div>

  <div class="form-field">
    <label class="form-label" for="reading_webhook_secret">Reading webhook secret (optional)</label>
    <input class="form-input" type="text" id="reading_webhook_secret" name="reading_webhook_secret" value={settings.readingWebhookSecret ?? ""} disabled={!entitlements.canUseOutboundWebhook} />
  </div>

  <div class="form-field">
    <label class="form-label" for="space_channel_routing_json">Per-space channel routing (JSON)</label>
    <textarea
      class="form-textarea font-mono text-xs"
      id="space_channel_routing_json"
      name="space_channel_routing_json"
      rows={4}
      placeholder={'{"garage":{"threshold":["telegram","sms"]}}'}
      disabled={!canEdit}
    >{JSON.stringify(settings.spaceChannelRouting ?? {}, null, 2)}</textarea>
    <p class="form-hint">Optional. Restrict alert kinds to specific channels by device space label (garage, attic, …).</p>
  </div>

  <button type="submit" class="btn-primary" hidden={!canEdit}>Save alert settings</button>
  <p class="form-hint mt-2 mb-0" id="channel-incomplete-hint" hidden>
    A checked channel needs its destination filled in, or it will be skipped when alerts fire.
  </p>

  {entitlements.canUsePush && (
    <div class="mt-4 border-t border-[var(--color-border)] pt-4">
      <h3 class="text-base font-semibold mb-2">Browser push on this device</h3>
      {!vapidPublicKey ? (
        <p class="card-subtitle mb-0">
          Push is not configured on the server yet (missing VAPID keys). Email or Discord will still work.
        </p>
      ) : (
        <>
          <p class="card-subtitle mb-3" id="push-status">Checking push status…</p>
          <button type="button" class="btn-secondary" id="enable-push-btn" data-vapid={vapidPublicKey}>
            Enable browser push
          </button>
          <p class="form-hint mt-2 mb-0" id="push-hint"></p>
        </>
      )}
    </div>
  )}
  </fieldset>
</form>

<form id="alert-snooze-24-form" action="/api/user/alert-snooze" method="post" hidden>
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="action" value="snooze_24" />
</form>
<form id="alert-snooze-vacation-form" action="/api/user/alert-snooze" method="post" hidden>
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="action" value="vacation_7" />
</form>
{settings.snoozeUntil && (
  <form id="alert-snooze-clear-form" action="/api/user/alert-snooze" method="post" hidden>
    <input type="hidden" name="redirect" value={redirectTo} />
    <input type="hidden" name="action" value="clear_snooze" />
  </form>
)}
{settings.vacationUntil && (
  <form id="alert-vacation-clear-form" action="/api/user/alert-snooze" method="post" hidden>
    <input type="hidden" name="redirect" value={redirectTo} />
    <input type="hidden" name="action" value="clear_vacation" />
  </form>
)}
</div>

<script is:inline define:vars={{ conditionOptions: CONDITION_OPTIONS, initialRules: settings.alertRules }}>
  (() => {
    const form = document.getElementById("alert-settings-form");
    if (!(form instanceof HTMLFormElement)) return;
    const hint = document.getElementById("channel-incomplete-hint");
    const list = document.getElementById("alert-rules-list");
    const hidden = document.getElementById("alert_rules_json");
    const addBtn = document.getElementById("add-alert-rule");
    let rules = Array.isArray(initialRules) ? structuredClone(initialRules) : [];

    function syncRulesHidden() {
      if (hidden) hidden.value = JSON.stringify(rules);
    }

    function renderRules() {
      if (!list) return;
      list.innerHTML = "";
      rules.forEach((rule, ruleIndex) => {
        const wrap = document.createElement("div");
        wrap.className = "rounded border border-[var(--color-border)] p-3";
        const condOptions = conditionOptions
          .map((o) => `<option value="${o.value}">${o.label}</option>`)
          .join("");
        const conditionsHtml = (rule.all || [])
          .map((c, ci) => {
            const opts = conditionOptions
              .map(
                (o) =>
                  `<option value="${o.value}" ${o.value === c.type ? "selected" : ""}>${o.label}</option>`,
              )
              .join("");
            return `<div class="flex flex-wrap gap-2 mb-2 items-center" data-ci="${ci}">
              <select data-field="type" class="form-input">${opts}</select>
              <input data-field="value" class="form-input" type="number" step="0.5" style="max-width:7rem" placeholder="value" value="${c.value != null ? c.value : ""}" />
              <input data-field="labelIncludes" class="form-input" type="text" style="max-width:10rem" placeholder="label contains" value="${(c.labelIncludes || "").replace(/"/g, "&quot;")}" />
              <button type="button" class="btn-secondary text-sm" data-remove-cond>Remove</button>
            </div>`;
          })
          .join("");
        wrap.innerHTML = `
          <div class="flex flex-wrap gap-2 mb-2 items-center">
            <label class="checkbox-row mb-0"><input type="checkbox" data-field="enabled" ${rule.enabled !== false ? "checked" : ""} /> <span>On</span></label>
            <input class="form-input flex-1" data-field="name" value="${(rule.name || "").replace(/"/g, "&quot;")}" placeholder="Rule name" />
            <button type="button" class="btn-secondary text-sm" data-remove-rule>Delete rule</button>
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mb-2">All of:</p>
          <div data-conditions>${conditionsHtml}</div>
          <button type="button" class="btn-secondary text-sm" data-add-cond>Add condition</button>
        `;
        wrap.querySelector("[data-remove-rule]")?.addEventListener("click", () => {
          rules.splice(ruleIndex, 1);
          renderRules();
        });
        wrap.querySelector('[data-field="enabled"]')?.addEventListener("change", (e) => {
          rules[ruleIndex].enabled = e.target.checked;
          syncRulesHidden();
        });
        wrap.querySelector('[data-field="name"]')?.addEventListener("input", (e) => {
          rules[ruleIndex].name = e.target.value;
          syncRulesHidden();
        });
        wrap.querySelector("[data-add-cond]")?.addEventListener("click", () => {
          if (!rules[ruleIndex].all) rules[ruleIndex].all = [];
          rules[ruleIndex].all.push({ type: "door_open" });
          renderRules();
        });
        wrap.querySelectorAll("[data-conditions] > div").forEach((row) => {
          const ci = Number(row.getAttribute("data-ci"));
          row.querySelector('[data-field="type"]')?.addEventListener("change", (e) => {
            rules[ruleIndex].all[ci].type = e.target.value;
            syncRulesHidden();
          });
          row.querySelector('[data-field="value"]')?.addEventListener("input", (e) => {
            const v = e.target.value;
            rules[ruleIndex].all[ci].value = v === "" ? undefined : Number(v);
            syncRulesHidden();
          });
          row.querySelector('[data-field="labelIncludes"]')?.addEventListener("input", (e) => {
            const v = e.target.value.trim();
            rules[ruleIndex].all[ci].labelIncludes = v || undefined;
            syncRulesHidden();
          });
          row.querySelector("[data-remove-cond]")?.addEventListener("click", () => {
            rules[ruleIndex].all.splice(ci, 1);
            renderRules();
          });
        });
        void condOptions;
        list.appendChild(wrap);
      });
      syncRulesHidden();
    }

    addBtn?.addEventListener("click", () => {
      rules.push({
        id: crypto.randomUUID(),
        enabled: true,
        name: "New rule",
        all: [{ type: "door_open" }, { type: "temp_below" }],
      });
      renderRules();
    });

    function syncIncompleteHint() {
      if (!hint) return;
      const discordOn = form.querySelector('[name="channel_discord"]')?.checked;
      const telegramOn = form.querySelector('[name="channel_telegram"]')?.checked;
      const slackOn = form.querySelector('[name="channel_slack"]')?.checked;
      const smsOn = form.querySelector('[name="channel_sms"]')?.checked;
      const webhookOn = form.querySelector('[name="channel_webhook"]')?.checked;
      const emailOn = form.querySelector('[name="channel_email"]')?.checked;
      const discordUrl = form.querySelector("#discord_webhook_url")?.value?.trim();
      const tgToken = form.querySelector("#telegram_bot_token")?.value?.trim();
      const tgChat = form.querySelector("#telegram_chat_id")?.value?.trim();
      const slackUrl = form.querySelector("#slack_webhook_url")?.value?.trim();
      const smsPhone = form.querySelector("#sms_phone")?.value?.trim();
      const webhookUrl = form.querySelector("#outbound_webhook_url")?.value?.trim();
      const alertEmail = form.querySelector("#alert_email")?.value?.trim();
      const incomplete =
        (emailOn && !alertEmail) ||
        (discordOn && !discordUrl) ||
        (telegramOn && (!tgToken || !tgChat)) ||
        (slackOn && !slackUrl) ||
        (smsOn && !smsPhone) ||
        (webhookOn && !webhookUrl);
      hint.hidden = !incomplete;
    }

    form.addEventListener("change", syncIncompleteHint);
    form.addEventListener("input", syncIncompleteHint);
    form.addEventListener("submit", () => {
      syncRulesHidden();
      const severityHidden = document.getElementById("channel_severity_json");
      if (severityHidden) {
        const map = {};
        document.querySelectorAll("[data-severity-kind]").forEach((el) => {
          if (!el.checked) return;
          const kind = el.getAttribute("data-severity-kind");
          const ch = el.getAttribute("data-severity-channel");
          if (!kind || !ch) return;
          if (!map[kind]) map[kind] = [];
          map[kind].push(ch);
        });
        severityHidden.value = JSON.stringify(map);
      }
      const templatesHidden = document.getElementById("alert_templates_json");
      if (templatesHidden) {
        const map = {};
        document.querySelectorAll("[data-template-kind]").forEach((el) => {
          const kind = el.getAttribute("data-template-kind");
          const field = el.getAttribute("data-template-field");
          if (!kind || !field) return;
          const value = el.value?.trim();
          if (!value) return;
          if (!map[kind]) map[kind] = {};
          map[kind][field] = value;
        });
        templatesHidden.value = JSON.stringify(map);
      }
    });
    syncIncompleteHint();
    renderRules();
  })();
</script>

{entitlements.canUsePush && vapidPublicKey && (
  <script is:inline define:vars={{ vapidPublicKey }}>
    function urlBase64ToUint8Array(base64String) {
      if (!base64String) throw new Error("VAPID public key is not configured");
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const rawData = atob(base64);
      return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
    }

    const btn = document.getElementById("enable-push-btn");
    const status = document.getElementById("push-status");
    const hint = document.getElementById("push-hint");
    const pushChannel = document.querySelector('[name="channel_push"]');

    async function ensureServiceWorker() {
      await navigator.serviceWorker.register("/sw.js?v=3");
      return navigator.serviceWorker.ready;
    }

    async function refreshPushStatus() {
      if (!status) return;
      if (!("Notification" in window) || !("serviceWorker" in navigator) || !("PushManager" in window)) {
        status.textContent = "Push is not supported in this browser.";
        if (btn) btn.hidden = true;
        return;
      }

      const permission = Notification.permission;
      if (permission === "denied") {
        status.textContent = "Notifications are blocked for this site. Allow them in browser settings, then retry.";
        if (btn) btn.textContent = "Retry enable push";
        return;
      }

      try {
        const res = await fetch("/api/push/status");
        const server = res.ok ? await res.json() : null;
        const reg = await ensureServiceWorker();
        const existing = await reg.pushManager.getSubscription();

        if (existing && server?.subscriptionCount > 0) {
          status.textContent = "Push enabled on this browser.";
          if (btn) btn.textContent = "Re-enable / refresh push";
          if (hint) {
            hint.textContent = server.channelEnabled
              ? "Browser push channel is on — test from below."
              : 'Check "Browser push" under channels above, save settings, then send a test.';
          }
        } else if (permission === "granted") {
          status.textContent = "Permission granted, but this browser is not subscribed yet.";
          if (btn) btn.textContent = "Subscribe this browser";
        } else {
          status.textContent = "Not enabled on this browser yet.";
          if (btn) btn.textContent = "Enable browser push";
        }

        if (server && !server.vapidConfigured && hint) {
          hint.textContent = "Server VAPID keys are missing — push cannot send until configured.";
        }
      } catch {
        status.textContent = "Could not read push status.";
      }
    }

    btn?.addEventListener("click", async () => {
      try {
        if (!vapidPublicKey) {
          throw new Error("VAPID public key is not configured on the server");
        }
        const reg = await ensureServiceWorker();
        const permission = await Notification.requestPermission();
        if (permission !== "granted") {
          throw new Error("Notification permission was not granted");
        }
        let sub = await reg.pushManager.getSubscription();
        if (!sub) {
          sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
        }
        const json = sub.toJSON();
        const res = await fetch("/api/push/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ endpoint: json.endpoint, keys: json.keys }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => null);
          throw new Error(err?.error || "Server rejected subscription");
        }
        if (pushChannel instanceof HTMLInputElement) {
          pushChannel.checked = true;
        }
        if (status) {
          status.textContent = "Subscribed on this browser. Save alert settings, then send a test.";
        }
        if (hint) {
          hint.textContent = 'The "Browser push" channel was checked — click Save alert settings before testing.';
        }
        if (btn) btn.textContent = "Re-enable / refresh push";
      } catch (e) {
        if (status) status.textContent = "Could not enable push: " + (e?.message || e);
        await refreshPushStatus();
      }
    });

    refreshPushStatus();
  </script>
)}
