<script>
  import { actions } from "astro:actions";
  import { prepareAlertSettingsFormData } from "../lib/alertSettingsForm";

  const form = document.querySelector<HTMLFormElement>("[data-alert-settings-form]");
  const statusEl = document.getElementById("alert-action-status");
  const errorEl = document.getElementById("alert-action-error");
  const submitBtn = document.getElementById("alert-settings-submit");

  function showStatus(message: string) {
    statusEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    if (statusEl) statusEl.textContent = message;
  }

  function showError(message: string) {
    errorEl?.classList.remove("hidden");
    statusEl?.classList.add("hidden");
    if (errorEl) errorEl.textContent = message;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const sync = (
      window as Window & { syncAlertSettingsFormFields?: () => void }
    ).syncAlertSettingsFormFields;
    sync?.();

    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Saving…";
    }

    const formData = prepareAlertSettingsFormData(new FormData(form));
    const { data, error } = await actions.updateAlertSettings(formData);

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Save alert settings";
    }

    if (error) {
      showError(error.message || "Could not save alert settings.");
      return;
    }

    showStatus(data?.message ?? "Alert settings saved.");
    window.setTimeout(() => {
      const params = new URLSearchParams({ alert_saved: "1" });
      if (data?.channelsIncomplete) params.set("channels_incomplete", "1");
      window.location.href = `/dashboard/alerts?${params.toString()}`;
    }, 400);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-snooze-action]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const action = btn.dataset.snoozeAction;
      if (!action) return;
      btn.disabled = true;
      const formData = new FormData();
      formData.set("action", action);
      const { data, error } = await actions.updateAlertSnooze(formData);
      btn.disabled = false;
      if (error) {
        showError(error.message || "Could not update snooze.");
        return;
      }
      showStatus(data?.message ?? "Updated.");
      window.setTimeout(() => window.location.reload(), 600);
    });
  });
</script>

<script is:inline define:vars={{ conditionOptions: CONDITION_OPTIONS, initialRules: settings.alertRules }}>
  (() => {
    const form = document.getElementById("alert-settings-form");
    if (!(form instanceof HTMLFormElement)) return;
    const hint = document.getElementById("channel-incomplete-hint");
    const list = document.getElementById("alert-rules-list");
    const hidden = document.getElementById("alert_rules_json");
    const addBtn = document.getElementById("add-alert-rule");
    let rules = Array.isArray(initialRules) ? structuredClone(initialRules) : [];

    function syncRulesHidden() {
      if (hidden) hidden.value = JSON.stringify(rules);
    }

    function renderRules() {
      if (!list) return;
      list.innerHTML = "";
      rules.forEach((rule, ruleIndex) => {
        const wrap = document.createElement("div");
        wrap.className = "rounded border border-[var(--color-border)] p-3";
        const condOptions = conditionOptions
          .map((o) => `<option value="${o.value}">${o.label}</option>`)
          .join("");
        const conditionsHtml = (rule.all || [])
          .map((c, ci) => {
            const opts = conditionOptions
              .map(
                (o) =>
                  `<option value="${o.value}" ${o.value === c.type ? "selected" : ""}>${o.label}</option>`,
              )
              .join("");
            return `<div class="flex flex-wrap gap-2 mb-2 items-center" data-ci="${ci}">
              <select data-field="type" class="form-input">${opts}</select>
              <input data-field="value" class="form-input" type="number" step="0.5" style="max-width:7rem" placeholder="value" value="${c.value != null ? c.value : ""}" />
              <input data-field="labelIncludes" class="form-input" type="text" style="max-width:10rem" placeholder="label contains" value="${(c.labelIncludes || "").replace(/"/g, "&quot;")}" />
              <button type="button" class="btn-secondary text-sm" data-remove-cond>Remove</button>
            </div>`;
          })
          .join("");
        wrap.innerHTML = `
          <div class="flex flex-wrap gap-2 mb-2 items-center">
            <label class="checkbox-row mb-0"><input type="checkbox" data-field="enabled" ${rule.enabled !== false ? "checked" : ""} /> <span>On</span></label>
            <input class="form-input flex-1" data-field="name" value="${(rule.name || "").replace(/"/g, "&quot;")}" placeholder="Rule name" />
            <button type="button" class="btn-secondary text-sm" data-remove-rule>Delete rule</button>
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mb-2">All of:</p>
          <div data-conditions>${conditionsHtml}</div>
          <button type="button" class="btn-secondary text-sm" data-add-cond>Add condition</button>
        `;
        wrap.querySelector("[data-remove-rule]")?.addEventListener("click", () => {
          rules.splice(ruleIndex, 1);
          renderRules();
        });
        wrap.querySelector('[data-field="enabled"]')?.addEventListener("change", (e) => {
          rules[ruleIndex].enabled = e.target.checked;
          syncRulesHidden();
        });
        wrap.querySelector('[data-field="name"]')?.addEventListener("input", (e) => {
          rules[ruleIndex].name = e.target.value;
          syncRulesHidden();
        });
        wrap.querySelector("[data-add-cond]")?.addEventListener("click", () => {
          if (!rules[ruleIndex].all) rules[ruleIndex].all = [];
          rules[ruleIndex].all.push({ type: "door_open" });
          renderRules();
        });
        wrap.querySelectorAll("[data-conditions] > div").forEach((row) => {
          const ci = Number(row.getAttribute("data-ci"));
          row.querySelector('[data-field="type"]')?.addEventListener("change", (e) => {
            rules[ruleIndex].all[ci].type = e.target.value;
            syncRulesHidden();
          });
          row.querySelector('[data-field="value"]')?.addEventListener("input", (e) => {
            const v = e.target.value;
            rules[ruleIndex].all[ci].value = v === "" ? undefined : Number(v);
            syncRulesHidden();
          });
          row.querySelector('[data-field="labelIncludes"]')?.addEventListener("input", (e) => {
            const v = e.target.value.trim();
            rules[ruleIndex].all[ci].labelIncludes = v || undefined;
            syncRulesHidden();
          });
          row.querySelector("[data-remove-cond]")?.addEventListener("click", () => {
            rules[ruleIndex].all.splice(ci, 1);
            renderRules();
          });
        });
        void condOptions;
        list.appendChild(wrap);
      });
      syncRulesHidden();
    }

    addBtn?.addEventListener("click", () => {
      rules.push({
        id: crypto.randomUUID(),
        enabled: true,
        name: "New rule",
        all: [{ type: "door_open" }, { type: "temp_below" }],
      });
      renderRules();
    });

    function syncIncompleteHint() {
      if (!hint) return;
      const discordOn = form.querySelector('[name="channel_discord"]')?.checked;
      const telegramOn = form.querySelector('[name="channel_telegram"]')?.checked;
      const slackOn = form.querySelector('[name="channel_slack"]')?.checked;
      const smsOn = form.querySelector('[name="channel_sms"]')?.checked;
      const webhookOn = form.querySelector('[name="channel_webhook"]')?.checked;
      const emailOn = form.querySelector('[name="channel_email"]')?.checked;
      const discordUrl = form.querySelector("#discord_webhook_url")?.value?.trim();
      const tgToken = form.querySelector("#telegram_bot_token")?.value?.trim();
      const tgChat = form.querySelector("#telegram_chat_id")?.value?.trim();
      const slackUrl = form.querySelector("#slack_webhook_url")?.value?.trim();
      const smsPhone = form.querySelector("#sms_phone")?.value?.trim();
      const webhookUrl = form.querySelector("#outbound_webhook_url")?.value?.trim();
      const alertEmail = form.querySelector("#alert_email")?.value?.trim();
      const incomplete =
        (emailOn && !alertEmail) ||
        (discordOn && !discordUrl) ||
        (telegramOn && (!tgToken || !tgChat)) ||
        (slackOn && !slackUrl) ||
        (smsOn && !smsPhone) ||
        (webhookOn && !webhookUrl);
      hint.hidden = !incomplete;
    }

    form.addEventListener("change", syncIncompleteHint);
    form.addEventListener("input", syncIncompleteHint);

    function syncChannelPanels() {
      form.querySelectorAll("[data-channel-toggle]").forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;
        const panelId = input.getAttribute("data-channel-toggle");
        if (!panelId) return;
        const panel = form.querySelector(`[data-channel-panel="${panelId}"]`);
        if (panel instanceof HTMLElement) panel.hidden = !input.checked;
      });
    }
    form.addEventListener("change", syncChannelPanels);
    syncChannelPanels();

    function syncAlertSettingsFormFields() {
      syncRulesHidden();
      const severityHidden = document.getElementById("channel_severity_json");
      if (severityHidden) {
        const map = {};
        document.querySelectorAll("[data-severity-kind]").forEach((el) => {
          if (!el.checked) return;
          const kind = el.getAttribute("data-severity-kind");
          const ch = el.getAttribute("data-severity-channel");
          if (!kind || !ch) return;
          if (!map[kind]) map[kind] = [];
          map[kind].push(ch);
        });
        severityHidden.value = JSON.stringify(map);
      }
      const templatesHidden = document.getElementById("alert_templates_json");
      if (templatesHidden) {
        const map = {};
        document.querySelectorAll("[data-template-kind]").forEach((el) => {
          const kind = el.getAttribute("data-template-kind");
          const field = el.getAttribute("data-template-field");
          if (!kind || !field) return;
          const value = el.value?.trim();
          if (!value) return;
          if (!map[kind]) map[kind] = {};
          map[kind][field] = value;
        });
        templatesHidden.value = JSON.stringify(map);
      }
      const routingHidden = document.getElementById("space_channel_routing_json");
      if (routingHidden) {
        let routing = {};
        try {
          const parsed = JSON.parse(routingHidden.value || "{}");
          if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
            routing = structuredClone(parsed);
          }
        } catch {
          routing = {};
        }
        const uiKinds = new Set(["threshold", "forecast", "nws", "rule", "outage", "rate"]);
        const spacesTouched = new Set();
        document.querySelectorAll(".space-routing-checkbox").forEach((el) => {
          const space = el.getAttribute("data-space");
          if (space) spacesTouched.add(space);
        });
        for (const space of spacesTouched) {
          if (!routing[space] || typeof routing[space] !== "object") routing[space] = {};
          for (const kind of uiKinds) {
            routing[space][kind] = [];
          }
        }
        document.querySelectorAll(".space-routing-checkbox").forEach((el) => {
          if (!el.checked) return;
          const space = el.getAttribute("data-space");
          const kind = el.getAttribute("data-kind") || "threshold";
          const channel = el.getAttribute("data-channel");
          if (!space || !channel) return;
          if (!routing[space]) routing[space] = {};
          if (!Array.isArray(routing[space][kind])) routing[space][kind] = [];
          routing[space][kind].push(channel);
        });
        for (const space of spacesTouched) {
          for (const kind of uiKinds) {
            if (Array.isArray(routing[space]?.[kind]) && routing[space][kind].length === 0) {
              delete routing[space][kind];
            }
          }
          if (routing[space] && Object.keys(routing[space]).length === 0) {
            delete routing[space];
          }
        }
        routingHidden.value = JSON.stringify(routing);
      }
    }

    window.syncAlertSettingsFormFields = syncAlertSettingsFormFields;
    form.addEventListener("submit", syncAlertSettingsFormFields, { capture: true });
    syncIncompleteHint();
    renderRules();
  })();
</script>

<script is:inline define:vars={{ initialPlaybooks: settings.alertPlaybooks ?? [], alertChannels: ALERT_CHANNELS, playbookKinds: PLAYBOOK_KINDS }}>
  (() => {
    const form = document.getElementById("alert-settings-form");
    if (!(form instanceof HTMLFormElement)) return;
    const list = document.getElementById("alert-playbooks-list");
    const hidden = document.getElementById("alert_playbooks_json");
    const editor = document.getElementById("alert_playbooks_editor");
    const addBtn = document.getElementById("add-playbook-step");
    let steps = Array.isArray(initialPlaybooks) ? structuredClone(initialPlaybooks) : [];

    function syncPlaybooksHidden() {
      const json = JSON.stringify(steps);
      if (hidden) hidden.value = json;
      if (editor instanceof HTMLTextAreaElement) editor.value = json;
    }

    function renderPlaybooks() {
      if (!list) return;
      list.innerHTML = "";
      steps.forEach((step, stepIndex) => {
        const wrap = document.createElement("div");
        wrap.className = "rounded border border-[var(--color-border)] p-3";
        const channelChecks = alertChannels
          .map((ch) => {
            const checked = (step.channels || []).includes(ch.id) ? "checked" : "";
            return `<label class="checkbox-row mb-0 text-sm"><input type="checkbox" data-channel="${ch.id}" ${checked} /> <span>${ch.label}</span></label>`;
          })
          .join("");
        const kindChecks = playbookKinds
          .map((k) => {
            const checked = (step.kinds || []).includes(k.id) ? "checked" : "";
            return `<label class="checkbox-row mb-0 text-sm"><input type="checkbox" data-kind="${k.id}" ${checked} /> <span>${k.label}</span></label>`;
          })
          .join("");
        wrap.innerHTML = `
          <div class="flex flex-wrap gap-2 mb-2 items-center">
            <input class="form-input flex-1" data-field="name" value="${(step.name || "").replace(/"/g, "&quot;")}" placeholder="Step name" />
            <div class="form-field mb-0">
              <label class="form-label text-xs">After (min)</label>
              <input class="form-input" type="number" data-field="afterMinutes" min="1" value="${step.afterMinutes ?? 15}" style="max-width:6rem" />
            </div>
            <label class="checkbox-row mb-0"><input type="checkbox" data-field="ifUnacked" ${step.ifUnacked !== false ? "checked" : ""} /> <span>Only if unacked</span></label>
            <button type="button" class="btn-secondary text-sm" data-remove-step>Delete</button>
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mb-1">Channels</p>
          <div class="flex flex-wrap gap-2 mb-2">${channelChecks}</div>
          <p class="text-sm text-[var(--color-text-muted)] mb-1">Kinds (none = all)</p>
          <div class="flex flex-wrap gap-2">${kindChecks}</div>
        `;
        wrap.querySelector("[data-remove-step]")?.addEventListener("click", () => {
          steps.splice(stepIndex, 1);
          renderPlaybooks();
        });
        wrap.querySelector('[data-field="name"]')?.addEventListener("input", (e) => {
          steps[stepIndex].name = e.target.value;
          syncPlaybooksHidden();
        });
        wrap.querySelector('[data-field="afterMinutes"]')?.addEventListener("input", (e) => {
          steps[stepIndex].afterMinutes = Number(e.target.value) || 15;
          syncPlaybooksHidden();
        });
        wrap.querySelector('[data-field="ifUnacked"]')?.addEventListener("change", (e) => {
          steps[stepIndex].ifUnacked = e.target.checked;
          syncPlaybooksHidden();
        });
        wrap.querySelectorAll("[data-channel]").forEach((el) => {
          el.addEventListener("change", () => {
            const channels = [...wrap.querySelectorAll("[data-channel]:checked")].map(
              (node) => node.getAttribute("data-channel"),
            );
            steps[stepIndex].channels = channels;
            syncPlaybooksHidden();
          });
        });
        wrap.querySelectorAll("[data-kind]").forEach((el) => {
          el.addEventListener("change", () => {
            const kinds = [...wrap.querySelectorAll("[data-kind]:checked")].map(
              (node) => node.getAttribute("data-kind"),
            );
            steps[stepIndex].kinds = kinds;
            syncPlaybooksHidden();
          });
        });
        list.appendChild(wrap);
      });
      syncPlaybooksHidden();
    }

    addBtn?.addEventListener("click", () => {
      steps.push({
        id: crypto.randomUUID(),
        name: "Escalation step",
        afterMinutes: 15,
        ifUnacked: true,
        channels: ["sms"],
        kinds: [],
      });
      renderPlaybooks();
    });

    const priorSync = window.syncAlertSettingsFormFields;
    window.syncAlertSettingsFormFields = () => {
      priorSync?.();
      syncPlaybooksHidden();
    };
    form.addEventListener("submit", syncPlaybooksHidden, { capture: true });
    renderPlaybooks();
  })();
</script>

{entitlements.canUsePush && vapidPublicKey && (
  <script is:inline define:vars={{ vapidPublicKey }}>
    function urlBase64ToUint8Array(base64String) {
      if (!base64String) throw new Error("VAPID public key is not configured");
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const rawData = atob(base64);
      return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
    }

    const btn = document.getElementById("enable-push-btn");
    const status = document.getElementById("push-status");
    const hint = document.getElementById("push-hint");
    const pushChannel = document.querySelector('[name="channel_push"]');

    async function ensureServiceWorker() {
      await navigator.serviceWorker.register("/sw.js?v=3");
      return navigator.serviceWorker.ready;
    }

    async function refreshPushStatus() {
      if (!status) return;
      if (!("Notification" in window) || !("serviceWorker" in navigator) || !("PushManager" in window)) {
        status.textContent = "Push is not supported in this browser.";
        if (btn) btn.hidden = true;
        return;
      }

      const permission = Notification.permission;
      if (permission === "denied") {
        status.textContent = "Notifications are blocked for this site. Allow them in browser settings, then retry.";
        if (btn) btn.textContent = "Retry enable push";
        return;
      }

      try {
        const res = await fetch("/api/push/status");
        const server = res.ok ? await res.json() : null;
        const reg = await ensureServiceWorker();
        const existing = await reg.pushManager.getSubscription();

        if (existing && server?.subscriptionCount > 0) {
          status.textContent = "Push enabled on this browser.";
          if (btn) btn.textContent = "Re-enable / refresh push";
          if (hint) {
            hint.textContent = server.channelEnabled
              ? "Browser push channel is on — test from below."
              : 'Check "Browser push" under channels above, save settings, then send a test.';
          }
        } else if (permission === "granted") {
          status.textContent = "Permission granted, but this browser is not subscribed yet.";
          if (btn) btn.textContent = "Subscribe this browser";
        } else {
          status.textContent = "Not enabled on this browser yet.";
          if (btn) btn.textContent = "Enable browser push";
        }

        if (server && !server.vapidConfigured && hint) {
          hint.textContent = "Server VAPID keys are missing — push cannot send until configured.";
        }
      } catch {
        status.textContent = "Could not read push status.";
      }
    }

    btn?.addEventListener("click", async () => {
      try {
        if (!vapidPublicKey) {
          throw new Error("VAPID public key is not configured on the server");
        }
        const reg = await ensureServiceWorker();
        const permission = await Notification.requestPermission();
        if (permission !== "granted") {
          throw new Error("Notification permission was not granted");
        }
        let sub = await reg.pushManager.getSubscription();
        if (!sub) {
          sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
        }
        const json = sub.toJSON();
        const res = await fetch("/api/push/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ endpoint: json.endpoint, keys: json.keys }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => null);
          throw new Error(err?.error || "Server rejected subscription");
        }
        if (pushChannel instanceof HTMLInputElement) {
          pushChannel.checked = true;
        }
        if (status) {
          status.textContent = "Subscribed on this browser. Save alert settings, then send a test.";
        }
        if (hint) {
          hint.textContent = 'The "Browser push" channel was checked — click Save alert settings before testing.';
        }
        if (btn) btn.textContent = "Re-enable / refresh push";
      } catch (e) {
        if (status) status.textContent = "Could not enable push: " + (e?.message || e);
        await refreshPushStatus();
      }
    });

    refreshPushStatus();
  </script>
)}
