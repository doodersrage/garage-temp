---
import type { AlertSettings } from "../lib/alerts";
import type { Entitlements } from "../lib/entitlements";
import { CONDITION_OPTIONS } from "../lib/alertRules";
import AlertSettingsNav from "./alerts/AlertSettingsNav.astro";
import AlertSettingsPanel from "./alerts/AlertSettingsPanel.astro";

interface Props {
  userEmail: string;
  settings: AlertSettings;
  entitlements: Entitlements;
  vapidPublicKey?: string;
  twilioConfigured?: boolean;
  redirectTo?: string;
  canEdit?: boolean;
  deviceSpaces?: string[];
}

const {
  userEmail,
  settings,
  entitlements,
  vapidPublicKey = "",
  twilioConfigured = true,
  redirectTo = "/dashboard/alerts",
  canEdit = true,
  deviceSpaces = [],
} = Astro.props;

const ALERT_CHANNELS = [
  { id: "email", label: "Email" },
  { id: "sms", label: "SMS" },
  { id: "discord", label: "Discord" },
  { id: "push", label: "Push" },
  { id: "webhook", label: "Webhook" },
  { id: "telegram", label: "Telegram" },
  { id: "slack", label: "Slack" },
  { id: "teams", label: "Teams" },
  { id: "ntfy", label: "ntfy" },
  { id: "pushover", label: "Pushover" },
  { id: "whatsapp", label: "WhatsApp" },
] as const;

/** Space routing matrix kinds (subset of NotifyKind; preserve others on merge). */
const SPACE_ROUTING_KINDS = [
  { id: "threshold", label: "Threshold" },
  { id: "forecast", label: "Forecast" },
  { id: "nws", label: "NWS" },
  { id: "rule", label: "Rule" },
  { id: "outage", label: "Outage" },
  { id: "rate", label: "Rate drop" },
] as const;

const templateKinds = [
  "threshold",
  "forecast",
  "nws",
  "rate",
  "outage",
  "rule",
  "battery",
  "rssi",
] as const;

const needsPro =
  !entitlements.canUseSms ||
  !entitlements.canUsePush ||
  !entitlements.canUseOutboundWebhook;

const PLAYBOOK_KINDS = [
  { id: "threshold", label: "Threshold" },
  { id: "forecast", label: "Forecast" },
  { id: "nws", label: "NWS" },
  { id: "rate", label: "Rate drop" },
  { id: "outage", label: "Outage" },
  { id: "rule", label: "Rule" },
  { id: "battery", label: "Battery" },
  { id: "rssi", label: "Signal" },
  { id: "generic", label: "Generic" },
] as const;

const rulesJson = JSON.stringify(settings.alertRules ?? []);
---
{!canEdit && (
  <p class="alert-warning mb-4" role="status">
    View-only — alert settings cannot be changed on this account.
  </p>
)}
<p class="alert-success mt-0 mb-4 hidden" id="alert-action-status" role="status"></p>
<p class="alert-warning mt-0 mb-4 hidden" id="alert-action-error" role="alert"></p>
<form method="POST" id="alert-settings-form" data-alert-settings-form class="alert-settings-form">
  <fieldset disabled={!canEdit} class="border-0 p-0 m-0 min-w-0 space-y-4">
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="alert_rules_json" id="alert_rules_json" value={rulesJson} />
  <input type="hidden" name="alert_playbooks_json" id="alert_playbooks_json" value={JSON.stringify(settings.alertPlaybooks ?? [])} />
  <input type="hidden" name="alert_templates_json" id="alert_templates_json" value={JSON.stringify(settings.alertTemplates ?? {})} />

  <AlertSettingsNav />

  <AlertSettingsPanel
    id="alert-section-basics"
    title="Basics"
    subtitle="Turn alerts on or pause them temporarily without changing your thresholds."
  >
    <label class="checkbox-row mb-4">
      <input type="checkbox" name="alerts_enabled" value="true" checked={settings.enabled} />
      <span>Turn on alerts</span>
    </label>

    <h3 class="alert-settings-subheading">Snooze & vacation</h3>
    <p class="form-hint mb-3">
      Snooze pauses most alerts for 24h (outage still fires). Vacation suppresses non-critical alerts for 7 days.
      {settings.snoozeUntil && (
        <span class="block mt-1">Snoozed until {new Date(settings.snoozeUntil).toLocaleString()}.</span>
      )}
      {settings.vacationUntil && (
        <span class="block mt-1">Vacation until {new Date(settings.vacationUntil).toLocaleString()}.</span>
      )}
    </p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn-secondary" data-snooze-action="snooze_24">Snooze 24h</button>
      <button type="button" class="btn-secondary" data-snooze-action="vacation_7">Vacation 7d</button>
      {settings.snoozeUntil && (
        <button type="button" class="btn-secondary" data-snooze-action="clear_snooze">Clear snooze</button>
      )}
      {settings.vacationUntil && (
        <button type="button" class="btn-secondary" data-snooze-action="clear_vacation">End vacation</button>
      )}
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-triggers"
    title="What triggers alerts"
    subtitle="Core temperature, humidity, outage, and forecast thresholds."
  >
    <div class="config-row-grid mb-4">
      <div class="form-field mb-0">
        <label class="form-label" for="freeze_threshold_f">Freeze below (°F)</label>
        <input class="form-input" type="number" step="0.5" id="freeze_threshold_f" name="freeze_threshold_f" value={settings.freezeThresholdF} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="humidity_threshold">Humidity above (%)</label>
        <input class="form-input" type="number" step="1" id="humidity_threshold" name="humidity_threshold" value={settings.humidityThreshold} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="rate_change_f">Rate drop (°F / hour)</label>
        <input class="form-input" type="number" step="0.5" id="rate_change_f" name="rate_change_f" value={settings.rateChangeF} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="outage_hours">No reading for (hours)</label>
        <input class="form-input" type="number" step="0.5" id="outage_hours" name="outage_hours" value={settings.outageHours} />
      </div>
    </div>

    <details class="alert-settings-nested">
      <summary>Forecast freeze risk</summary>
      <div class="alert-settings-nested-body">
        <label class="checkbox-row mb-2">
          <input type="checkbox" name="forecast_freeze_enabled" value="true" checked={settings.forecastFreezeEnabled} />
          <span>Warn when outdoor forecast may hit freeze threshold</span>
        </label>
        <label class="checkbox-row mb-3">
          <input type="checkbox" name="nws_freeze_alerts_enabled" value="true" checked={settings.nwsFreezeAlertsEnabled} />
          <span>NWS official freeze / cold alerts for your weather city</span>
        </label>
        <div class="form-field mb-0">
          <label class="form-label" for="forecast_hours_ahead">Look-ahead hours</label>
          <input class="form-input" type="number" min="3" max="48" step="1" id="forecast_hours_ahead" name="forecast_hours_ahead" value={settings.forecastHoursAhead} />
        </div>
      </div>
    </details>

    <details class="alert-settings-nested">
      <summary>Device & feed health</summary>
      <div class="alert-settings-nested-body">
        <div class="config-row-grid mb-4">
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="battery_alerts_enabled" value="true" checked={settings.batteryAlertsEnabled} />
            <span>Low battery alerts</span>
          </label>
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="battery_trend_alerts_enabled" value="true" checked={settings.batteryTrendAlertsEnabled} />
            <span>Battery trend drop</span>
          </label>
          <div class="form-field mb-0">
            <label class="form-label" for="battery_threshold_pct">Battery below (%)</label>
            <input class="form-input" type="number" id="battery_threshold_pct" name="battery_threshold_pct" value={settings.batteryThresholdPct} />
          </div>
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="rssi_alerts_enabled" value="true" checked={settings.rssiAlertsEnabled} />
            <span>Weak WiFi signal</span>
          </label>
          <div class="form-field mb-0">
            <label class="form-label" for="rssi_threshold">RSSI below (dBm)</label>
            <input class="form-input" type="number" id="rssi_threshold" name="rssi_threshold" value={settings.rssiThreshold} />
          </div>
        </div>
        <label class="checkbox-row mb-3">
          <input type="checkbox" name="feed_uptime_alerts_enabled" value="true" checked={settings.feedUptimeAlertsEnabled} />
          <span>Feed unreachable (hourly check on pull JSON feeds)</span>
        </label>
        <label class="checkbox-row mb-0">
          <input
            type="checkbox"
            name="portfolio_alerts_enabled"
            value="true"
            checked={settings.portfolioAlertsEnabled}
            disabled={!entitlements.canUsePortfolio}
          />
          <span>
            Portfolio freeze alerts (any property crosses threshold)
            {!entitlements.canUsePortfolio && (
              <span class="text-[var(--color-text-muted)]"> — Pro plan</span>
            )}
          </span>
        </label>
      </div>
    </details>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-channels"
    title="Channels & destinations"
    subtitle="Pick how we reach you. Destination fields appear only for enabled channels."
  >
    <p class="form-hint mb-3">
      Free: email, Discord, Telegram, Slack, Teams, ntfy, Pushover. Pro: SMS, WhatsApp, browser push, outbound webhooks.
    </p>
    <div class="alert-channel-grid mb-4">
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_email" value="true" checked={settings.channelEmail} data-channel-toggle="email" />
        <span>Email</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_discord" value="true" checked={settings.channelDiscord} data-channel-toggle="discord" />
        <span>Discord</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_telegram" value="true" checked={settings.channelTelegram} data-channel-toggle="telegram" />
        <span>Telegram</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_slack" value="true" checked={settings.channelSlack} data-channel-toggle="slack" />
        <span>Slack</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_teams" value="true" checked={settings.channelTeams} data-channel-toggle="teams" />
        <span>Teams</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_ntfy" value="true" checked={settings.channelNtfy} data-channel-toggle="ntfy" />
        <span>ntfy</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_pushover" value="true" checked={settings.channelPushover} data-channel-toggle="pushover" />
        <span>Pushover</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_whatsapp" value="true" checked={settings.channelWhatsapp} disabled={!entitlements.canUseSms} data-channel-toggle="whatsapp" />
        <span>WhatsApp {!entitlements.canUseSms && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_sms" value="true" checked={settings.channelSms} disabled={!entitlements.canUseSms} data-channel-toggle="sms" />
        <span>SMS {!entitlements.canUseSms && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_push" value="true" checked={settings.channelPush} disabled={!entitlements.canUsePush} data-channel-toggle="push" />
        <span>Browser push {!entitlements.canUsePush && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_webhook" value="true" checked={settings.channelWebhook} disabled={!entitlements.canUseOutboundWebhook} data-channel-toggle="webhook" />
        <span>Outbound webhook {!entitlements.canUseOutboundWebhook && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
    </div>

    {entitlements.canUseSms && !twilioConfigured && (
      <p class="alert-warning mb-4 text-sm" role="status">
        SMS is on your plan but Twilio is not configured on this server. Messages will be skipped until `TWILIO_*` secrets are set.
      </p>
    )}

    {needsPro && (
      <p class="mb-4 text-sm text-[var(--color-text-muted)]">
        Unlock SMS, push, and webhooks with <a class="text-link" href="/dashboard#plans">Pro</a>.
      </p>
    )}

    <div class="alert-channel-panels">
      <div class="alert-channel-panel" data-channel-panel="email" hidden={!settings.channelEmail}>
        <p class="alert-channel-panel-label">Email</p>
        <div class="form-field mb-0">
          <label class="form-label" for="alert_email">Alert email</label>
          <input class="form-input" type="email" id="alert_email" name="alert_email" value={settings.email ?? userEmail} placeholder={userEmail} />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="discord" hidden={!settings.channelDiscord}>
        <p class="alert-channel-panel-label">Discord</p>
        <div class="form-field mb-0">
          <label class="form-label" for="discord_webhook_url">Webhook URL</label>
          <input class="form-input" type="url" id="discord_webhook_url" name="discord_webhook_url" value={settings.discordWebhookUrl ?? ""} placeholder="https://discord.com/api/webhooks/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="telegram" hidden={!settings.channelTelegram}>
        <p class="alert-channel-panel-label">Telegram</p>
        <div class="form-field">
          <label class="form-label" for="telegram_bot_token">Bot token</label>
          <input class="form-input" type="text" id="telegram_bot_token" name="telegram_bot_token" value={settings.telegramBotToken ?? ""} placeholder="123456:ABC..." autocomplete="off" />
        </div>
        <div class="form-field">
          <label class="form-label" for="telegram_chat_id">Chat ID</label>
          <input class="form-input" type="text" id="telegram_chat_id" name="telegram_chat_id" value={settings.telegramChatId ?? ""} placeholder="-100..." />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="telegram_command_secret">Webhook secret (optional)</label>
          <input class="form-input" type="text" id="telegram_command_secret" name="telegram_command_secret" value={settings.telegramCommandSecret ?? ""} placeholder="random-secret" autocomplete="off" />
          <p class="form-hint mb-0">Set bot webhook to <code>/api/telegram/webhook?secret=…</code> for /status, /snooze, /vacation.</p>
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="slack" hidden={!settings.channelSlack}>
        <p class="alert-channel-panel-label">Slack</p>
        <div class="form-field mb-0">
          <label class="form-label" for="slack_webhook_url">Incoming webhook URL</label>
          <input class="form-input" type="url" id="slack_webhook_url" name="slack_webhook_url" value={settings.slackWebhookUrl ?? ""} placeholder="https://hooks.slack.com/services/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="teams" hidden={!settings.channelTeams}>
        <p class="alert-channel-panel-label">Microsoft Teams</p>
        <div class="form-field mb-0">
          <label class="form-label" for="teams_webhook_url">Webhook URL</label>
          <input class="form-input" type="url" id="teams_webhook_url" name="teams_webhook_url" value={settings.teamsWebhookUrl ?? ""} placeholder="https://outlook.office.com/webhook/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="ntfy" hidden={!settings.channelNtfy}>
        <p class="alert-channel-panel-label">ntfy</p>
        <div class="form-field">
          <label class="form-label" for="ntfy_topic">Topic</label>
          <input class="form-input" type="text" id="ntfy_topic" name="ntfy_topic" value={settings.ntfyTopic ?? ""} placeholder="garage-freeze-alerts" />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="ntfy_server">Server (optional)</label>
          <input class="form-input" type="url" id="ntfy_server" name="ntfy_server" value={settings.ntfyServer} placeholder="https://ntfy.sh" />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="pushover" hidden={!settings.channelPushover}>
        <p class="alert-channel-panel-label">Pushover</p>
        <div class="form-field">
          <label class="form-label" for="pushover_user_key">User key</label>
          <input class="form-input" type="text" id="pushover_user_key" name="pushover_user_key" value={settings.pushoverUserKey ?? ""} />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="pushover_app_token">App token</label>
          <input class="form-input" type="text" id="pushover_app_token" name="pushover_app_token" value={settings.pushoverAppToken ?? ""} autocomplete="off" />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="whatsapp" hidden={!settings.channelWhatsapp}>
        <p class="alert-channel-panel-label">WhatsApp</p>
        <div class="form-field mb-0">
          <label class="form-label" for="whatsapp_phone">Phone number</label>
          <input class="form-input" type="tel" id="whatsapp_phone" name="whatsapp_phone" value={settings.whatsappPhone ?? ""} placeholder="+15551234567" disabled={!entitlements.canUseSms} />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="sms" hidden={!settings.channelSms}>
        <p class="alert-channel-panel-label">SMS</p>
        <div class="form-field mb-0">
          <label class="form-label" for="sms_phone">Phone number</label>
          <input class="form-input" type="tel" id="sms_phone" name="sms_phone" value={settings.smsPhone ?? ""} placeholder="+15551234567" disabled={!entitlements.canUseSms} />
          <p class="form-hint mb-0">International format, e.g. +1 for US numbers.</p>
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="webhook" hidden={!settings.channelWebhook}>
        <p class="alert-channel-panel-label">Outbound webhook</p>
        <div class="form-field">
          <label class="form-label" for="outbound_webhook_url">URL</label>
          <input class="form-input" type="url" id="outbound_webhook_url" name="outbound_webhook_url" value={settings.outboundWebhookUrl ?? ""} placeholder="https://hooks.example.com/..." disabled={!entitlements.canUseOutboundWebhook} />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="outbound_webhook_secret">Signing secret (optional)</label>
          <input class="form-input" type="text" id="outbound_webhook_secret" name="outbound_webhook_secret" value={settings.outboundWebhookSecret ?? ""} disabled={!entitlements.canUseOutboundWebhook} />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="push" hidden={!settings.channelPush}>
        <p class="alert-channel-panel-label">Browser push (this device)</p>
        {!vapidPublicKey ? (
          <p class="form-hint mb-0">Push is not configured on the server yet (missing VAPID keys).</p>
        ) : (
          <>
            <p class="form-hint mb-3" id="push-status">Checking push status…</p>
            <button type="button" class="btn-secondary" id="enable-push-btn" data-vapid={vapidPublicKey}>
              Enable browser push
            </button>
            <p class="form-hint mt-2 mb-0" id="push-hint"></p>
          </>
        )}
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-quiet"
    title="Quiet hours"
    subtitle="Suppress non-critical alerts overnight while still allowing freeze warnings through."
  >
    <label class="checkbox-row mb-2">
      <input type="checkbox" name="quiet_hours_enabled" value="true" checked={settings.quietHoursEnabled} />
      <span>Enable quiet hours</span>
    </label>
    <label class="checkbox-row mb-3">
      <input type="checkbox" name="quiet_hours_bypass_freeze" value="true" checked={settings.quietHoursBypassFreeze} />
      <span>Always deliver freeze / forecast alerts</span>
    </label>
    <label class="checkbox-row mb-4">
      <input type="checkbox" name="quiet_hours_sms_critical" value="true" checked={settings.quietHoursSmsCritical} disabled={!entitlements.canUseSms} />
      <span>
        Still send critical freeze/forecast via SMS (Pro)
        {!entitlements.canUseSms && (
          <> — <a class="text-link" href="/dashboard#plans">Upgrade</a></>
        )}
      </span>
    </label>
    <div class="config-row-grid">
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_start">Start (HH:MM)</label>
        <input class="form-input" type="text" id="quiet_hours_start" name="quiet_hours_start" value={settings.quietHoursStart} placeholder="22:00" />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_end">End (HH:MM)</label>
        <input class="form-input" type="text" id="quiet_hours_end" name="quiet_hours_end" value={settings.quietHoursEnd} placeholder="07:00" />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_timezone">Timezone (IANA)</label>
        <input class="form-input" type="text" id="quiet_hours_timezone" name="quiet_hours_timezone" value={settings.quietHoursTimezone} placeholder="America/New_York" />
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-automation"
    title="Rules & escalation"
    subtitle="Composite AND rules, timed playbooks, and SMS re-send if a condition persists."
    collapsible
  >
    <h3 class="alert-settings-subheading">Composite rules (AND)</h3>
    <p class="form-hint mb-3">Fire when every condition in a rule is true (e.g. door open AND temperature drop).</p>
    <div id="alert-rules-list" class="space-y-3 mb-3"></div>
    <button type="button" class="btn-secondary mb-4" id="add-alert-rule">Add rule</button>

    <h3 class="alert-settings-subheading">Alert playbooks</h3>
    <p class="form-hint mb-3">Follow-up steps after the initial alert — e.g. SMS 15 minutes later if still unacknowledged.</p>
    <div id="alert-playbooks-list" class="space-y-3 mb-3"></div>
    <button type="button" class="btn-secondary mb-4" id="add-playbook-step">Add step</button>
    <textarea
      class="form-textarea font-mono text-xs sr-only"
      id="alert_playbooks_editor"
      data-playbooks-editor
      aria-hidden="true"
    >{JSON.stringify(settings.alertPlaybooks ?? [], null, 2)}</textarea>

    <h3 class="alert-settings-subheading">SMS escalation</h3>
    <div class="config-row-grid">
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="escalation_enabled" value="true" checked={settings.escalationEnabled} />
        <span>Re-send threshold alerts via SMS</span>
      </label>
      <div class="form-field mb-0">
        <label class="form-label" for="escalation_minutes">After (minutes)</label>
        <input class="form-input" type="number" id="escalation_minutes" name="escalation_minutes" value={settings.escalationMinutes} min="5" />
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-advanced"
    title="Advanced routing & reports"
    subtitle="Per-kind channel overrides, space routing, custom messages, digests, and reading webhooks."
    collapsible
  >
    <details class="alert-settings-nested">
      <summary>Severity routing (optional)</summary>
      <div class="alert-settings-nested-body">
        <p class="form-hint mb-3">Leave empty to use global channel checkboxes. Otherwise only selected channels fire for that kind.</p>
