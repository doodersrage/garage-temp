---
import {
  PLAN_FEATURE_ROWS,
  type ComparisonTier,
  type PlanFeatureRow,
} from "../lib/planComparison";
import {
  getMemberPriceDisplay,
  getPortfolioPriceDisplay,
  getProPriceDisplay,
} from "../lib/stripePricing";

interface Props {
  highlightTier?: ComparisonTier | null;
  showAnchors?: boolean;
}

const { highlightTier = null, showAnchors = true } = Astro.props;

const memberSave = getMemberPriceDisplay().annualSavingsPct;
const proSave = getProPriceDisplay().annualSavingsPct;
const portfolioSave = getPortfolioPriceDisplay().annualSavingsPct;

function annualDiscountLabel(pct: number | null): string {
  if (pct != null && pct > 0) return `Save ${pct}%`;
  return "Save ~20%";
}

const rows: PlanFeatureRow[] = PLAN_FEATURE_ROWS.map((row) => {
  if (row.id !== "annual_billing") return row;
  return {
    ...row,
    member: annualDiscountLabel(memberSave),
    pro: annualDiscountLabel(proSave),
    portfolio: annualDiscountLabel(portfolioSave),
  };
});

const categories = [...new Set(rows.map((row) => row.category))];
const tiers: ComparisonTier[] = ["free", "member", "pro", "portfolio"];

function cellValue(row: PlanFeatureRow, tier: ComparisonTier): string {
  return row[tier];
}
---
<div class="plan-comparison">
  <p class="plan-comparison-scroll-hint">Swipe sideways to compare Free, Member, Pro, and Portfolio.</p>
  <div class="plan-comparison-wrap">
  <table class="plan-comparison-table">
    <thead>
      <tr>
        <th scope="col">Feature</th>
        <th scope="col" class:list={[highlightTier === "free" && "plan-col-highlight"]}>Free</th>
        <th scope="col" class:list={[highlightTier === "member" && "plan-col-highlight"]}>Member</th>
        <th scope="col" class:list={[highlightTier === "pro" && "plan-col-highlight"]}>Pro</th>
        <th scope="col" class:list={[highlightTier === "portfolio" && "plan-col-highlight"]}>Portfolio</th>
      </tr>
    </thead>
    <tbody>
      {categories.map((category) => (
        <>
          <tr class="plan-comparison-category">
            <th colspan="5" scope="rowgroup">{category}</th>
          </tr>
          {rows.filter((row) => row.category === category).map((row) => (
            <tr
              id={showAnchors && row.anchor ? row.anchor : undefined}
              class:list={[row.emphasis && "plan-comparison-emphasis"]}
            >
              <th scope="row">{row.label}</th>
              {tiers.map((tier) => (
                <td class:list={[highlightTier === tier && "plan-col-highlight"]}>
                  {cellValue(row, tier)}
                  {row.cellBadge?.[tier] && (
                    <span class="plan-cell-badge">{row.cellBadge[tier]}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
  </div>
</div>
