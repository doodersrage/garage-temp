---
import { PLAN_FEATURE_ROWS } from "../lib/planComparison";

interface Props {
  highlightTier?: "free" | "member" | "pro" | null;
  showAnchors?: boolean;
}

const { highlightTier = null, showAnchors = true } = Astro.props;

const categories = [...new Set(PLAN_FEATURE_ROWS.map((row) => row.category))];
---
<div class="plan-comparison-wrap overflow-x-auto">
  <table class="plan-comparison-table">
    <thead>
      <tr>
        <th scope="col">Feature</th>
        <th scope="col" class:list={[highlightTier === "free" && "plan-col-highlight"]}>Free</th>
        <th scope="col" class:list={[highlightTier === "member" && "plan-col-highlight"]}>Member</th>
        <th scope="col" class:list={[highlightTier === "pro" && "plan-col-highlight"]}>Pro</th>
      </tr>
    </thead>
    <tbody>
      {categories.map((category) => (
        <>
          <tr class="plan-comparison-category">
            <th colspan="4" scope="rowgroup">{category}</th>
          </tr>
          {PLAN_FEATURE_ROWS.filter((row) => row.category === category).map((row) => (
            <tr id={showAnchors && row.anchor ? row.anchor : undefined}>
              <th scope="row">{row.label}</th>
              <td class:list={[highlightTier === "free" && "plan-col-highlight"]}>{row.free}</td>
              <td class:list={[highlightTier === "member" && "plan-col-highlight"]}>{row.member}</td>
              <td class:list={[highlightTier === "pro" && "plan-col-highlight"]}>{row.pro}</td>
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>
