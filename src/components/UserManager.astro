---
import type { PaginatedManagedUsers, ManagedUserListQuery } from "../lib/userManager";
import {
  formatUserGroups,
  formatUserTimestamp,
  managedUserListQueryString,
} from "../lib/userManager";
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  users: PaginatedManagedUsers;
  currentUserId: string;
  query: ManagedUserListQuery;
  basePath?: string;
  status?: string | null;
}

const {
  users,
  currentUserId,
  query,
  basePath = "/dashboard/users",
  status = null,
} = Astro.props;
const { users: rows, page, pageSize, totalCount, totalPages, error } = users;
const { search, group, sort } = query;

const showingFrom = totalCount === 0 ? 0 : (page - 1) * pageSize + 1;
const showingTo = totalCount === 0 ? 0 : Math.min(page * pageSize, totalCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < totalPages ? page + 1 : null;
const listQuery = { search, group, sort };
const redirectTo = `${basePath}${managedUserListQueryString({ ...listQuery, page })}`;
const hasFilters = Boolean(search || group || sort !== "created_desc");

function pageHref(next: number): string {
  return `${basePath}${managedUserListQueryString({ ...listQuery, page: next })}`;
}
---

<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">Registered users</h2>
      <p class="card-subtitle">
        Review accounts, group memberships, and grant or revoke admin access.
      </p>
    </div>
  </div>

  {status === "updated" && (
    <div class="alert-success mb-4" role="status">
      <p class="m-0">User access updated.</p>
    </div>
  )}

  {status === "error" && (
    <div class="alert-warning mb-4" role="alert">
      <p class="m-0">Unable to update user access. Please try again.</p>
    </div>
  )}

  <form class="history-filters" method="get" action={basePath}>
    <div class="form-field mb-0">
      <label class="form-label" for="user-search">Search</label>
      <input
        class="form-input"
        type="search"
        id="user-search"
        name="q"
        value={search}
        placeholder="Email or user id"
      />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="user-group">Group</label>
      <select class="form-input" id="user-group" name="group">
        <option value="" selected={group === ""}>All groups</option>
        <option value="admin" selected={group === "admin"}>Admin</option>
        <option value="portfolio" selected={group === "portfolio"}>Portfolio</option>
        <option value="pro" selected={group === "pro"}>Pro</option>
        <option value="member" selected={group === "member"}>Member</option>
        <option value="user" selected={group === "user"}>User</option>
      </select>
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="user-sort">Sort</label>
      <select class="form-input" id="user-sort" name="sort">
        <option value="created_desc" selected={sort === "created_desc"}>Newest first</option>
        <option value="created_asc" selected={sort === "created_asc"}>Oldest first</option>
        <option value="email_asc" selected={sort === "email_asc"}>Email A–Z</option>
        <option value="email_desc" selected={sort === "email_desc"}>Email Z–A</option>
      </select>
    </div>
    <button type="submit" class="btn-secondary self-end">Apply</button>
    {hasFilters && (
      <a class="btn-ghost self-end" href={basePath}>Clear</a>
    )}
  </form>
  <p class="preference-hint mb-4">
    Search matches email or user id. Pro and Portfolio accounts also belong to Member.
  </p>

  {error ? (
    <div class="empty-state">
      <p>Unable to load users: {error}</p>
    </div>
  ) : rows.length === 0 ? (
    <div class="empty-state">
      <p>{hasFilters ? "No registered users match these filters." : "No registered users were found."}</p>
    </div>
  ) : (
    <>
      <div class="table-wrap">
        <table class="data-table data-table-users">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Joined</th>
              <th scope="col">Groups</th>
              <th scope="col">Admin</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((managedUser) => {
              const isSelf = managedUser.user_id === currentUserId;

              return (
                <tr>
                  <td>
                    {managedUser.email}
                    {isSelf && (
                      <span class="ml-2 rounded-full bg-[rgb(252_222_156/0.55)] px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--color-accent-hover)]">
                        You
                      </span>
                    )}
                  </td>
                  <td>{formatUserTimestamp(managedUser.created_at)}</td>
                  <td>{formatUserGroups(managedUser.groups)}</td>
                  <td>
                    {managedUser.is_admin ? (
                      isSelf ? (
                        <span class="rounded-full bg-[rgb(252_222_156/0.55)] px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-[var(--color-accent-hover)]">
                          Admin
                        </span>
                      ) : (
                        <form action="/api/admin/users/toggle-admin" method="post">
                          <input type="hidden" name="redirect" value={redirectTo} />
                          <input type="hidden" name="user_id" value={managedUser.user_id} />
                          <input type="hidden" name="make_admin" value="false" />
                          <button class="btn-danger" type="submit">
                            Revoke admin
                          </button>
                        </form>
                      )
                    ) : (
                      <form action="/api/admin/users/toggle-admin" method="post">
                        <input type="hidden" name="redirect" value={redirectTo} />
                        <input type="hidden" name="user_id" value={managedUser.user_id} />
                        <input type="hidden" name="make_admin" value="true" />
                        <button class="btn-secondary" type="submit">
                          Grant admin
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <p class="pagination-summary">
          Showing {showingFrom}–{showingTo} of {totalCount} users
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={pageHref(prevPage)}>Previous</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Previous</span>
          )}
          <span class="pagination-current">Page {page} of {Math.max(totalPages, 1)}</span>
          {nextPage ? (
            <a class="btn-secondary" href={pageHref(nextPage)}>Next</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Next</span>
          )}
        </div>
      </div>
    </>
  )}
</DashboardCard>

<style>
  .data-table-users {
    min-width: 48rem;
  }
</style>
