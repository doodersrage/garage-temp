---
Astro.cache.set({
  maxAge: 1300,
  swr: 600,
});
import { fetchWeather } from '../lib/FetchWeather';
const weatherData = await fetchWeather();

const weatherStats = weatherData
  ? [
      { label: 'Temperature', value: `${weatherData.main.temp}°F` },
      { label: 'Humidity', value: `${weatherData.main.humidity}%` },
      { label: 'Feels Like', value: `${weatherData.main.feels_like}°F` },
      { label: 'Wind Speed', value: `${weatherData.wind.speed} mph` },
      { label: 'Wind Gusts', value: `${weatherData.wind.gust} mph` },
      { label: 'Cloud Cover', value: `${weatherData.clouds.all}%` },
      {
        label: 'Condition',
        value: weatherData.weather[0].description,
        detail: true,
      },
    ]
  : [];
---

<section class="card animate-slide-in-right">
  {weatherData ? (
    <>
      <h2 class="card-title">Current Weather</h2>
      <p class="card-subtitle">Richmond, Virginia</p>
      <div class="stat-grid">
        {weatherStats.map(({ label, value, detail }) => (
          <article class="stat-item">
            <span class="stat-label">{label}</span>
            {detail ? (
              <p class="stat-value capitalize">{value}</p>
            ) : (
              <p class="stat-value">{value}</p>
            )}
          </article>
        ))}
      </div>
    </>
  ) : (
    <p class="loading-state">Loading weather data...</p>
  )}
</section>
