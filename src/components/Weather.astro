---
import {
  fetchWeather,
  getDefaultWeatherCityId,
  resolveWeatherCityId,
} from '../lib/FetchWeather';

interface Props {
  cityId?: string | null;
}

const { cityId = null } = Astro.props;
const resolvedCityId = resolveWeatherCityId(cityId);

if (resolvedCityId === getDefaultWeatherCityId()) {
  Astro.cache.set({
    maxAge: 1300,
    swr: 600,
  });
}

const weatherData = await fetchWeather(resolvedCityId);
const weatherError = weatherData
  ? null
  : "Unable to load weather for this location.";

const locationLabel = weatherData
  ? `${weatherData.name}${weatherData.sys?.country ? `, ${weatherData.sys.country}` : ""}`
  : "";

const weatherStats = weatherData
  ? [
      { label: 'Temperature', value: `${weatherData.main.temp}°F` },
      { label: 'Humidity', value: `${weatherData.main.humidity}%` },
      { label: 'Feels Like', value: `${weatherData.main.feels_like}°F` },
      { label: 'Wind Speed', value: `${weatherData.wind.speed} mph` },
      { label: 'Wind Gusts', value: `${weatherData.wind.gust} mph` },
      { label: 'Cloud Cover', value: `${weatherData.clouds.all}%` },
      {
        label: 'Condition',
        value: weatherData.weather[0].description,
        detail: true,
      },
    ]
  : [];
---

<section class="card animate-slide-in-right">
  {weatherData ? (
    <>
      <h2 class="card-title">Current Weather</h2>
      <p class="card-subtitle">{locationLabel}</p>
      <div class="stat-grid">
        {weatherStats.map(({ label, value, detail }) => (
          <article class="stat-item">
            <span class="stat-label">{label}</span>
            {detail ? (
              <p class="stat-value capitalize">{value}</p>
            ) : (
              <p class="stat-value">{value}</p>
            )}
          </article>
        ))}
      </div>
    </>
  ) : weatherError ? (
    <div class="empty-state">
      <h2 class="card-title">Current Weather</h2>
      <p class="mb-4">{weatherError}</p>
      <a class="btn-secondary" href="/dashboard#weather">Change weather location</a>
    </div>
  ) : (
    <p class="loading-state">Loading weather data...</p>
  )}
</section>
