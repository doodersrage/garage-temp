---
import {
  fetchWeatherSnapshot,
  getDefaultWeatherCityId,
  resolveWeatherCityId,
} from '../lib/FetchWeather';

interface Props {
  cityId?: string | null;
}

const { cityId = null } = Astro.props;
const resolvedCityId = resolveWeatherCityId(cityId);

if (resolvedCityId === getDefaultWeatherCityId()) {
  Astro.cache.set({
    maxAge: 1300,
    swr: 600,
  });
}

const weather = await fetchWeatherSnapshot(resolvedCityId);
const weatherError = weather
  ? null
  : "Unable to load weather for this location.";

const locationLabel = weather
  ? `${weather.name}${weather.country ? `, ${weather.country}` : ""}`
  : "";

const weatherStats = weather
  ? [
      { label: 'Temperature', value: `${weather.temp}°F` },
      { label: 'Humidity', value: `${weather.humidity}%` },
      { label: 'Feels Like', value: `${weather.feelsLike}°F` },
      { label: 'Wind Speed', value: `${weather.windSpeed} mph` },
      ...(weather.windGust != null
        ? [{ label: 'Wind Gusts', value: `${weather.windGust} mph` }]
        : []),
      { label: 'Cloud Cover', value: `${weather.cloudCover}%` },
      {
        label: 'Condition',
        value: weather.description,
        detail: true,
      },
    ]
  : [];
---

<section class="card animate-slide-in-right">
  {weather ? (
    <>
      <h2 class="card-title">Current Weather</h2>
      <p class="card-subtitle">{locationLabel}</p>
      <div class="stat-grid">
        {weatherStats.map(({ label, value, detail }) => (
          <article class="stat-item">
            <span class="stat-label">{label}</span>
            {detail ? (
              <p class="stat-value capitalize">{value}</p>
            ) : (
              <p class="stat-value">{value}</p>
            )}
          </article>
        ))}
      </div>
    </>
  ) : (
    <div class="empty-state">
      <h2 class="card-title">Current Weather</h2>
      <p class="mb-4">{weatherError}</p>
      <a class="btn-secondary" href="/dashboard#weather">Change weather location</a>
    </div>
  )}
</section>
