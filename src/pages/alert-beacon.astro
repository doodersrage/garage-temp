---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { affiliateHref, COMMERCE_LINK_REL } from "../lib/affiliateLinks";
import { BRAND_NAME } from "../lib/brand";
import { BAYBUDDY_NAME } from "../lib/bayBuddy";
import { CLAIM_PUCK_REPO_URL } from "../lib/claimPuck";

const NEOPIXEL = affiliateHref("https://www.adafruit.com/product/1426");
const RP2040 = affiliateHref("https://www.adafruit.com/product/5698");
const AMAZON_NEOPIXEL = affiliateHref("https://www.amazon.com/s?k=WS2812+NeoPixel+stick");
---
<AccessoryProduct
  accessoryId="alert-beacon"
  faqKey="alertBeacon"
  title="Alert beacon"
  description={`A desk or hallway mood light that mirrors ${BRAND_NAME} freeze and flood moods. Same Bay Buddy mood API as the claim puck — not a temperature probe.`}
>
  <a slot="actions" class="btn-primary" href="/bay-buddy">Get {BAYBUDDY_NAME}</a>
  <a slot="actions" class="btn-secondary" href="/claim-puck">Claim puck</a>
  <a slot="actions" class="btn-ghost" href="/docs/api#claim-puck">Mood API</a>

  <section class="card">
    <h2 class="card-title">What it is</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>Does:</strong> Shows live bay mood (cozy, drafty, shiver, panic, offline, hero) on a brighter
        NeoPixel stick or ring, driven from <code>GET /api/bays/&lt;bay&gt;/mood</code> via {BAYBUDDY_NAME}.
      </li>
      <li>
        <strong>Does not:</strong> Sense temperature, replace Alerts SMS/email, or claim a bay by itself.
        Pair with a freeze probe and optionally a
        <a class="text-link" href="/claim-puck">claim puck</a>
        for presence.
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">Parts</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">Alert beacon parts</caption>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col">Why</th>
            <th scope="col">Buy</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">RP2040-Zero (or Pico)</th>
            <td>USB companion MCU; same host path as claim puck.</td>
            <td>
              <a class="text-link" href={RP2040} target="_blank" rel={COMMERCE_LINK_REL}>Adafruit RP2040</a>
            </td>
          </tr>
          <tr>
            <th scope="row">NeoPixel stick / ring</th>
            <td>Brighter hallway-visible mood than the Zero’s tiny LED.</td>
            <td>
              <a class="text-link" href={NEOPIXEL} target="_blank" rel={COMMERCE_LINK_REL}>Adafruit stick</a>
              ·
              <a class="text-link" href={AMAZON_NEOPIXEL} target="_blank" rel={COMMERCE_LINK_REL}>Amazon search</a>
            </td>
          </tr>
          <tr>
            <th scope="row">5V USB power</th>
            <td>Desk or wall wart; keep data wire short.</td>
            <td>Any quality USB supply.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">Setup</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      <li>
        Flash
        <a class="text-link" href={CLAIM_PUCK_REPO_URL} target="_blank" rel="noreferrer">claim-puck firmware</a>
        (or the alert-beacon pin map in that repo) and wire NeoPixel data to the documented GPIO.
      </li>
      <li>
        Claim the bay once with a
        <a class="text-link" href="/claim-puck">claim puck</a>
        (or CLI), then enable <strong>Drive puck mood</strong> in {BAYBUDDY_NAME} for the beacon serial port.
      </li>
      <li>
        Confirm moods change when freeze margin drops or a
        <a class="text-link" href="/leak-puck">leak puck</a>
        goes wet.
      </li>
    </ol>
  </section>
</AccessoryProduct>
