---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import DisplayPreferences from "../components/DisplayPreferences.astro";
import DashboardOnboarding from "../components/DashboardOnboarding.astro";
import { getAuthFromCookies } from "../lib/auth";
import { getUserPreferences } from "../lib/userPreferences";
import { fetchGarageTempHistory } from "../lib/garageTempsHistory";
import { fetchUserTempConfig } from "../lib/userTempConfig";
import { getUserEntitlements } from "../lib/entitlements";
import { getUserDevicesAsTempConfig } from "../lib/devices";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const [preferences, tempConfig, history, entitlements, deviceConfig] = await Promise.all([
  getUserPreferences(user),
  fetchUserTempConfig(user.id),
  fetchGarageTempHistory(user.id, 1, 1),
  getUserEntitlements(user.id),
  getUserDevicesAsTempConfig(user.id, user.email),
]);

const hasDevices =
  tempConfig.hasCustomConfig ||
  deviceConfig.devices.some((d) => d.source === "push");
const hasSensors =
  preferences.tempProbes.length > 0 ||
  deviceConfig.devices.some(
    (d) => d.source === "push" && d.sensors.length > 0,
  );
---
<DashboardLayout title="Dashboard">
  <div class="space-y-6">
    <section class="card animate-slide-in-left">
      <h1 class="card-title">Welcome back</h1>
      <p class="card-subtitle">{user.email}</p>
      <p class="mb-0">Manage your home page display, alerts, household sharing, and probe readings.</p>
      <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
        Plan: <strong>{entitlements.tier}</strong>
      </p>
    </section>

    <DashboardOnboarding
      hasDevices={hasDevices}
      hasSensors={hasSensors}
      hasHistory={history.totalCount > 0}
    />

    <DisplayPreferences preferences={preferences} redirectTo="/dashboard" />

    <section class="card">
      <h2 class="card-title">Alerts</h2>
      <p class="card-subtitle mb-3">
        Freeze, humidity, outage, and rate-of-change notifications across email, Discord, SMS, push, and webhooks.
      </p>
      <a class="btn-secondary" href="/dashboard/alerts">Manage alerts</a>
    </section>

    <section class="card">
      <h2 class="card-title">Install the app</h2>
      <p class="card-subtitle mb-3">
        Add Garage Temp to your home screen for faster access. See iOS limits and install steps in the guide.
      </p>
      <a class="btn-secondary" href="/about/install-pwa">PWA install guide</a>
    </section>
  </div>
</DashboardLayout>
