---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/share-kit");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Share kit", path: "/share-kit" },
  ]),
];

const reddit = `I built ThermalTrace for freeze alerts in garages, workshops, and crawlspaces (ESP/Arduino → hosted charts + SMS/email) after one too many “hope the space heater is still on” winters.

Public freeze-risk map (opt-in city aggregates): ${siteUrl}/freeze-map
Live demo (no account): ${siteUrl}/demo
Start free (no card) → Devices: ${siteUrl}/register?next=/dashboard/temperature
Freeze season checklist: ${siteUrl}/freeze-season

Happy to answer hardware / Home Assistant webhook questions.`;

const homeAssistant = `**ThermalTrace** — hosted freeze monitoring for ESPHome & DIY probes (garage, crawlspace, attic, shop).

- Official HACS integration: ${siteUrl}/integrations/home-assistant
- HTTPS ingest (device key); optional MQTT→HTTP bridge if you already run Mosquitto/HA
- Free family live share link for HA polling; Pro expands scopes + SMS / push / webhooks
- Free plan, no credit card — ${siteUrl}/register?next=/dashboard/temperature
- Interactive probe simulator: ${siteUrl}/about/probe-demo
- Public community freeze map: ${siteUrl}/freeze-map
- Embed: \`${siteUrl}/embed/freeze-map?compact=1\`

Live demo: ${siteUrl}/demo · Docs: ${siteUrl}/docs/api · Kit QR: ${siteUrl}/about/kit-qr-onboarding`;

const bluesky = `Unheated spaces freeze quietly until they do not.

ThermalTrace: DIY probes → freeze alerts + a public opt-in freeze map.
Demo (no account): ${siteUrl}/demo
Map: ${siteUrl}/freeze-map
Start free: ${siteUrl}/register?next=/dashboard/temperature`;

const hackerNews = `ThermalTrace – hosted freeze alerts for ESP/Arduino probes (live demo, free plan)

${siteUrl}/demo
${siteUrl}/`;

const discord = `Built a hosted freeze-alert dashboard for DIY probes (ESP/Arduino → HTTPS ingest).

Live demo (no signup): ${siteUrl}/demo
Free account → Devices: ${siteUrl}/register?next=/dashboard/temperature
Freeze map: ${siteUrl}/freeze-map`;

const embed = `<iframe src="${siteUrl}/embed/freeze-map?compact=1" title="ThermalTrace freeze map" width="100%" height="320" style="border:0;border-radius:12px" loading="lazy"></iframe>`;
---
<Layout
  title="Share kit"
  description="Copy-paste posts and embeds for Reddit, Home Assistant Community, and Bluesky — freeze map, live demo, and ThermalTrace links."
  schema={schema}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Spread the word"
      title="Share kit"
      lede="Ready-to-post blurbs and embeds. Tweak the voice, keep the links, ship it to the communities that care about freeze risk in unconditioned spaces."
    >
      <a slot="actions" class="btn-secondary" href="/freeze-map#embed">Freeze map embeds</a>
      <a slot="actions" class="btn-ghost" href="/stories">Customer stories</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Reddit / forums</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-reddit" rows="10" readonly>{reddit}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-reddit">Copy</button>
    </section>

    <section class="card">
      <h2 class="card-title">Home Assistant Community</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-ha" rows="10" readonly>{homeAssistant}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-ha">Copy</button>
    </section>

    <section class="card">
      <h2 class="card-title">Bluesky / short social</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-bsky" rows="7" readonly>{bluesky}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-bsky">Copy</button>
    </section>

    <section class="card">
      <h2 class="card-title">Hacker News / Show HN</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-hn" rows="5" readonly>{hackerNews}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-hn">Copy</button>
    </section>

    <section class="card">
      <h2 class="card-title">Discord / chat</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-discord" rows="6" readonly>{discord}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-discord">Copy</button>
    </section>

    <section class="card">
      <h2 class="card-title">Compact map embed</h2>
      <textarea class="form-textarea font-mono text-xs" id="share-embed" rows="3" readonly>{embed}</textarea>
      <button type="button" class="btn-secondary mt-2" data-copy-target="share-embed">Copy iframe</button>
      <p class="mt-4 mb-0 text-sm">
        Preview: <a class="text-link" href="/embed/freeze-map?compact=1">open compact embed</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Operator &amp; launch drafts</h2>
      <p class="card-subtitle mb-4">Copy/paste templates and your personal todo list (GitHub).</p>
      <ul class="text-sm space-y-2 mb-0">
        <li>
          <a
            class="text-link"
            href="https://github.com/doodersrage/thermaltrace/blob/main/docs/community/operator-checklist.md"
            target="_blank"
            rel="noreferrer"
          >Operator checklist</a>
          — HACS PR status, thermostat OAuth, Play Store, forum post
        </li>
        <li>
          <a
            class="text-link"
            href="https://github.com/doodersrage/thermaltrace/blob/main/docs/community/discord-hacs-announcement.md"
            target="_blank"
            rel="noreferrer"
          >Discord / social announcement draft</a>
        </li>
        <li>
          <a
            class="text-link"
            href="https://github.com/doodersrage/thermaltrace/blob/main/docs/community/home-assistant-forum-post.md"
            target="_blank"
            rel="noreferrer"
          >Home Assistant forum post draft</a>
        </li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Deep links worth including</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li><a class="text-link" href="/demo">/demo</a> — live readings, no account</li>
        <li><a class="text-link" href="/register?next=/dashboard/temperature">/register</a> — free, no card → Devices</li>
        <li><a class="text-link" href="/freeze-season">/freeze-season</a> — seasonal checklist</li>
        <li><a class="text-link" href="/integrations">/integrations</a> — integrations hub</li>
        <li><a class="text-link" href="/integrations/home-assistant">/integrations/home-assistant</a> — official HACS integration</li>
        <li>
          <a
            class="text-link"
            href="https://github.com/doodersrage/thermaltrace/blob/main/docs/community/home-assistant-forum-post.md"
            target="_blank"
            rel="noreferrer"
          >HA community post draft</a>
        </li>
        <li><a class="text-link" href="/about/adding-devices#mqtt-bridge">MQTT bridge</a> — keep Mosquitto/HA local, mirror over HTTPS</li>
        <li><a class="text-link" href="/compare/diy-mqtt">/compare/diy-mqtt</a> — vs self-hosted MQTT</li>
        <li><a class="text-link" href="/stories">/stories</a> — short case studies</li>
        <li><a class="text-link" href="/android">/android</a> — Play app waitlist angle</li>
      </ul>
    </section>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-copy-target]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-copy-target");
      const el = id ? document.getElementById(id) : null;
      if (!(el instanceof HTMLTextAreaElement) || !(btn instanceof HTMLButtonElement)) return;
      try {
        await navigator.clipboard.writeText(el.value);
        const prev = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => {
          btn.textContent = prev;
        }, 1800);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  });
</script>
