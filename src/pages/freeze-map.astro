---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  countFreezeMapOptIns,
  listFreezeMapSparklines,
  listLatestFreezeMapSnapshots,
} from "../lib/freezeMap";
import {
  FREEZE_MAP_SAMPLE_FLOOR,
  resolveFreezeMapDisplay,
} from "../lib/freezeMapSeed";
import { formatRelativeAge } from "../lib/relativeTime";
import { getAuthFromCookies } from "../lib/auth";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const { user } = await getAuthFromCookies(Astro.cookies);
const showSparse = Astro.url.searchParams.get("sparse") === "1";
const [liveSnapshots, liveSparklines, optInCount] = await Promise.all([
  listLatestFreezeMapSnapshots(),
  listFreezeMapSparklines(7),
  countFreezeMapOptIns(),
]);
const resolved = resolveFreezeMapDisplay(liveSnapshots, liveSparklines);
const snapshots = resolved.snapshots;
const sparklines = resolved.sparklines;
const isSeed = resolved.isSeed;
const approaching = resolved.approaching.slice(0, 6);
const visible = showSparse
  ? snapshots
  : snapshots.filter((row) => row.sample_count >= FREEZE_MAP_SAMPLE_FLOOR);
const sparseHidden = snapshots.length - visible.length;
const capturedAt = isSeed ? null : (snapshots[0]?.captured_at ?? null);
const captureAge = formatRelativeAge(capturedAt, "not yet");

const coldest = [...visible]
  .filter((row) => row.min_temp_f != null)
  .sort((a, b) => (a.min_temp_f ?? 999) - (b.min_temp_f ?? 999))
  .slice(0, 5);

const mapPins = visible
  .filter((row) => row.lat != null && row.lon != null)
  .map((row) => ({
    lat: row.lat!,
    lon: row.lon!,
    label: row.city_label,
    avg: row.avg_temp_f,
    samples: row.sample_count,
    riskPct:
      row.sample_count > 0
        ? Math.round((row.freeze_risk_count / row.sample_count) * 100)
        : 0,
  }));
const mapPinsJson = JSON.stringify(mapPins);

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/freeze-map");
const embedSnippet = `<iframe src="${siteUrl}/embed/freeze-map" title="ThermalTrace freeze-risk map" width="100%" height="420" style="border:0;border-radius:12px" loading="lazy"></iframe>`;
const badgeSnippet = `[![ThermalTrace freeze map](${siteUrl}/badge/freeze-map.svg)](${siteUrl}/freeze-map)`;
const freezeMapFaqs = getMarketingFaqs("freeze-map");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Freeze map", path: "/freeze-map" },
  ]),
  getMarketingFaqSchema(pageUrl, "freeze-map"),
].filter(Boolean) as Record<string, unknown>[];

const optInHref = user
  ? "/dashboard/household#freeze-map"
  : "/register?next=/dashboard/household";
const optInLabel = user ? "Opt in from Household" : "Start free & opt in your city";

function sparkPath(values: number[]): string {
  if (values.length < 2) return "";
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const w = 80;
  const h = 24;
  return values
    .map((v, i) => {
      const x = (i / (values.length - 1)) * w;
      const y = h - ((v - min) / range) * h;
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}

function trendDeltaLabel(values: number[]): string {
  if (values.length < 2) return "No history yet";
  const delta = values[values.length - 1]! - values[0]!;
  if (Math.abs(delta) < 0.3) return "Steady";
  return delta < 0 ? `Cooling ${Math.abs(delta).toFixed(1)}°F` : `Warming ${delta.toFixed(1)}°F`;
}
---
<Layout
  title="Freeze-risk map"
  description="See city-level freeze risk from ThermalTrace probe households, then track your own unheated space for free. Opt-in, anonymized community map."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Community"
      title="Freeze-risk map"
      lede="See whether your metro’s indoor probes are running cold this week, then start tracking your own garage, crawlspace, or shop for free. City averages only; no addresses or device names."
    >
      <a slot="actions" class="btn-primary" href={optInHref}>{optInLabel}</a>
      {!user && (
        <a slot="actions" class="btn-secondary" href="/signin?next=/dashboard/household">Sign in</a>
      )}
      <a slot="actions" class="btn-ghost" href="/embed/freeze-map">Embed</a>
      <a slot="actions" class="btn-ghost" href="/freeze-season">Freeze season</a>
      <a slot="actions" class="btn-ghost" href="/share-kit">Share kit</a>
    </PageHeader>

    {isSeed ? (
      <p class="alert-warning mt-0" role="status">
        <strong>Showing sample data</strong>, live city readings appear once enough households opt in
        ({FREEZE_MAP_SAMPLE_FLOOR}+ probes per city).
        {" "}
        {optInCount === 0
          ? "No households have opted in yet: be the first in your metro."
          : optInCount === 1
            ? "1 household has opted in so far."
            : `${optInCount} households have opted in so far.`}
        {" "}
        <a class="text-link" href={optInHref}>{user ? "Opt in" : "Create an account to contribute"}</a>.
      </p>
    ) : (
      <p class="alert-info mt-0" role="status">
        Live opt-in aggregates · {optInCount} household{optInCount === 1 ? "" : "s"} contributing · cities need {FREEZE_MAP_SAMPLE_FLOOR}+ samples to list by default
        {capturedAt ? (
          <>
            {" · "}Last snapshot {captureAge.label}
            {captureAge.absolute ? ` (${captureAge.absolute})` : ""}
          </>
        ) : null}
        . Opt out anytime under Household.
      </p>
    )}

    {(isSeed || approaching.length > 0) && (
      <section class="card">
        <h2 class="card-title">Momentum</h2>
        <p class="card-subtitle mb-4">
          {approaching.length > 0
            ? `Cities closest to going live (${FREEZE_MAP_SAMPLE_FLOOR} households each). Your opt-in moves the count.`
            : `Once a city reaches ${FREEZE_MAP_SAMPLE_FLOOR} opted-in households with a live probe, sample preview for that metro is replaced by real readings.`}
        </p>
        {approaching.length > 0 ? (
          <ul class="space-y-2 mb-4 text-sm">
            {approaching.map((row) => {
              const needed = FREEZE_MAP_SAMPLE_FLOOR - row.sample_count;
              return (
                <li>
                  <strong>{row.city_label}</strong>
                  {": "}
                  {row.sample_count}/{FREEZE_MAP_SAMPLE_FLOOR} households
                  {needed > 0
                    ? ` · ${needed} more to go live`
                    : ""}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-sm text-[var(--color-text-muted)] mb-4">
            No sparse live cities yet: the next opted-in metros will show up here as they approach the floor.
          </p>
        )}
        <a class="btn-secondary" href={optInHref}>{optInLabel}</a>
      </section>
    )}

    {coldest.length > 0 && (
      <section class="card">
        <h2 class="card-title">Coldest cities</h2>
        <ol class="space-y-2 mb-0 text-sm">
          {coldest.map((row, i) => (
            <li>
              <strong>#{i + 1} {row.city_label}</strong>
              {": "}
              min {row.min_temp_f?.toFixed(1)}°F
              {row.avg_temp_f != null ? ` · avg ${row.avg_temp_f.toFixed(1)}°F` : ""}
              {" · "}
              {row.sample_count} household{row.sample_count === 1 ? "" : "s"}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="card">
      <p class="mb-0 text-sm">
        {showSparse ? (
          <a class="text-link" href="/freeze-map">Hide sparse cities (&lt;{FREEZE_MAP_SAMPLE_FLOOR} households)</a>
        ) : (
          <a class="text-link" href="/freeze-map?sparse=1">
            Show sparse cities{sparseHidden > 0 ? ` (${sparseHidden} hidden)` : ""}
          </a>
        )}
      </p>
    </section>

    {mapPins.length > 0 && (
      <section class="card">
        <h2 class="card-title">Map</h2>
        <p class="card-subtitle mb-4">
          Pin color reflects freeze-risk share (green = low, red = high).
          Toggle OpenWeather temperature or precipitation under the layers control.
        </p>
        <div id="freeze-map-leaflet" class="weather-map-frame freeze-map-frame" style="height:22rem">
          <div class="loading-state freeze-map-loading" id="freeze-map-loading">
            <p class="m-0">Loading map…</p>
          </div>
        </div>
        <link
          rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin=""
        />
        <script is:inline define:vars={{ mapPinsJson }}>
          (() => {
            const pins = JSON.parse(mapPinsJson);
            function init() {
              const el = document.getElementById("freeze-map-leaflet");
              const loading = document.getElementById("freeze-map-loading");
              if (!el || typeof L === "undefined" || pins.length === 0) return;
              if (loading) loading.remove();
              const map = L.map(el).setView([pins[0].lat, pins[0].lon], 4);
              const base = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution:
                  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 18,
                subdomains: "abc",
              }).addTo(map);

              const overlays = {};
              {
                const owmAttr =
                  'Weather &copy; <a href="https://openweathermap.org/">OpenWeather</a>';
                overlays["Temperature"] = L.tileLayer(
                  "/api/weather/tiles/temp_new/{z}/{x}/{y}",
                  { opacity: 0.55, maxZoom: 18, attribution: owmAttr },
                );
                overlays["Precipitation"] = L.tileLayer(
                  "/api/weather/tiles/precipitation_new/{z}/{x}/{y}",
                  { opacity: 0.55, maxZoom: 18, attribution: owmAttr },
                );
                overlays["Temperature"].addTo(map);
                L.control.layers({ Map: base }, overlays, { collapsed: false }).addTo(map);
              }

              for (const pin of pins) {
                const color =
                  pin.riskPct >= 50 ? "#ef4444" : pin.riskPct >= 25 ? "#f59e0b" : "#22c55e";
                const radius = Math.min(24, 6 + Math.sqrt(pin.samples || 1) * 2);
                L.circleMarker([pin.lat, pin.lon], {
                  radius,
                  color,
                  fillColor: color,
                  fillOpacity: 0.55,
                })
                  .bindPopup(
                    `<strong>${pin.label}</strong><br/>Avg ${pin.avg?.toFixed(1) ?? "—"}°F<br/>Risk ${pin.riskPct}% · ${pin.samples} households`,
                  )
                  .addTo(map);
                L.circle([pin.lat, pin.lon], {
                  radius: radius * 8000,
                  color,
                  fillColor: color,
                  fillOpacity: 0.08,
                  weight: 1,
                }).addTo(map);
              }
              if (pins.length > 1) {
                const bounds = L.latLngBounds(pins.map((p) => [p.lat, p.lon]));
                map.fitBounds(bounds, { padding: [24, 24] });
              }
            }
            if (typeof L !== "undefined") {
              init();
            } else {
              const s = document.createElement("script");
              s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
              s.crossOrigin = "";
              s.onload = init;
              document.head.appendChild(s);
            }
          })();
        </script>
      </section>
    )}

    <section class="card">
      {visible.length === 0 ? (
        <p class="mb-0 text-[var(--color-text-muted)]">
          No city samples yet{!showSparse && sparseHidden > 0 ? " that meet the sample floor" : ""}.
          {user
            ? " Be the first to opt in from your household settings."
            : " Create an account and opt in from Household settings to contribute."}
        </p>
      ) : (
        <>
          <div class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>City</th>
                  <th scope="col">Trend <span class="font-normal text-[var(--color-text-muted)]">(avg °F)</span></th>
                  <th>Households</th>
                  <th>Avg °F</th>
                  <th>Min °F</th>
                  <th>
                    Freeze-risk share
                    <span class="block font-normal text-xs text-[var(--color-text-muted)]">% of households ≤34°F</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {visible.map((row) => {
                  const riskPct =
                    row.sample_count > 0
                      ? Math.round((row.freeze_risk_count / row.sample_count) * 100)
                      : 0;
                  const sparse = row.sample_count < FREEZE_MAP_SAMPLE_FLOOR;
                  const spark = sparklines.get(row.city_id) ?? [];
                  const path = sparkPath(spark);
                  const delta = trendDeltaLabel(spark);
                  return (
                    <tr>
                      <td>
                        <strong>{row.city_label}</strong>
                        {sparse && (
                          <span class="block text-xs text-[var(--color-text-muted)]">
                            Sparse
                          </span>
                        )}
                      </td>
                      <td>
                        {path ? (
                          <span class="inline-flex items-center gap-2" title={delta}>
                            <svg width="80" height="24" viewBox="0 0 80 24" aria-hidden="true">
                              <path
                                d={path}
                                fill="none"
                                stroke="var(--color-accent)"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <span class="text-xs text-[var(--color-text-muted)]">{delta}</span>
                          </span>
                        ) : (
                          <span class="text-[var(--color-text-muted)]" title="Needs more snapshots">: </span>
                        )}
                      </td>
                      <td>{row.sample_count}</td>
                      <td>
                        {row.avg_temp_f != null ? row.avg_temp_f.toFixed(1) : "—"}
                      </td>
                      <td>
                        {row.min_temp_f != null ? row.min_temp_f.toFixed(1) : "—"}
                      </td>
                      <td>
                        {riskPct}%
                        <span class="text-[var(--color-text-muted)]">
                          {" "}({row.freeze_risk_count} of {row.sample_count})
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-[var(--color-text-muted)] mt-3 mb-0">
            Households = opted-in homes in that city for this snapshot. Freeze-risk share = households whose coldest probe was ≤34°F at capture.
            Trend is recent city average temperature across hourly snapshots.
          </p>
        </>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Find your city</h2>
      <p class="card-subtitle mb-4">
        Search OpenWeather geocoding to see if your metro is on the map.
        {user
          ? " Household owners opt in under Dashboard → Household."
          : " Sign in to opt your household in."}
      </p>
      <div class="form-field mb-0">
        <label class="form-label" for="freeze-map-search">City search</label>
        <input class="form-input" id="freeze-map-search" type="search" placeholder="Asheville, NC" autocomplete="off" />
      </div>
      <ul id="freeze-map-search-results" class="space-y-2 text-sm mt-3 mb-0"></ul>
    </section>

    <section class="card" id="embed">
      <h2 class="card-title">Embed &amp; badge</h2>
      <p class="card-subtitle mb-4">
        Drop the map on a blog, Home Assistant dashboard, or README. Compact embed:
        <a class="text-link" href="/embed/freeze-map?compact=1">/embed/freeze-map?compact=1</a>.
      </p>
      <div class="form-field">
        <label class="form-label" for="freeze-embed-code">iframe</label>
        <textarea class="form-textarea font-mono text-xs" id="freeze-embed-code" rows="3" readonly>{embedSnippet}</textarea>
        <button type="button" class="btn-secondary mt-2" data-copy-target="freeze-embed-code">Copy embed</button>
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="freeze-badge-code">Markdown badge</label>
        <textarea class="form-textarea font-mono text-xs" id="freeze-badge-code" rows="2" readonly>{badgeSnippet}</textarea>
        <button type="button" class="btn-secondary mt-2" data-copy-target="freeze-badge-code">Copy badge</button>
      </div>
    </section>

    <FaqSection
      faqs={freezeMapFaqs}
      lede="How the public map works and what stays private."
    />
  </div>
</Layout>

<script is:inline>
  (() => {
    const input = document.getElementById("freeze-map-search");
    const results = document.getElementById("freeze-map-search-results");
    if (!(input instanceof HTMLInputElement) || !results) return;

    let timer = null;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) {
        results.innerHTML = "";
        return;
      }
      timer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/weather/city-search?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          const rows = Array.isArray(data.results) ? data.results : [];
          results.innerHTML = rows
            .slice(0, 6)
            .map((row) => {
              const lat = row.lat?.toFixed?.(2) ?? "?";
              const lon = row.lon?.toFixed?.(2) ?? "?";
              const label = String(row.label ?? "").replace(/</g, "&lt;");
              return `<li><strong>${label}</strong> · ${lat}, ${lon}</li>`;
            })
            .join("");
        } catch {
          results.innerHTML = "<li>Search failed.</li>";
        }
      }, 300);
    });

    document.querySelectorAll("[data-copy-target]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-copy-target");
        const el = id ? document.getElementById(id) : null;
        if (!(el instanceof HTMLTextAreaElement) || !(btn instanceof HTMLButtonElement)) return;
        try {
          await navigator.clipboard.writeText(el.value);
          const prev = btn.textContent;
          btn.textContent = "Copied!";
          setTimeout(() => {
            btn.textContent = prev;
          }, 1800);
        } catch {
          btn.textContent = "Copy failed";
        }
      });
    });
  })();
</script>
