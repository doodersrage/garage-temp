---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import { BAYBUDDY_NAME } from "../lib/bayBuddy";
import {
  CLAIM_PUCK_BAY_BUDDY_NOTE,
  CLAIM_PUCK_NAME,
  CLAIM_PUCK_REPO_URL,
  CLAIM_PUCK_TAGLINE,
} from "../lib/claimPuck";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/claim-puck");
const faqs = getMarketingFaqs("claimPuck");

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: CLAIM_PUCK_NAME, path: "/claim-puck" },
  ]),
  getMarketingFaqSchema(pageUrl, "claimPuck"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={CLAIM_PUCK_NAME}
  description={CLAIM_PUCK_TAGLINE}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Hardware accessory"
      title={CLAIM_PUCK_NAME}
      lede={`A Waveshare RP2040-Zero that proves you are present when claiming a bay, then lights Bay Buddy moods (cozy, drafty, shiver, panic, offline, hero). Probes, alerts, and history stay on ${BRAND_NAME}.`}
    >
      <a slot="actions" class="btn-primary" href="/bay-buddy">
        Get {BAYBUDDY_NAME}
      </a>
      <a slot="actions" class="btn-secondary" href={CLAIM_PUCK_REPO_URL} target="_blank" rel="noreferrer">
        Firmware on GitHub
      </a>
      <a slot="actions" class="btn-ghost" href="/docs/api#claim-puck">
        HTTP claim API
      </a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">What it is</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li>
          <strong>Does:</strong> HMAC challenge–response over USB (press GP4 to confirm),
          binds the puck to a bay, then shows live freeze/flood mood on the onboard LED.
        </li>
        <li>
          <strong>Does not:</strong> replace probes, Overview, Alerts, or the insurance claims pack.
          It is a presence key and mood light for a bay you already monitor.
        </li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Setup</h2>
      <p class="card-subtitle mb-4">{CLAIM_PUCK_BAY_BUDDY_NOTE}</p>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li>
          Flash
          <a class="text-link" href={CLAIM_PUCK_REPO_URL} target="_blank" rel="noreferrer">claim-puck CircuitPython</a>
          onto an RP2040-Zero. Wire a momentary button from <strong>GP4</strong> to GND.
        </li>
        <li>
          Connect at least one probe (or demo feed) on
          <a class="text-link" href="/dashboard/temperature">Devices</a>
          so the bay has readings. Give devices a matching <code>space</code> label (e.g. garage).
        </li>
        <li>
          Install
          <a class="text-link" href="/bay-buddy">{BAYBUDDY_NAME}</a>,
          sign in, plug in the puck, then use <strong>Claim this bay</strong> and press the button when the LED turns yellow.
        </li>
        <li>
          Optionally <strong>Drive puck mood</strong> so the LED follows
          <code>GET /api/bays/&lt;bay&gt;/mood</code>.
        </li>
      </ol>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/bay-buddy">Open Bay Buddy page</a>
        <a class="btn-secondary" href="/docs/api#claim-puck">Claim API reference</a>
        <a class="btn-ghost" href="/claim-puck-case">Case / diffuser</a>
        <a class="btn-ghost" href="/accessories">All accessories</a>
      </div>
    </section>

    <FaqSection
      title="Claim puck FAQ"
      faqs={faqs}
      lede="Hardware presence key answers: what it needs, how claim works, and how it relates to Bay Buddy."
    />
  </div>
</Layout>
