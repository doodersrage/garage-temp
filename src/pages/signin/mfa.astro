---
import Layout from "../../layouts/Layout.astro";
import MfaSignInChallenge from "../../components/MfaSignInChallenge";
import { getAuthFromCookies } from "../../lib/auth";
import {
  sessionNeedsMfaStepUp,
  setMfaRequiredCookie,
} from "../../lib/mfa";
import { sanitizeNextPath } from "../../lib/siteUrl";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const needsStepUp = await sessionNeedsMfaStepUp(
  session.access_token,
  session.refresh_token,
);

if (!needsStepUp) {
  setMfaRequiredCookie(Astro.cookies, false);
  const next = sanitizeNextPath(Astro.url.searchParams.get("next")) ?? "/dashboard";
  return Astro.redirect(next);
}

setMfaRequiredCookie(Astro.cookies, true);

const errorCode = Astro.url.searchParams.get("error");
const errorMessage =
  errorCode === "invalid_code"
    ? "That code was incorrect or expired. Enter a fresh code from your authenticator app."
    : errorCode === "no_factor"
      ? "No MFA factor is enrolled on this account. Sign in again and add one under Settings."
      : errorCode === "rate_limited"
        ? "Too many incorrect attempts. Please wait a few minutes and try again."
        : errorCode === "generic"
          ? "Something went wrong verifying your code. Try again."
          : null;

const safeNext =
  sanitizeNextPath(Astro.url.searchParams.get("next")) ?? "/dashboard";
---
<Layout
  title="Authenticator code"
  description="Enter the 6-digit code from your authenticator app to finish signing in."
  noindex
>
  <div class="auth-page">
    <MfaSignInChallenge
      client:load
      safeNext={safeNext}
      userEmail={user.email ?? "your account"}
      initialError={errorMessage}
    />
  </div>
</Layout>
