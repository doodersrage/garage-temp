        behavior: "smooth",
        block: "start",
      });
    })();
  </script>
)}

{(neverSeenWithSensors || waitingPushNoSensors.length > 0) && (
  <script is:inline>
    (() => {
      const root = document.querySelector("[data-waiting-ingest]");
      if (!(root instanceof HTMLElement)) return;

      const statusEl = root.querySelector("[data-waiting-status]");
      const metaEl = root.querySelector("[data-waiting-meta]");
      const stepEl = root.querySelector('[data-waiting-step="post"]');
      const refreshBtn = root.querySelector("[data-waiting-refresh]");
      let timer = 0;
      let inFlight = false;

      async function checkOnce() {
        if (inFlight) return;
        inFlight = true;
        try {
          const response = await fetch("/api/devices/ingest-status", {
            credentials: "same-origin",
            headers: { Accept: "application/json" },
          });
          if (!response.ok) throw new Error("status " + response.status);
          const payload = await response.json();
          const checked = payload.checkedAt
            ? new Date(payload.checkedAt).toLocaleTimeString()
            : new Date().toLocaleTimeString();
          if (metaEl) {
            metaEl.textContent = payload.waiting
              ? `Still waiting — last check ${checked}. Auto-checking every 5 seconds.`
              : `Last check ${checked}.`;
          }
          if (!payload.waiting && (payload.seenCount > 0 || payload.latestCount > 0)) {
            if (statusEl) statusEl.textContent = " — received!";
            if (stepEl) {
              stepEl.classList.remove("waiting-ingest-pending");
              stepEl.classList.add("waiting-ingest-done");
            }
            const url = new URL(window.location.href);
            url.searchParams.set("ingest_ok", "1");
            url.searchParams.set("rename_sensors", "1");
            url.searchParams.delete("sensor_added");
            window.location.replace(url.pathname + "?" + url.searchParams.toString());
            return;
          }
          if (statusEl) statusEl.textContent = " — listening…";
        } catch {
          if (metaEl) metaEl.textContent = "Could not check status — try Check now.";
        } finally {
          inFlight = false;
        }
      }

      refreshBtn?.addEventListener("click", () => {
        void checkOnce();
      });

      void checkOnce();
      timer = window.setInterval(() => {
        void checkOnce();
      }, 5000);

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          window.clearInterval(timer);
          timer = 0;
        } else if (!timer) {
          void checkOnce();
          timer = window.setInterval(() => {
            void checkOnce();
          }, 5000);
        }
      });
    })();
  </script>
)}

