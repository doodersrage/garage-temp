---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import TempFeedsSettings from "../../components/TempFeedsSettings.astro";
import TempProbesSettings from "../../components/TempProbesSettings.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getUserPreferences } from "../../lib/userPreferences";
import { checkFeedHealth } from "../../lib/collectHistory";
import { getUserDevicesAsTempConfig, listHouseholdDevices, SENSOR_KIND_LABELS, formatBoolSensorValue } from "../../lib/devices";
import { getOrCreateHouseholdForUser, listUserHouseholds, getUserHouseholdRole, canEditHousehold } from "../../lib/households";
import { getUserEntitlements } from "../../lib/entitlements";
import { fetchLatestSensorValues } from "../../lib/sensorReadings";
import { formatRelativeAge, freshnessDetail } from "../../lib/relativeTime";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import { batterySparklinePath, parseBatteryHistory } from "../../lib/batterySparkline";
import { renderIngestQrSvg } from "../../lib/qrSvg";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const [preferences, feedHealth, deviceConfig, entitlements, household, userHouseholds] = await Promise.all([
  getUserPreferences(user),
  checkFeedHealth(user.id),
  getUserDevicesAsTempConfig(user.id, user.email),
  getUserEntitlements(user.id),
  getOrCreateHouseholdForUser(user.id, user.email),
  listUserHouseholds(user.id),
]);

const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);
const transferTargets = userHouseholds.households.filter(
  (h) => h.household_id !== household.householdId,
);

const devices = household.householdId
  ? (await listHouseholdDevices(household.householdId)).devices
  : deviceConfig.devices;

const latest = household.householdId
  ? await fetchLatestSensorValues(household.householdId)
  : [];

const redirectTo = "/dashboard/temperature";
const ingestKey = Astro.url.searchParams.get("ingest_key");
const focusDevice = Astro.url.searchParams.get("focus_device") ?? "";
const atDeviceLimit =
  devices.filter((d) => d.source === "push").length >= entitlements.maxDevices;

const noticeParam = Astro.url.searchParams.get("error");
const deviceNotice =
  Astro.url.searchParams.get("device_deleted")
    ? "Device deleted."
    : Astro.url.searchParams.get("device_renamed")
      ? "Device renamed."
      : Astro.url.searchParams.get("sensor_added")
      ? "Sensor added."
      : Astro.url.searchParams.get("sensor_updated")
        ? "Sensor updated."
        : Astro.url.searchParams.get("sensor_deleted")
          ? "Sensor deleted."
          : Astro.url.searchParams.get("feeds_saved")
            ? "Feed URLs saved."
            : Astro.url.searchParams.get("probes_saved")
              ? "Probe labels saved."
              : Astro.url.searchParams.get("feed_deleted")
                ? "Feed deleted."
                : Astro.url.searchParams.get("probe_deleted")
                  ? "Probe deleted."
                  : Astro.url.searchParams.get("feeds_error") ||
                      Astro.url.searchParams.get("probes_error")
                    ? "Could not save changes. Please try again."
                    : noticeParam === "device_limit"
                      ? `Push device limit reached (${entitlements.maxDevices}). Upgrade to add more.`
                      : noticeParam === "viewer"
                        ? "View-only access — you cannot change devices or feeds."
                      : noticeParam === "1" || noticeParam === "true"
                        ? "Could not complete that device action. Check the form and try again."
                        : noticeParam
                          ? `Could not complete that action (${noticeParam}). Please try again.`
                          : null;

const noticeIsError =
  Astro.url.searchParams.has("error") ||
  Boolean(Astro.url.searchParams.get("feeds_error")) ||
  Boolean(Astro.url.searchParams.get("probes_error"));

const keyCalloutTitle = Astro.url.searchParams.get("key_rotated")
  ? "Save your new ingest key"
  : "Save your ingest key";
const showAddSensorNudge =
  Boolean(Astro.url.searchParams.get("device_created")) && Boolean(focusDevice);

const pushDevices = devices.filter((d) => d.source === "push");
const neverSeenWithSensors = pushDevices.some(
  (d) => !d.last_seen_at && d.sensors.length > 0,
);
const showVerifyIngest =
  Boolean(Astro.url.searchParams.get("sensor_added")) || neverSeenWithSensors;
const showReceivingData =
  !showAddSensorNudge &&
  pushDevices.some((d) => Boolean(d.last_seen_at)) &&
  latest.length > 0 &&
  !neverSeenWithSensors;
const kindLabels = SENSOR_KIND_LABELS;

function formatLatestValue(row: (typeof latest)[number]): string {
  if (row.value_bool != null) {
    return formatBoolSensorValue(row.sensor.kind, row.value_bool);
  }
  if (row.value_num != null) {
    return `${row.value_num.toFixed(1)}${row.sensor.unit ? ` ${row.sensor.unit}` : ""}`;
  }
  return row.value_text ?? "—";
}

function readDeviceMetaNumber(meta: unknown, key: string): number | null {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return null;
  const value = (meta as Record<string, unknown>)[key];
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}

function formatDeviceBattery(meta: unknown): string {
  const battery = readDeviceMetaNumber(meta, "battery_pct");
  return battery == null ? "—" : `${battery}%`;
}

function formatDeviceRssi(meta: unknown): string {
  const rssi = readDeviceMetaNumber(meta, "rssi");
  return rssi == null ? "—" : `${rssi} dBm`;
}

const ingestCurlExample = ingestKey
  ? `curl -X POST "${Astro.url.origin}/api/ingest/${ingestKey}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"door1": true, "temp1": 42.5}'`
  : "";
const ingestUrl = ingestKey
  ? `${Astro.url.origin}/api/ingest/${ingestKey}`
  : "";
const ingestQrSvg = ingestUrl ? renderIngestQrSvg(ingestUrl, 180) : "";
const ingestKeyDeviceName =
  (focusDevice && devices.find((d) => d.id === focusDevice)?.name) ||
  pushDevices[0]?.name ||
  "Push device";
---
<DashboardLayout title="Devices">
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Devices & sensors</h2>
      <p class="card-subtitle">
        Connect hardware that <strong>pushes</strong> readings to this site, or configure HTTPS JSON feeds that we
        <strong>pull</strong> on a schedule.
      </p>
      {deviceNotice && (
        <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0"]}>
          {deviceNotice}
          {noticeParam === "device_limit" && (
            <>
              {" "}
              <a class="text-link" href="/dashboard#plans">View plans</a>
            </>
          )}
        </p>
      )}
    </section>

    {(noticeParam === "device_limit" || atDeviceLimit) && (
      <UpgradeNudge feature="device_limit" tier={entitlements.tier} />
    )}

    {showAddSensorNudge && (
      <section class="card alert-success" id="next-sensor-step">
        <h2 class="card-title">Next: add a sensor</h2>
        <p class="mb-4">
          Your push device is ready. Add at least one sensor key so readings show up on Home.
        </p>
        <a class="btn-primary" href="#add-sensor">Add a sensor</a>
      </section>
    )}

    {showReceivingData && (
      <section class="card alert-success" id="receiving-data">
        <h2 class="card-title">Receiving data</h2>
        <p class="mb-4">
          Ingest looks healthy — readings are showing up. Confirm freeze alerts reach you next.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/dashboard/alerts#send-test-alert">Send a test alert</a>
          <a class="btn-secondary" href="/">Open Home</a>
          <a class="btn-ghost" href="/dashboard">Overview</a>
        </div>
      </section>
    )}

    <section class="card" id="device-health">
      <h2 class="card-title">Device health</h2>
      <p class="card-subtitle mb-4">
        Last seen, staleness, and optional battery/RSSI from ingest payloads.
      </p>
      {devices.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">No devices yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">Device</th>
                <th class="py-2 pr-3">Space</th>
                <th class="py-2 pr-3">Source</th>
                <th class="py-2 pr-3">Last seen</th>
                <th class="py-2 pr-3">Sensors</th>
                <th class="py-2 pr-3">Battery</th>
                <th class="py-2">RSSI</th>
              </tr>
            </thead>
            <tbody>
              {devices.map((device) => {
                const age = formatRelativeAge(device.last_seen_at);
                const battery = formatDeviceBattery(device.meta);
                const rssi = formatDeviceRssi(device.meta);
                const sparkPath = batterySparklinePath(parseBatteryHistory(device.meta));
                const pullHealth = feedHealth.statuses.find((f) => f.feedId === device.id);
                return (
                  <tr class="border-t border-[var(--color-border)]">
                    <td class="py-2 pr-3">
                      <strong>{device.name}</strong>
                      {device.ingest_key_prefix && (
                        <span class="block text-xs text-[var(--color-text-muted)]">
                          key {device.ingest_key_prefix}…
                        </span>
                      )}
                    </td>
                    <td class="py-2 pr-3">{device.space || "—"}</td>
                    <td class="py-2 pr-3">
                      {device.source === "push" ? "Push" : "Pull"}
                      {pullHealth && (
                        <span class="block text-xs text-[var(--color-text-muted)]">
                          {pullHealth.ok ? "Reachable" : pullHealth.message}
                        </span>
                      )}
                    </td>
                    <td class:list={["py-2 pr-3", age.lagging && "text-[var(--color-danger)]"]}>
                      {device.last_seen_at ? freshnessDetail(age) : age.label}
                    </td>
                    <td class="py-2 pr-3">{device.sensors.length}</td>
                    <td class="py-2 pr-3">
                      {battery}
                      {sparkPath && (
                        <svg
                          class="block mt-1 text-[var(--color-accent)]"
                          width="64"
                          height="20"
                          viewBox="0 0 64 20"
                          aria-hidden="true"
                        >
                          <path d={sparkPath} fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                      )}
                    </td>
                    <td class="py-2">{rssi}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {showVerifyIngest && !ingestKey && (
      <section class="card ingest-key-callout" id="verify-ingest-step">
        <h2 class="card-title">Next: verify ingest</h2>
        <p class="mb-4">
          Sensors are configured. Point your firmware at the ingest URL and POST sample JSON, then open Home to confirm live values.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/">Open Home</a>
          <a class="btn-secondary" href="/about/ingest-and-webhooks">Ingest docs</a>
          <a class="btn-ghost" href="#push-devices">Review devices</a>
        </div>
      </section>
    )}

    {ingestKey && (
      <section class="card ingest-key-callout" id="ingest-key-callout">
        <h2 class="card-title">{keyCalloutTitle}</h2>
        <p class="card-subtitle">
          This key is shown once. Copy it into your ESP/Arduino firmware now — you will not see the full key again.
          The QR below is generated on this page (no third-party QR service).
        </p>
        <div class="flex flex-wrap gap-6 items-start mb-4">
          <div
            class="ingest-key-qr shrink-0 rounded-lg bg-white p-2"
            id="ingest-key-qr"
            aria-label="Ingest URL QR code"
            set:html={ingestQrSvg}
          />
          <div class="min-w-0 flex-1">
            <p class="form-label mb-1">Ingest URL</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-2" id="ingest-url-value">{ingestUrl}</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-0" id="ingest-key-value">{ingestKey}</p>
            <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">
              POST JSON to <code>/api/ingest/{ingestKey}</code>
            </p>
          </div>
        </div>
        <pre class="ingest-key-curl text-xs overflow-x-auto mb-4"><code>{ingestCurlExample}</code></pre>
        <div class="flex flex-wrap gap-3">
          <button
            type="button"
            class="btn-primary"
            data-copy={ingestKey}
            data-copy-label="Copy key"
          >
            Copy key
          </button>
          <button
            type="button"
            class="btn-secondary"
            data-copy={ingestUrl}
            data-copy-label="Copy URL"
          >
            Copy URL
          </button>
          <a
            class="btn-secondary"
            id="ingest-qr-download"
            href="#"
            download="thermaltrace-ingest-qr.svg"
          >
            Download SVG
          </a>
          <button type="button" class="btn-secondary" id="ingest-qr-print">
            Print label
          </button>
          <button type="button" class="btn-ghost" id="ingest-key-dismiss">
            I've saved this
          </button>
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="card">
        <h2 class="card-title">Latest sensor values</h2>
        <div class="feed-health-grid">
          {latest.map((row) => {
            const age = formatRelativeAge(row.recorded_at);
            return (
              <div class="feed-health-item">
                <div>
                  <strong>{row.sensor.label}</strong>
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    {row.deviceName} · {kindLabels[row.sensor.kind] ?? row.sensor.kind}
                  </p>
                  <p class:list={["m-0 mt-1 text-sm", age.lagging && "text-amber-300"]}>
                    {freshnessDetail(age)}
                  </p>
                </div>
                <span>{formatLatestValue(row)}</span>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {feedHealth.statuses.length > 0 && (
      <section class="card">
        <h2 class="card-title">Feed health</h2>
        <p class="card-subtitle">Latest status check for your enabled pull feeds.</p>
        <div class="feed-health-grid">
          {feedHealth.statuses.map((status) => (
            <div class="feed-health-item">
              <div>
                <strong>{status.feedName}</strong>
                <p class="m-0 text-sm text-[var(--color-text-muted)]">{status.message}</p>
              </div>
              <span class={status.ok ? "feed-health-ok" : "feed-health-error"}>
                {status.ok ? "Online" : "Issue"}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="card" id="push-devices">
      <h2 class="card-title">Push from ESP / Arduino</h2>
      <p class="card-subtitle">
        Your device POSTs readings to an ingest URL. Limit: {entitlements.maxDevices} devices ({entitlements.tier}).
        See <a class="text-link" href="/about/ingest-and-webhooks">ingest docs</a>.
      </p>

      {atDeviceLimit ? (
        <div class="alert-warning mb-4">
          <p class="m-0">
            You are at your push device limit.
            <a class="text-link" href="/dashboard#plans">Upgrade your plan</a> to add more, or delete a device below.
          </p>
        </div>
      ) : canEdit ? (
        <form action="/api/devices" method="post" class="space-y-3">
          <input type="hidden" name="action" value="create_push" />
          <input type="hidden" name="redirect" value={redirectTo} />
          <div class="form-field">
            <label class="form-label" for="device-name">Device name</label>
            <input class="form-input" id="device-name" name="name" placeholder="Garage ESP32" />
          </div>
          <button class="btn-primary" type="submit">Create push device</button>
        </form>
      ) : (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          View-only access — device creation is disabled.
        </p>
      )}

      {pushDevices.length > 0 && (
        <ul class="mt-6 space-y-6">
          {pushDevices.map((device) => {
            const seen = formatRelativeAge(device.last_seen_at, "never seen");
            return (
            <li class="rounded-xl border border-[var(--color-border)] p-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <strong>{device.name}</strong>
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    key prefix {device.ingest_key_prefix}…
                    {" · "}
                    <span class={seen.lagging ? "text-amber-300" : ""} title={seen.absolute ?? undefined}>
                      {seen.label === "never seen"
                        ? "never seen"
                        : freshnessDetail(seen)}
                    </span>
                  </p>
                  {seen.label === "never seen" && (
                    <p class="m-0 mt-1 text-sm text-[var(--color-text-muted)]">
                      No POSTs yet — check firmware and ingest key.
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap gap-2">
                  <form method="POST" class="flex flex-wrap items-end gap-2" data-device-rename-form>
                    <input type="hidden" name="action" value="rename" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <div class="form-field mb-0">
                      <label class="form-label" for={`rename-${device.id}`}>Name</label>
                      <input
                        class="form-input"
                        id={`rename-${device.id}`}
                        name="name"
                        value={device.name}
                        required
                      />
                    </div>
                    <button class="btn-secondary" type="submit">Rename</button>
                    <p class="m-0 text-sm text-[var(--color-success)] hidden" data-device-status></p>
                    <p class="m-0 text-sm text-[var(--color-danger)] hidden" data-device-error></p>
                  </form>
                  <form method="POST" class="flex flex-wrap items-end gap-2" data-device-space-form>
                    <input type="hidden" name="action" value="set_space" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <div class="form-field mb-0">
                      <label class="form-label" for={`space-${device.id}`}>Space</label>
                      <input
                        class="form-input"
                        id={`space-${device.id}`}
                        name="space"
                        value={device.space ?? ""}
                        placeholder="garage, attic…"
                        list="space-suggestions"
                      />
                    </div>
                    <button class="btn-secondary" type="submit">Save space</button>
                    <p class="m-0 text-sm text-[var(--color-success)] hidden" data-device-status></p>
                    <p class="m-0 text-sm text-[var(--color-danger)] hidden" data-device-error></p>
                  </form>
                  <form action="/api/devices" method="post" onsubmit="return confirm('Rotate this ingest key? The old key stops working immediately.');">
                    <input type="hidden" name="action" value="rotate_key" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-secondary" type="submit">Rotate key</button>
                  </form>
                  {canEdit && transferTargets.length > 0 && (
                    <form action="/api/devices" method="post" class="flex flex-wrap gap-2 items-end">
                      <input type="hidden" name="action" value="transfer" />
                      <input type="hidden" name="device_id" value={device.id} />
                      <input type="hidden" name="redirect" value={redirectTo} />
                      <div class="form-field mb-0">
                        <label class="form-label" for={`transfer-${device.id}`}>Move to</label>
                        <select class="form-input" id={`transfer-${device.id}`} name="target_household_id" required>
                          {transferTargets.map((h) => (
                            <option value={h.household_id}>{h.name ?? h.household_id}</option>
                          ))}
                        </select>
                      </div>
                      <button class="btn-secondary" type="submit">Transfer device</button>
                    </form>
                  )}
                  {canEdit && (
                  <form action="/api/devices" method="post" onsubmit="return confirm('Delete this push device and its sensors?');">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="device_id" value={device.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">Delete</button>
                  </form>
                  )}
                </div>
              </div>

              {device.sensors.length === 0 ? (
                <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
                  No sensors yet. Add a temp + humidity pair or a single key below so readings appear on Home.
                </p>
              ) : (
                <ul class="mt-4 space-y-2">
                  {device.sensors.map((sensor) => (
                    <li class="sensor-map-row">
                      <form action="/api/devices" method="post" class="sensor-map-form">
                        <input type="hidden" name="action" value="update_sensor" />
                        <input type="hidden" name="sensor_id" value={sensor.id} />
                        <input type="hidden" name="device_id" value={device.id} />
                        <input type="hidden" name="redirect" value={redirectTo} />
                        <div class="sensor-map-primary">
                          <div class="form-field mb-0">
                            <label class="form-label" for={`key-${sensor.id}`}>JSON key</label>
                            <input
                              class="form-input font-mono"
                              id={`key-${sensor.id}`}
                              name="key"
                              value={sensor.key}
                              required
                              placeholder="temp1"
                            />
                          </div>
                          <div class="form-field mb-0">
                            <label class="form-label" for={`label-${sensor.id}`}>Name on Home</label>
                            <input
                              class="form-input"
                              id={`label-${sensor.id}`}
                              name="label"
                              value={sensor.label}
                              required
                              placeholder="Garage"
                            />
                          </div>
                          <div class="form-field mb-0">
                            <label class="form-label" for={`kind-${sensor.id}`}>Type</label>
                            <select class="form-input" id={`kind-${sensor.id}`} name="kind">
                              {Object.entries(kindLabels).map(([value, label]) => (
                                <option value={value} selected={sensor.kind === value}>{label}</option>
                              ))}
                            </select>
                          </div>
                          <div class="sensor-map-actions">
                            <button class="btn-secondary" type="submit">Save</button>
                          </div>
                        </div>
                        <details class="sensor-map-advanced mt-2">
                          <summary class="text-sm text-[var(--color-text-muted)] cursor-pointer">
                            Advanced
                            {(sensor.offset_num ?? 0) !== 0
                              ? ` · offset ${(sensor.offset_num ?? 0) > 0 ? "+" : ""}${sensor.offset_num ?? 0}`
                              : ""}
                            {sensor.unit ? ` · ${sensor.unit}` : ""}
                          </summary>
                          <div class="sensor-map-advanced-grid mt-3">
                            <div class="form-field mb-0">
                              <label class="form-label" for={`unit-${sensor.id}`}>Unit override</label>
                              <input
                                class="form-input"
                                id={`unit-${sensor.id}`}
                                name="unit"
                                value={sensor.unit ?? ""}
                                placeholder="Leave blank for type default"
                              />
                            </div>
                            <div class="form-field mb-0">
                              <label class="form-label" for={`offset-${sensor.id}`}>
                                Calibration offset
                              </label>
                              <input
                                class="form-input"
                                id={`offset-${sensor.id}`}
                                name="offset_num"
                                type="number"
                                step="0.1"
                                min={sensor.kind === "humidity" ? -15 : -10}
                                max={sensor.kind === "humidity" ? 15 : 10}
                                value={sensor.offset_num ?? 0}
                              />
                              <p class="form-hint mb-0">
                                {sensor.kind === "humidity"
                                  ? "Added to %RH (±15)."
                                  : sensor.kind === "temperature"
                                    ? "Added to °F (±10)."
                                    : "Added to numeric readings (±10)."}
                                {" "}Raw readings stay unchanged.
                              </p>
                            </div>
                          </div>
                        </details>
                      </form>
                      <form
                        action="/api/devices"
                        method="post"
                        class="sensor-map-delete"
                        onsubmit="return confirm('Delete this sensor?');"
                      >
                        <input type="hidden" name="action" value="delete_sensor" />
                        <input type="hidden" name="sensor_id" value={sensor.id} />
                        <input type="hidden" name="device_id" value={device.id} />
                        <input type="hidden" name="redirect" value={redirectTo} />
                        <button class="btn-ghost" type="submit">Delete</button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
            </li>
            );
          })}
        </ul>
      )}

      {pushDevices.length > 0 && (
        <div class="mt-6 space-y-4 border-t border-[var(--color-border)] pt-4" id="add-sensor">
          <div>
            <h3 class="text-base font-semibold m-0">Map a JSON key</h3>
            <p class="card-subtitle mb-0 mt-1">
              Match a key from your firmware payload to a name and type. Units are filled in from the type unless you override under Advanced on each sensor.
            </p>
          </div>

          <form action="/api/devices" method="post" class="sensor-quick-pair rounded-lg border border-[var(--color-border)] p-4">
            <input type="hidden" name="action" value="add_sensor_pair" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <p class="m-0 mb-3 text-sm font-medium">Quick add: temperature + humidity pair</p>
            <p class="card-subtitle mt-0 mb-3">
              Same JSON key for both (e.g. <code>0</code> or <code>temp1</code>) — the usual DHT-style probe.
            </p>
            <div class="sensor-map-primary">
              <div class="form-field mb-0">
                <label class="form-label" for="pair-device">Device</label>
                <select class="form-input" id="pair-device" name="device_id">
                  {pushDevices.map((d) => (
                    <option value={d.id} selected={focusDevice === d.id}>{d.name}</option>
                  ))}
                </select>
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="pair-key">JSON key</label>
                <input class="form-input font-mono" id="pair-key" name="key" required placeholder="0" />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="pair-label">Name on Home</label>
                <input class="form-input" id="pair-label" name="label" placeholder="Garage" value="Garage" />
              </div>
              <div class="sensor-map-actions">
                <button class="btn-primary" type="submit">Add pair</button>
              </div>
            </div>
          </form>

          <form action="/api/devices" method="post" class="space-y-3">
            <p class="m-0 text-sm font-medium">Or add one sensor</p>
            <input type="hidden" name="action" value="add_sensor" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <div class="sensor-map-primary">
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-device">Device</label>
                <select class="form-input" id="sensor-device" name="device_id">
                  {pushDevices.map((d) => (
                    <option value={d.id} selected={focusDevice === d.id}>{d.name}</option>
                  ))}
                </select>
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-key">JSON key</label>
                <input class="form-input font-mono" id="sensor-key" name="key" required placeholder="door1" />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-label">Name on Home</label>
                <input class="form-input" id="sensor-label" name="label" required placeholder="Garage door" />
              </div>
              <div class="form-field mb-0">
                <label class="form-label" for="sensor-kind">Type</label>
                <select class="form-input" id="sensor-kind" name="kind">
                  {Object.entries(kindLabels).map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
              </div>
              <div class="sensor-map-actions">
                <button class="btn-secondary" type="submit">Add sensor</button>
              </div>
            </div>
          </form>
        </div>
      )}
    </section>

    <section class="card" id="pull-feeds">
      <h2 class="card-title">Pull JSON feeds</h2>
      <p class="card-subtitle mb-0">
        Optional alternative to push ingest: we fetch HTTPS JSON on a schedule.
        Prefer <a class="text-link" href="#push-devices">Devices</a> above for new ESP setups.
      </p>
    </section>

    {canEdit ? (
      <details class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4">
        <summary class="cursor-pointer">
          <span class="card-title text-base">Edit pull feeds</span>
          <p class="card-subtitle mb-0 mt-2">
            URLs, JSON root key, and probe labels for HTTPS pull sources.
          </p>
        </summary>
        <div class="mt-4 space-y-8">
          <TempFeedsSettings feeds={preferences.tempFeeds} redirectTo={redirectTo} />
          <TempProbesSettings
            feeds={preferences.tempFeeds}
            probes={preferences.tempProbes}
            redirectTo={redirectTo}
          />
        </div>
      </details>
    ) : (
      <section class="card">
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          View-only access — feed and probe settings are hidden.
        </p>
      </section>
    )}
  </div>
  <datalist id="space-suggestions">
    <option value="garage" />
    <option value="attic" />
    <option value="greenhouse" />
    <option value="workshop" />
    <option value="basement" />
  </datalist>
</DashboardLayout>

{ingestKey && (
  <script is:inline define:vars={{ ingestQrSvg, ingestUrl, ingestKeyDeviceName }}>
    (() => {
      const dismiss = document.getElementById("ingest-key-dismiss");
      dismiss?.addEventListener("click", () => {
        const url = new URL(window.location.href);
        url.searchParams.delete("ingest_key");
        url.searchParams.delete("device_created");
        url.searchParams.delete("key_rotated");
        window.history.replaceState({}, "", url.pathname + (url.search || ""));
        document.getElementById("ingest-key-callout")?.remove();
      });

      const download = document.getElementById("ingest-qr-download");
      download?.addEventListener("click", (event) => {
        event.preventDefault();
        const blob = new Blob([ingestQrSvg], { type: "image/svg+xml;charset=utf-8" });
        const href = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = href;
        a.download = "thermaltrace-ingest-qr.svg";
        a.click();
        URL.revokeObjectURL(href);
      });

      document.getElementById("ingest-qr-print")?.addEventListener("click", () => {
        const w = window.open("", "_blank", "noopener,noreferrer,width=480,height=640");
        if (!w) return;
        w.document.write(`<!doctype html><html><head><title>Ingest label</title>
          <style>
            body { font-family: system-ui, sans-serif; padding: 1.5rem; text-align: center; }
            h1 { font-size: 1.1rem; margin: 0 0 1rem; }
            .qr { display: inline-block; margin: 0 auto 1rem; }
            .url { font-family: ui-monospace, monospace; font-size: 0.75rem; word-break: break-all; }
          </style></head><body>
          <h1>${String(ingestKeyDeviceName).replace(/</g, "&lt;")}</h1>
          <div class="qr">${ingestQrSvg}</div>
          <p class="url">${String(ingestUrl).replace(/</g, "&lt;")}</p>
          <script>window.onload=()=>{window.print();};<\/script>
          </body></html>`);
        w.document.close();
      });

      document.getElementById("ingest-key-callout")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    })();
  </script>
)}

{!ingestKey && Astro.url.searchParams.get("sensor_added") && (
  <script is:inline>
    (() => {
      document.getElementById("verify-ingest-step")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    })();
  </script>
)}

<script>
  import { actions } from "astro:actions";

  async function handleDeviceForm(
    form: HTMLFormElement,
    run: (formData: FormData) => Promise<{ data?: { message?: string } | null; error?: { message?: string } | null }>,
  ) {
    const statusEl = form.querySelector<HTMLElement>("[data-device-status]");
    const errorEl = form.querySelector<HTMLElement>("[data-device-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    statusEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if (submitBtn) submitBtn.disabled = true;
    const { data, error } = await run(new FormData(form));
    if (submitBtn) submitBtn.disabled = false;
    if (error) {
      if (errorEl) {
        errorEl.textContent = error.message || "Could not save.";
        errorEl.classList.remove("hidden");
      }
      return;
    }
    if (statusEl) {
      statusEl.textContent = data?.message ?? "Saved.";
      statusEl.classList.remove("hidden");
    }
  }

  document.querySelectorAll<HTMLFormElement>("[data-device-rename-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleDeviceForm(form, (formData) => actions.renameDevice(formData));
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-device-space-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleDeviceForm(form, (formData) => actions.updateDeviceSpaceAction(formData));
    });
  });
</script>
