---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import TempFeedsSettings from "../../components/TempFeedsSettings.astro";
import PullProbeMapper from "../../components/PullProbeMapper";
import PullFetchButton from "../../components/PullFetchButton";
import PullFeedSaveBar from "../../components/PullFeedSaveBar";
import PushInlineRename from "../../components/PushInlineRename";
import RevealIngestKeyButton from "../../components/RevealIngestKeyButton";
import DeviceSetupWizard from "../../components/DeviceSetupWizard.astro";
import DeviceIntegrationsStrip from "../../components/DeviceIntegrationsStrip.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getUserPreferences } from "../../lib/userPreferences";
import { checkFeedHealth } from "../../lib/collectHistory";
import { getUserDevicesAsTempConfig, listHouseholdDevices, SENSOR_KIND_LABELS, formatBoolSensorValue } from "../../lib/devices";
import { getOrCreateHouseholdForUser, listUserHouseholds, getUserHouseholdRole, canEditHousehold, canManageHousehold } from "../../lib/households";
import ThermostatConnectCard from "../../components/ThermostatConnectCard.astro";
import IndoorReferenceCard from "../../components/IndoorReferenceCard.astro";
import ExampleFeedCard from "../../components/ExampleFeedCard.astro";
import { listConnectionsForHousehold } from "../../lib/thermostatConnections";
import { getIndoorReferenceSensorId, listIndoorReferenceOptions } from "../../lib/indoorReference";
import { fetchThermostatContextWithStatus } from "../../lib/thermostatCorrelation";
import { listConfiguredThermostatProviders } from "../../lib/thermostatOAuth";
import { getUserEntitlements } from "../../lib/entitlements";
import { fetchLatestSensorValues } from "../../lib/sensorReadings";
import { formatRelativeAge, freshnessDetail } from "../../lib/relativeTime";
import { freshnessDetailForSource } from "../../lib/sensorFreshness";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import { batterySparklinePath, parseBatteryHistory } from "../../lib/batterySparkline";
import { renderIngestQrSvg } from "../../lib/qrSvg";
import {
  buildWaitingIngestCurl,
  buildWaitingIngestPayload,
} from "../../lib/waitingIngest";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import { FLASH_INGEST_KEY, peekSecretFlash } from "../../lib/secretFlash";
import { ingestKeyVaultConfigured } from "../../lib/ingestKeyVault";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const [preferences, feedHealth, deviceConfig, entitlements, household, userHouseholds] = await Promise.all([
  getUserPreferences(user),
  checkFeedHealth(user.id),
  getUserDevicesAsTempConfig(user.id, user.email),
  getUserEntitlements(user.id),
  getOrCreateHouseholdForUser(user.id, user.email),
  listUserHouseholds(user.id),
]);

const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);
const canManageThermostat = canManageHousehold(householdRole);
const transferTargets = userHouseholds.households.filter(
  (h) => h.household_id !== household.householdId,
);

const thermostatConnections =
  entitlements.canUseThermostatIntegration && household.householdId
    ? await listConnectionsForHousehold(household.householdId)
    : [];
const availableThermostatProviders = listConfiguredThermostatProviders();
const thermostatConnectionsWithSnapshots = await Promise.all(
  thermostatConnections.map(async (connection) => {
    const result =
      household.householdId
        ? await fetchThermostatContextWithStatus(household.householdId, connection.provider)
        : { snapshot: null as const };
    return {
      provider: connection.provider,
      snapshot: result.snapshot,
      fetchError: "fetchError" in result ? result.fetchError : undefined,
      fetchHint: "fetchHint" in result ? result.fetchHint : undefined,
    };
  }),
);

const devices = household.householdId
  ? (await listHouseholdDevices(household.householdId)).devices
  : deviceConfig.devices;

const indoorReferenceSensorId = household.householdId
  ? await getIndoorReferenceSensorId(household.householdId)
  : null;
const indoorReferenceOptions = listIndoorReferenceOptions(devices);
const indoorRefSaved = Astro.url.searchParams.get("indoor_ref_saved") === "1";
const indoorRefErrorCode = Astro.url.searchParams.get("indoor_ref_error");
const indoorRefError =
  indoorRefErrorCode === "save_failed"
    ? "Couldn't save the indoor reference — try again."
    : indoorRefErrorCode === "forbidden"
      ? "You don't have permission to change this setting."
      : indoorRefErrorCode === "no_household"
        ? "No household found."
        : null;

const latest = household.householdId
  ? await fetchLatestSensorValues(household.householdId)
  : [];

const redirectTo = "/dashboard/temperature";
const activeTab =
  Astro.url.searchParams.get("tab") === "pull"
    ? "pull"
    : Astro.url.searchParams.get("tab") === "push"
      ? "push"
      : "push";
const ingestKey = peekSecretFlash(Astro.cookies, FLASH_INGEST_KEY);
const focusDevice = Astro.url.searchParams.get("focus_device") ?? "";
const atDeviceLimit =
  devices.filter((d) => d.source === "push").length >= entitlements.maxDevices;

const noticeParam = Astro.url.searchParams.get("error");
const deviceNotice =
  Astro.url.searchParams.get("device_deleted")
    ? "Device deleted."
    : Astro.url.searchParams.get("device_renamed")
      ? "Device renamed."
      : Astro.url.searchParams.get("sensor_added")
      ? "Sensor added."
      : Astro.url.searchParams.get("sensor_updated")
        ? "Sensor updated."
        : Astro.url.searchParams.get("sensor_deleted")
          ? "Sensor deleted."
          : Astro.url.searchParams.get("feeds_saved") || Astro.url.searchParams.get("pull_saved")
            ? Astro.url.searchParams.get("probes_discovered")
              ? `Pull setup saved — imported ${Astro.url.searchParams.get("probes_discovered")} probe key(s). Rename below if needed.`
              : "Pull setup saved."
            : Astro.url.searchParams.get("probes_saved")
              ? "Probe labels saved."
              : Astro.url.searchParams.get("sensors_renamed")
                ? "Sensor names saved."
              : Astro.url.searchParams.get("feed_deleted")
                ? "Feed deleted."
                : Astro.url.searchParams.get("probe_deleted")
                  ? "Probe deleted."
                  : Astro.url.searchParams.get("feeds_error") ||
                      Astro.url.searchParams.get("probes_error")
                    ? "Could not save changes. Please try again."
                    : noticeParam === "device_limit"
                      ? `Push device limit reached (${entitlements.maxDevices} per property). Upgrade to add more.`
                      : noticeParam === "viewer"
                        ? "View-only access — you cannot change devices or feeds."
                      : noticeParam === "1" || noticeParam === "true"
                        ? "Could not complete that device action. Check the form and try again."
                        : noticeParam
                          ? `Could not complete that action (${noticeParam}). Please try again.`
                          : null;

const noticeIsError =
  Astro.url.searchParams.has("error") ||
  Boolean(Astro.url.searchParams.get("feeds_error")) ||
  Boolean(Astro.url.searchParams.get("probes_error"));

const keyCalloutTitle = Astro.url.searchParams.get("key_rotated")
  ? "Save your new ingest key"
  : "Save your ingest key";
const showAddSensorNudge = false;

const pushDevices = devices.filter((d) => d.source === "push");
const waitingPushDevices = pushDevices.filter(
  (d) => !d.last_seen_at && d.sensors.length > 0,
);
const waitingPushNoSensors = pushDevices.filter(
  (d) => !d.last_seen_at && d.sensors.length === 0,
);
const neverSeenWithSensors = waitingPushDevices.length > 0;
const showVerifyIngest =
  Boolean(Astro.url.searchParams.get("sensor_added")) ||
  neverSeenWithSensors ||
  waitingPushNoSensors.length > 0;
const showReceivingData =
  !showAddSensorNudge &&
  pushDevices.some((d) => Boolean(d.last_seen_at)) &&
  latest.length > 0 &&
  !neverSeenWithSensors;
const kindLabels = SENSOR_KIND_LABELS;

const waitingSensors = waitingPushDevices.flatMap((d) =>
  d.sensors.map((s) => ({ key: s.key, kind: s.kind, deviceName: d.name })),
);
const waitingPayload = buildWaitingIngestPayload(waitingSensors);
const waitingCurl = buildWaitingIngestCurl(
  Astro.url.origin,
  waitingSensors,
  ingestKey || "YOUR_KEY",
);
const waitingKeyList = [...new Set(waitingSensors.map((s) => s.key))];
const ingestOk = Astro.url.searchParams.get("ingest_ok") === "1";
const deviceCreated = Astro.url.searchParams.get("device_created") === "1";
const pullSaved = Astro.url.searchParams.get("pull_saved") === "1";
const demoPullStarted = Astro.url.searchParams.get("demo_pull") === "1";
const analyticsEvents = [
  ...(ingestOk ? [{ name: "first_ingest" as const }] : []),
  ...(deviceCreated ? [{ name: "device_created" as const }] : []),
  ...(pullSaved ? [{ name: "pull_setup_saved" as const }] : []),
  ...(demoPullStarted ? [{ name: "demo_pull_started" as const }] : []),
];

function formatLatestValue(row: (typeof latest)[number]): string {
  if (row.value_bool != null) {
    return formatBoolSensorValue(row.sensor.kind, row.value_bool);
  }
  if (row.value_num != null) {
    return `${row.value_num.toFixed(1)}${row.sensor.unit ? ` ${row.sensor.unit}` : ""}`;
  }
  return row.value_text ?? "—";
}

function readDeviceMetaNumber(meta: unknown, key: string): number | null {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return null;
  const value = (meta as Record<string, unknown>)[key];
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}

function formatDeviceBattery(meta: unknown): string {
  const battery = readDeviceMetaNumber(meta, "battery_pct");
  return battery == null ? "—" : `${battery}%`;
}

function formatDeviceRssi(meta: unknown): string {
  const rssi = readDeviceMetaNumber(meta, "rssi");
  return rssi == null ? "—" : `${rssi} dBm`;
}

const ingestCurlExample = ingestKey
  ? waitingKeyList.length > 0
    ? waitingCurl
    : `curl -X POST "${Astro.url.origin}/api/ingest/${ingestKey}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"door1": true, "temp1": 42.5}'`
  : "";
const ingestUrl = ingestKey
  ? `${Astro.url.origin}/api/ingest/${ingestKey}`
  : "";
const ingestQrSvg = ingestUrl ? renderIngestQrSvg(ingestUrl, 180) : "";
const ingestKeyDeviceName =
  (focusDevice && devices.find((d) => d.id === focusDevice)?.name) ||
  pushDevices[0]?.name ||
  "Push device";

const showAllDevices = Astro.url.searchParams.get("view") === "all";
const hasLiveIngest =
  latest.length > 0 || pushDevices.some((d) => Boolean(d.last_seen_at));
const showDeviceWizard =
  canEdit &&
  !showAllDevices &&
  !hasLiveIngest &&
  (devices.length === 0 || pushDevices.length > 0);
const wizardStep =
  devices.length === 0
    ? 1
    : pushDevices.some((d) => !d.last_seen_at)
      ? 2
      : 2;
function deviceHasRecoverableKey(meta: unknown): boolean {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return false;
  return typeof (meta as Record<string, unknown>).ingest_key_enc === "string";
}

function sensorNeedsRename(label: string): boolean {
  return /^Probe \d+$/.test(label.trim());
}

const ingestKeyVaultLive = ingestKeyVaultConfigured();
const pullFeedIds = preferences.tempFeeds.filter((f) => f.url).map((f) => f.id);
const showRenameBatch =
  Boolean(Astro.url.searchParams.get("ingest_ok")) ||
  Boolean(Astro.url.searchParams.get("rename_sensors")) ||
  Number(Astro.url.searchParams.get("sensors_created") ?? "0") > 0;
const sensorsNeedRename = devices.some((device) =>
  device.sensors.some((sensor) => sensor.kind === "temperature" && sensorNeedsRename(sensor.label)),
);
const postSetupFunnel = ingestOk && canEdit;
const postSetupHasRenamed = !sensorsNeedRename;
---
<DashboardLayout title="Devices">
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Devices & sensors</h2>
      <p class="card-subtitle">
        Create a <strong>push</strong> device, copy the ingest URL into your ESP/Arduino, and sensors appear on first POST.
        Pull feeds, thermostats, and Home Assistant live under other connection options.
      </p>
      {deviceNotice && (
        <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0"]}>
          {deviceNotice}
          {noticeParam === "device_limit" && (
            <>
              {" "}
              <a class="text-link" href="/dashboard/plans">View plans</a>
            </>
          )}
        </p>
      )}
    </section>

    {activeTab === "push" ? (
      <p class="form-hint mb-0">
        Prefer a scheduled HTTPS JSON feed or thermostat?
        <a class="text-link" href="/dashboard/temperature?tab=pull">Other ways to connect</a>
      </p>
    ) : (
      <nav class="flex flex-wrap gap-2" aria-label="Device source">
        <a class="btn-secondary" href="/dashboard/temperature?tab=push">
          ← Back to push devices
        </a>
        <a
          class:list={["btn-secondary", "ring-2 ring-[var(--color-accent)]"]}
          href="/dashboard/temperature?tab=pull"
        >
          Pull feeds & thermostats
        </a>
      </nav>
    )}

    {activeTab === "push" && <DeviceIntegrationsStrip />}

    <DeviceSetupWizard show={postSetupFunnel} hasRenamed={postSetupHasRenamed} />

    {(noticeParam === "device_limit" || atDeviceLimit) && (
      <UpgradeNudge feature="device_limit" tier={entitlements.tier} compact />
    )}

    {ingestKey && (
      <section class="card ingest-key-callout" id="ingest-key-callout">
        <h2 class="card-title">{keyCalloutTitle}</h2>
        <p class="card-subtitle">
          Copy this key into your ESP/Arduino firmware now. It stays available on this page for 30 minutes
          and survives refresh until you dismiss it — the QR is generated locally (no third-party service).
        </p>
        <div class="flex flex-wrap gap-6 items-start mb-4">
          <div
            class="ingest-key-qr shrink-0 rounded-lg bg-white p-2"
            id="ingest-key-qr"
            aria-label="Ingest URL QR code"
            set:html={ingestQrSvg}
          />
          <div class="min-w-0 flex-1">
            <p class="form-label mb-1">Ingest URL</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-2" id="ingest-url-value">{ingestUrl}</p>
            <p class="ingest-key-value break-all font-mono text-sm mb-0" id="ingest-key-value">{ingestKey}</p>
            <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-0">
              POST JSON to <code>/api/ingest/{ingestKey}</code>
            </p>
          </div>
        </div>
        <pre class="ingest-key-curl text-xs overflow-x-auto mb-4"><code>{ingestCurlExample}</code></pre>
        <div class="flex flex-wrap gap-3">
          <button
            type="button"
            class="btn-primary"
            data-copy={ingestKey}
            data-copy-label="Copy key"
          >
            Copy key
          </button>
          <button
            type="button"
            class="btn-secondary"
            data-copy={ingestUrl}
            data-copy-label="Copy URL"
          >
            Copy URL
          </button>
          <a
            class="btn-secondary"
            id="ingest-qr-download"
            href="#"
            download="thermaltrace-ingest-qr.svg"
          >
            Download SVG
          </a>
          <button type="button" class="btn-secondary" id="ingest-qr-print">
            Print label
          </button>
          <button type="button" class="btn-ghost" id="ingest-key-dismiss">
            I've saved this
          </button>
        </div>
      </section>
    )}

    {showReceivingData && !postSetupFunnel && (
      <section class="card alert-success" id="receiving-data">
        <h2 class="card-title">Receiving data</h2>
        <p class="mb-4">
          {ingestOk
            ? "First POST received — readings are live. Confirm freeze alerts reach you next."
            : "Ingest looks healthy — readings are showing up. Confirm freeze alerts reach you next."}
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/dashboard/alerts#send-test-alert">Send a test alert</a>
          <a class="btn-secondary" href="/">Open Home</a>
          <a class="btn-ghost" href="/dashboard">Overview</a>
        </div>
      </section>
    )}

    {showVerifyIngest && (
      <section
        class="card ingest-waiting-callout"
        id="verify-ingest-step"
        data-waiting-ingest
        data-waiting={neverSeenWithSensors || waitingPushNoSensors.length > 0 ? "1" : "0"}
      >
        <h2 class="card-title">
          {neverSeenWithSensors
            ? "Waiting for first POST"
            : waitingPushNoSensors.length > 0
              ? "Waiting for first POST (auto-map sensors)"
              : "Next: verify ingest"}
        </h2>
        <p class="card-subtitle mb-4">
          {waitingPushNoSensors.length > 0 ? (
            <>
              No sensor keys mapped yet — that is OK. POST JSON to your ingest URL and ThermalTrace
              will import keys automatically (SenML names, HA <code>friendly_name</code>, or flat keys
              like <code>temp1</code>). Rename sensors afterward on the device card.
            </>
          ) : (
            <>
              Sensors are mapped. Point firmware at your ingest URL and POST JSON that includes the
              keys below. This page checks for the first reading automatically.
            </>
          )}
        </p>

        <ol class="waiting-ingest-checklist mb-4">
          <li class="waiting-ingest-done">Push device created</li>
          <li class:list={[neverSeenWithSensors && "waiting-ingest-done", waitingPushNoSensors.length > 0 && "waiting-ingest-pending"]}>
            {waitingPushNoSensors.length > 0 ? "Sensors auto-import on first POST" : "Sensors mapped"}
            {waitingKeyList.length > 0 && (
              <>
                {" "}
                (
                <code class="text-xs">{waitingKeyList.join(", ")}</code>
                )
              </>
            )}
          </li>
          <li
            class="waiting-ingest-pending"
            data-waiting-step="post"
          >
            First ingest POST
            <span class="waiting-ingest-status" data-waiting-status>
              {neverSeenWithSensors || waitingPushNoSensors.length > 0
                ? " — listening…"
                : " — send a test POST"}
            </span>
          </li>
        </ol>

        {waitingKeyList.length > 0 && (
          <>
            <p class="form-label mb-1">Sample payload for your keys</p>
            <pre class="ingest-key-curl text-xs overflow-x-auto mb-3"><code>{JSON.stringify(waitingPayload, null, 2)}</code></pre>
            <p class="form-label mb-1">Test with curl</p>
            <pre class="ingest-key-curl text-xs overflow-x-auto mb-3"><code>{waitingCurl}</code></pre>
            <p class="text-sm text-[var(--color-text-muted)] mb-4">
              {ingestKey ? (
                <>
                  Use the key from the callout above (not the <code>YOUR_KEY</code> placeholder).
                </>
              ) : (
                <>
                  Replace <code>YOUR_KEY</code> with the key from device creation, or use <strong>Reveal ingest key</strong> on the device card.
                  Lost it? Use <strong>Rotate key</strong> on the device card below.
                </>
              )}
            </p>
          </>
        )}

        <div class="flex flex-wrap gap-3 items-center">
          <a class="btn-primary" href="/">Open Home</a>
          <a class="btn-secondary" href="/about/kit-qr-onboarding">Hardware kit QR guide</a>
          <a class="btn-ghost" href="/about/adding-devices">Adding devices</a>
          <button type="button" class="btn-ghost" data-waiting-refresh>
            Check now
          </button>
        </div>
        <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]" data-waiting-meta>
          {neverSeenWithSensors || waitingPushNoSensors.length > 0
            ? "Auto-checking every 5 seconds while this page is open."
            : "Send a POST, then click Check now or refresh."}
        </p>
      </section>
    )}

    {showDeviceWizard && activeTab === "push" && (
      <section class="card" id="device-setup-wizard">
        <h2 class="card-title">Device setup</h2>
        <p class="card-subtitle mb-4">
          Step {wizardStep} of 2 — create a push device, POST JSON (sensors auto-import), then verify readings.
        </p>
        <ol class="waiting-ingest-checklist mb-4">
          <li class:list={[wizardStep > 1 && "waiting-ingest-done"]}>Create push device</li>
          <li class:list={[wizardStep >= 2 && "waiting-ingest-pending"]}>
            POST JSON — sensors auto-import; rename afterward if needed
          </li>
        </ol>
        <a class="btn-ghost" href="/dashboard/temperature?view=all&tab=push">Show all device settings</a>
      </section>
    )}

    {!showDeviceWizard && (
    <>
    <section class="card" id="device-health">
      <h2 class="card-title">Device health</h2>
      <p class="card-subtitle mb-4">
        Last seen, staleness, and optional battery/RSSI from ingest payloads.
      </p>
      {devices.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">No devices yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">Device</th>
                <th class="py-2 pr-3">Space</th>
                <th class="py-2 pr-3">Source</th>
                <th class="py-2 pr-3">Last seen</th>
                <th class="py-2 pr-3">Sensors</th>
                <th class="py-2 pr-3">Battery</th>
                <th class="py-2">RSSI</th>
              </tr>
            </thead>
            <tbody>
              {devices.map((device) => {
                const age = formatRelativeAge(device.last_seen_at);
                const battery = formatDeviceBattery(device.meta);
                const rssi = formatDeviceRssi(device.meta);
                const sparkPath = batterySparklinePath(parseBatteryHistory(device.meta));
                const pullHealth = feedHealth.statuses.find((f) => f.feedId === device.id);
                return (
                  <tr class="border-t border-[var(--color-border)]">
                    <td class="py-2 pr-3">
                      <strong>{device.name}</strong>
                      {device.ingest_key_prefix && (
                        <span class="block text-xs text-[var(--color-text-muted)]">
                          key {device.ingest_key_prefix}…
                        </span>
                      )}
                    </td>
                    <td class="py-2 pr-3">{device.space || "—"}</td>
                    <td class="py-2 pr-3">
                      {device.source === "push" ? "Push" : "Pull"}
                      {pullHealth && (
                        <span class="block text-xs text-[var(--color-text-muted)]">
                          {pullHealth.ok ? "Reachable" : pullHealth.message}
                        </span>
                      )}
                    </td>
                    <td class:list={["py-2 pr-3", age.lagging && "text-[var(--color-danger)]"]}>
                      {device.last_seen_at ? freshnessDetail(age) : age.label}
                    </td>
                    <td class="py-2 pr-3">{device.sensors.length}</td>
                    <td class="py-2 pr-3">
                      {battery}
                      {sparkPath && (
                        <svg
                          class="block mt-1 text-[var(--color-accent)]"
                          width="64"
                          height="20"
                          viewBox="0 0 64 20"
                          aria-hidden="true"
                        >
                          <path d={sparkPath} fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                      )}
                    </td>
                    <td class="py-2">{rssi}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {latest.length > 0 && (
      <section class="card">
        <h2 class="card-title">Latest sensor values</h2>
        <div class="feed-health-grid">
          {latest.map((row) => {
            const device = devices.find((d) => d.id === row.sensor.device_id);
            const age = formatRelativeAge(row.recorded_at);
            return (
              <div class="feed-health-item">
                <div>
                  <strong>{row.sensor.label}</strong>
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    {row.deviceName} · {kindLabels[row.sensor.kind] ?? row.sensor.kind}
                    {device?.source === "pull_url" ? " · pull" : device?.source === "push" ? " · push" : ""}
                  </p>
