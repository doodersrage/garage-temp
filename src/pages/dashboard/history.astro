---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import GarageTempHistory from "../../components/GarageTempHistory.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import HistorySubscription from "../../components/HistorySubscription.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { canDownloadHistoryCsv } from "../../lib/adminAccess";
import {
  fetchGarageTempChartData,
  fetchGarageTempChartDataPriorYear,
  fetchGarageTempHistory,
  fetchHistoryFilterOptions,
} from "../../lib/garageTempsHistory";
import { detectTemperatureAnomalies } from "../../lib/anomalyDetection";
import { getUserSubscription } from "../../lib/stripeSubscriptions";
import {
  compareProbeAverages,
  compareSpaceAverages,
  computeSeasonalInsights,
} from "../../lib/seasonalInsights";
import { getUserDevicesAsTempConfig } from "../../lib/devices";
import { getUserPreferences } from "../../lib/userPreferences";
import { fetchIndoorOutdoorDelta, buildIndoorOutdoorSeries } from "../../lib/indoorOutdoorDelta";
import { computeFreezeHours } from "../../lib/freezeHours";
import IndoorOutdoorChart from "../../components/IndoorOutdoorChart.tsx";
import { RAW_READING_RETENTION_DAYS } from "../../lib/retentionSchedule";
import { getUserEntitlements } from "../../lib/entitlements";
import { getAlertSettingsForUser } from "../../lib/notify";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const feedFilter = Astro.url.searchParams.get("feed")?.trim() ?? "";
const probeFilter = Astro.url.searchParams.get("probe")?.trim() ?? "";
const fromDate = Astro.url.searchParams.get("from")?.trim() ?? "";
const toDate = Astro.url.searchParams.get("to")?.trim() ?? "";
const daysParam = Number(Astro.url.searchParams.get("days") ?? "7");
const chartDays = daysParam === 30 ? 30 : 7;
const compareYoy = Astro.url.searchParams.get("yoy") === "1";

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect("/dashboard/history?page=1");
}

const filters = {
  feedName: feedFilter || undefined,
  probeKey: probeFilter || undefined,
  from: fromDate ? new Date(`${fromDate}T00:00:00`).toISOString() : undefined,
  to: toDate ? new Date(`${toDate}T23:59:59`).toISOString() : undefined,
};

const preferences = await getUserPreferences(user);

const chartWindowDays =
  fromDate && toDate
    ? Math.max(
        1,
        Math.ceil(
          (Date.parse(`${toDate}T23:59:59`) - Date.parse(`${fromDate}T00:00:00`)) /
            (24 * 60 * 60 * 1000),
        ),
      )
    : chartDays;

const [
  history,
  chartData,
  priorYearData,
  filterOptions,
  canDownloadCsv,
  subscription,
  insights,
  entitlements,
  alertSettings,
] = await Promise.all([
  fetchGarageTempHistory(user.id, pageParam, undefined, filters),
  fetchGarageTempChartData(user.id, chartWindowDays, filters),
  compareYoy
    ? fetchGarageTempChartDataPriorYear(user.id, chartWindowDays, filters)
    : Promise.resolve({ points: [], error: null }),
  fetchHistoryFilterOptions(user.id),
  canDownloadHistoryCsv(user.id),
  getUserSubscription(user.id),
  computeSeasonalInsights(user.id, 30),
  getUserEntitlements(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
]);

const outdoorDelta = await fetchIndoorOutdoorDelta(
  chartData.points,
  preferences.weatherCityId,
);
const indoorOutdoorSeries = outdoorDelta
  ? buildIndoorOutdoorSeries(chartData.points, outdoorDelta.outdoorF)
  : [];
const freezeHours = computeFreezeHours(chartData.points, alertSettings.freezeThresholdF);

if (history.totalPages > 0 && pageParam > history.totalPages) {
  return Astro.redirect(`/dashboard/history?page=${history.totalPages}`);
}

const subscriptionNotice = Astro.url.searchParams.get("subscription");
const anomalies = detectTemperatureAnomalies(chartData.points);
const probeCompare = compareProbeAverages(chartData.points);

const deviceConfig = await getUserDevicesAsTempConfig(user.id, user.email);
const probeToSpace = new Map<string, string>();
for (const device of deviceConfig.devices) {
  if (!device.space) continue;
  for (const sensor of device.sensors) {
    if (sensor.kind === "temperature") {
      probeToSpace.set(sensor.label, device.space);
    }
  }
}
const spaceCompare = compareSpaceAverages(chartData.points, probeToSpace);
const showRetentionNote =
  entitlements.tier === "member" ||
  entitlements.tier === "pro" ||
  entitlements.tier === "admin";
---
<DashboardLayout title="Reading History">
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Historic probe readings</h2>
      <p class="card-subtitle mb-0">
        Browse saved temperature and humidity snapshots by feed and probe.
        Snapshots collect automatically while feeds or devices are online.
        {canDownloadCsv
          ? " Download the full record as CSV below."
          : " Subscribe to unlock CSV export of your saved history."}
      </p>
    </section>

    {!canDownloadCsv && (
      <UpgradeNudge feature="csv_export" tier={entitlements.tier} />
    )}

    <section class="card">
      <h2 class="card-title">Data retention</h2>
      <p class="mb-0 text-sm">
        Raw readings are kept for <strong>{RAW_READING_RETENTION_DAYS} days</strong>, then rolled into hourly averages.
        Year-over-year compare uses those rollups when raw rows have aged out.
        {showRetentionNote
          ? " Member and Pro plans unlock CSV export of the retained window."
          : ""}
      </p>
    </section>

    {outdoorDelta && (
      <section class="card">
        <h2 class="card-title">Indoor vs outdoor</h2>
        <p class="card-subtitle">
          Chart-window garage average compared with current outdoor weather
          {outdoorDelta.cityName ? ` in ${outdoorDelta.cityName}` : ""}.
        </p>
        <div class="stat-grid">
          <article class="stat-item">
            <span class="stat-label">Indoor avg</span>
            <p class="stat-value">{outdoorDelta.indoorAvgF.toFixed(1)}°F</p>
          </article>
          <article class="stat-item">
            <span class="stat-label">Outdoor now</span>
            <p class="stat-value">{outdoorDelta.outdoorF.toFixed(1)}°F</p>
            <p class="stat-detail">{outdoorDelta.outdoorDescription}</p>
          </article>
          <article class="stat-item">
            <span class="stat-label">Delta</span>
            <p class="stat-value">
              {outdoorDelta.deltaF > 0 ? "+" : ""}
              {outdoorDelta.deltaF.toFixed(1)}°F
            </p>
            <p class="stat-detail">
              {outdoorDelta.deltaF > 0
                ? "Garage warmer than outdoors"
                : outdoorDelta.deltaF < 0
                  ? "Garage cooler than outdoors"
                  : "Matched outdoors"}
            </p>
          </article>
        </div>
        {indoorOutdoorSeries.length >= 2 && (
          <div class="mt-4">
            <IndoorOutdoorChart client:visible points={indoorOutdoorSeries} />
          </div>
        )}
        <p class="mt-4 mb-0 text-sm">
          <a class="text-link" href="/api/ical/outlook">Subscribe to freeze outlook (iCal)</a>
        </p>
      </section>
    )}

    {chartData.points.length >= 2 && (
      <section class="card">
        <h2 class="card-title">Season freeze exposure</h2>
        <p class="card-subtitle mb-4">
          Estimated time below 34°F in the selected chart window.
        </p>
        <div class="stat-grid">
          <article class="stat-item">
            <span class="stat-label">Hours ≤ 34°F</span>
            <p class="stat-value">{freezeHours.hoursBelow34.toFixed(1)}</p>
          </article>
          <article class="stat-item">
            <span class="stat-label">Readings ≤ 34°F</span>
            <p class="stat-value">{freezeHours.readingsBelow34}</p>
          </article>
          <article class="stat-item">
            <span class="stat-label">Coldest</span>
            <p class="stat-value">
              {freezeHours.coldestF != null ? `${freezeHours.coldestF.toFixed(1)}°F` : "—"}
            </p>
          </article>
        </div>
      </section>
    )}

    {insights.length > 0 && (
      <section class="card">
        <h2 class="card-title">Seasonal insights (30 days)</h2>
        <ul class="space-y-2 mb-0">
          {insights.map((insight) => (
            <li>
              <strong>{insight.title}:</strong> {insight.detail}
            </li>
          ))}
        </ul>
        {probeCompare.length > 0 && (
          <p class="mt-4 mb-0 text-sm">{probeCompare[0]}</p>
        )}
        {spaceCompare.length > 0 && (
          <p class="mt-2 mb-0 text-sm">{spaceCompare[0]}</p>
        )}
      </section>
    )}

    <HistorySubscription
      canDownloadCsv={canDownloadCsv}
      subscription={subscription}
      subscriptionNotice={subscriptionNotice}
    />

    <GarageTempHistory
      history={history}
      chartPoints={chartData.points}
      priorYearPoints={priorYearData.points}
      compareYoy={compareYoy}
      basePath="/dashboard/history"
      canDownloadCsv={canDownloadCsv}
      feedFilter={feedFilter}
      probeFilter={probeFilter}
      fromDate={fromDate}
      toDate={toDate}
      days={chartDays}
      anomalies={anomalies}
      filterOptions={filterOptions}
      freezeThresholdF={alertSettings.freezeThresholdF}
    />
  </div>
</DashboardLayout>
