---
import Layout from "../../layouts/Layout.astro";
import GarageTempHistory from "../../components/GarageTempHistory.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { fetchGarageTempHistory } from "../../lib/garageTempsHistory";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect("/dashboard/history?page=1");
}

const history = await fetchGarageTempHistory(pageParam);

if (history.totalPages > 0 && pageParam > history.totalPages) {
  return Astro.redirect(`/dashboard/history?page=${history.totalPages}`);
}
---
<Layout title="Reading History">
  <div class="page-shell space-y-6">
    <section class="card animate-slide-in-left">
      <h1 class="card-title">Historic probe readings</h1>
      <p class="card-subtitle">{user.email}</p>
      <p class="mb-6">
        Browse saved temperature and humidity snapshots by feed and probe, or download the full record as CSV.
      </p>
      <a class="btn-secondary" href="/dashboard">Back to dashboard</a>
    </section>

    <GarageTempHistory history={history} basePath="/dashboard/history" />
  </div>
</Layout>
