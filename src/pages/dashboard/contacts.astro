---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ContactSubmissions from "../../components/ContactSubmissions.astro";
import { fetchContactSubmissions } from "../../lib/contactSubmissions";
import { getAuthFromCookies } from "../../lib/auth";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const statusFilter = Astro.url.searchParams.get("status")?.trim() ?? "";
const searchFilter = Astro.url.searchParams.get("q")?.trim() ?? "";

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect("/dashboard/contacts?page=1");
}

const submissions = await fetchContactSubmissions(pageParam, undefined, {
  status: statusFilter || undefined,
  search: searchFilter || undefined,
});

if (submissions.totalPages > 0 && pageParam > submissions.totalPages) {
  return Astro.redirect(`/dashboard/contacts?page=${submissions.totalPages}`);
}
---
<DashboardLayout title="Contact Submissions" requireAdmin>
  <div class="space-y-6">
    <section class="card animate-slide-in-left">
      <h1 class="card-title">Contact submissions</h1>
      <p class="card-subtitle">{user.email}</p>
      <p class="mb-0">
        Review messages sent through the site contact form. Mark items read or spam to keep the inbox manageable.
      </p>
    </section>

    <ContactSubmissions
      submissions={submissions}
      statusFilter={statusFilter}
      searchFilter={searchFilter}
    />
  </div>
</DashboardLayout>
