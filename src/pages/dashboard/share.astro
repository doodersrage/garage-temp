---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getOrCreateHouseholdForUser } from "../../lib/households";
import { getUserEntitlements } from "../../lib/entitlements";
import { createServerClient } from "../../lib/supabase";
import { getSiteUrl } from "../../lib/stripe";
import { listHouseholdApiKeys } from "../../lib/apiKeys";

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const entitlements = await getUserEntitlements(user.id);
const household = await getOrCreateHouseholdForUser(user.id, user.email);
const supabase = createServerClient();
const { data: links } = household.householdId
  ? await supabase
      .from("share_links")
      .select("id, token, scope, label, expires_at, created_at")
      .eq("household_id", household.householdId)
      .order("created_at", { ascending: false })
  : { data: [] };

const apiKeys = household.householdId
  ? await listHouseholdApiKeys(household.householdId)
  : [];

const siteUrl = getSiteUrl(Astro.request);
const newToken = Astro.url.searchParams.get("new_token");
const newHref = newToken ? `${siteUrl}/share/${newToken}` : null;
const newApiKey = Astro.url.searchParams.get("new_api_key");
const notice = Astro.url.searchParams.get("created")
  ? "Share link created — copy it below to send to family."
  : Astro.url.searchParams.get("revoked")
    ? "Share link revoked."
    : Astro.url.searchParams.get("api_key_created")
      ? "API key created — copy it now; it will not be shown again."
      : Astro.url.searchParams.get("api_key_revoked")
        ? "API key revoked."
        : Astro.url.searchParams.get("error") === "pro_required"
          ? "Pro plan required for share links and API keys."
          : null;
const noticeIsError = Astro.url.searchParams.get("error") === "pro_required";
---
<DashboardLayout title="Share links">
  <div class="space-y-6">
    <section class="card">
      <h1 class="card-title">Public share links</h1>
      <p class="card-subtitle">Read-only live views for family without accounts. Pro feature.</p>
      {notice && (
        <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-4"]}>{notice}</p>
      )}
    </section>

    {newHref && (
      <section class="card ingest-key-callout" id="new-share-link">
        <h2 class="card-title">New share link</h2>
        <p class="card-subtitle">Copy and send this link. Anyone with it can view live sensors.</p>
        <p class="ingest-key-value break-all text-sm mb-4">
          <a href={newHref}>{newHref}</a>
        </p>
        <button
          type="button"
          class="btn-primary"
          data-copy={newHref}
          data-copy-label="Copy link"
          id="copy-new-share"
        >
          Copy link
        </button>
      </section>
    )}

    {!entitlements.canCreateShareLinks ? (
      <section class="card">
        <p class="mb-4">Upgrade to Pro to create public share links.</p>
        <form action="/api/stripe/checkout" method="post">
          <input type="hidden" name="plan" value="pro" />
          <button class="btn-primary" type="submit">Upgrade to Pro</button>
        </form>
      </section>
    ) : (
      <form action="/api/share/manage" method="post" class="card">
        <input type="hidden" name="action" value="create" />
        <input type="hidden" name="redirect" value="/dashboard/share" />
        <h2 class="card-title">Create link</h2>
        <div class="config-row-grid">
          <div class="form-field mb-0">
            <label class="form-label" for="label">Label</label>
            <input class="form-input" id="label" name="label" placeholder="Family live view" />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="scope">Scope</label>
            <select class="form-input" id="scope" name="scope">
              <option value="live">Live sensors</option>
              <option value="history">History (7-day chart)</option>
              <option value="metrics">Metrics (Prometheus / Grafana)</option>
            </select>
            <p class="form-hint">
              Metrics links expose scrape URLs at <code>/api/share/&lt;token&gt;/readings?format=prometheus</code>.
              Pro API keys are also available below.
            </p>
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="expires_days">Expires (days, 0 = never)</label>
            <input class="form-input" type="number" id="expires_days" name="expires_days" value="0" min="0" />
          </div>
        </div>
        <button class="btn-primary mt-4" type="submit">Create</button>
      </form>
    )}

    <section class="card">
      <h2 class="card-title">Your links</h2>
      {(links ?? []).length === 0 ? (
        <p class="mb-0">No share links yet.</p>
      ) : (
        <ul class="space-y-4">
          {(links ?? []).map((link) => {
            const href = `${siteUrl}/share/${link.token}`;
            const isNew = newToken === link.token;
            const expired =
              Boolean(link.expires_at) &&
              Date.parse(link.expires_at as string) <= Date.now();
            return (
              <li
                class:list={[
                  "flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between rounded-xl p-3",
                  isNew && "share-link-new",
                  expired && "share-link-expired",
                ]}
                id={isNew ? "share-link-highlighted" : undefined}
              >
                <div>
                  <strong>{link.label || link.scope}</strong>
                  {isNew && <span class="feed-health-ok ml-2">New</span>}
                  {expired && <span class="feed-health-error ml-2">Expired</span>}
                  <p class="m-0 text-sm break-all">
                    {expired ? (
                      <span class="text-[var(--color-text-muted)]">{href}</span>
                    ) : (
                      <a href={href}>{href}</a>
                    )}
                  </p>
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    Scope: {link.scope}
                    {link.expires_at
                      ? expired
                        ? ` · Expired ${new Date(link.expires_at).toLocaleDateString()}`
                        : ` · Expires ${new Date(link.expires_at).toLocaleDateString()}`
                      : " · No expiry"}
                  </p>
                  {link.scope === "metrics" && !expired && (
                    <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">
                      Scrape: {siteUrl}/api/share/{link.token}/readings?format=prometheus
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap gap-2">
                  {!expired && (
                    <button
                      type="button"
                      class="btn-secondary"
                      data-copy={href}
                      data-copy-label="Copy link"
                    >
                      Copy link
                    </button>
                  )}
                  <form action="/api/share/manage" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={link.id} />
                    <input type="hidden" name="redirect" value="/dashboard/share" />
                    <button class="btn-ghost" type="submit" onclick="return confirm('Revoke this share link?');">
                      {expired ? "Remove" : "Revoke"}
                    </button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    {entitlements.canCreateShareLinks && (
      <section class="card">
        <h2 class="card-title">Dashboard API keys</h2>
        <p class="card-subtitle mb-4">
          Scrape Prometheus metrics with <code>Authorization: Bearer &lt;key&gt;</code> at
          <code>/api/v1/metrics</code>.
        </p>
        {newApiKey && (
          <div class="ingest-key-callout mb-4">
            <p class="ingest-key-value break-all text-sm mb-2">{newApiKey}</p>
            <button type="button" class="btn-primary" data-copy={newApiKey} data-copy-label="Copy key">
              Copy key
            </button>
          </div>
        )}
        <form action="/api/api-keys" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
          <input type="hidden" name="action" value="create" />
          <input type="hidden" name="redirect" value="/dashboard/share" />
          <div class="form-field mb-0">
            <label class="form-label" for="api-key-name">Name</label>
            <input class="form-input" id="api-key-name" name="name" value="Metrics key" />
          </div>
          <button class="btn-secondary" type="submit">Create API key</button>
        </form>
        {apiKeys.length === 0 ? (
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">No active API keys.</p>
        ) : (
          <ul class="space-y-3">
            {apiKeys.map((key) => (
              <li class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <strong>{key.name}</strong>
                  <span class="text-sm text-[var(--color-text-muted)]"> · {key.key_prefix}…</span>
                </div>
                <form action="/api/api-keys" method="post">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="id" value={key.id} />
                  <input type="hidden" name="redirect" value="/dashboard/share" />
                  <button class="btn-ghost" type="submit">Revoke</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}
  </div>
</DashboardLayout>

{newHref && (
  <script is:inline>
    (() => {
      const el = document.getElementById("new-share-link");
      el?.scrollIntoView({ behavior: "smooth", block: "start" });
    })();
  </script>
)}
