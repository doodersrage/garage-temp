---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getOrCreateHouseholdForUser } from "../../lib/households";
import { getUserEntitlements } from "../../lib/entitlements";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import GrafanaWizard from "../../components/GrafanaWizard.astro";
import WebhookDeliveryLog from "../../components/WebhookDeliveryLog.astro";
import HaSetupCard from "../../components/HaSetupCard.astro";
import ZapierSetupCard from "../../components/ZapierSetupCard.astro";
import { listRecentWebhookDeliveries } from "../../lib/webhookDeliveries";
import { createServerClient } from "../../lib/supabase";
import { getSiteUrl } from "../../lib/stripe";
import { listHouseholdApiKeys } from "../../lib/apiKeys";
import { listInboundWebhooks } from "../../lib/inboundWebhooks";
import { listStatusPageTokens } from "../../lib/statusPage";
import { listIngestStatsForHousehold } from "../../lib/ingestStats";
import { listHouseholdActivity } from "../../lib/householdActivity";
import {
  getUserHouseholdRole,
  canManageHousehold,
} from "../../lib/households";
import {
  FLASH_API_KEY,
  FLASH_INBOUND_SIGNING,
  FLASH_INBOUND_TOKEN,
  FLASH_SHARE_TOKEN,
  FLASH_STATUS_TOKEN,
  consumeSecretFlash,
} from "../../lib/secretFlash";

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const inboundToken = consumeSecretFlash(Astro.cookies, FLASH_INBOUND_TOKEN);
const inboundSigningSecret = consumeSecretFlash(Astro.cookies, FLASH_INBOUND_SIGNING);

const entitlements = await getUserEntitlements(user.id);
const household = await getOrCreateHouseholdForUser(user.id, user.email);
const supabase = createServerClient();
const { data: links } = household.householdId
  ? await supabase
      .from("share_links")
      .select("id, token, scope, label, expires_at, created_at")
      .eq("household_id", household.householdId)
      .order("created_at", { ascending: false })
  : { data: [] };

const apiKeys = household.householdId
  ? await listHouseholdApiKeys(household.householdId)
  : [];

const inboundWebhooks = household.householdId
  ? (await listInboundWebhooks(household.householdId)).webhooks
  : [];

const statusPages = household.householdId
  ? await listStatusPageTokens(household.householdId)
  : [];

const ingestStats = household.householdId
  ? await listIngestStatsForHousehold(household.householdId, 7)
  : [];

const activity = household.householdId
  ? await listHouseholdActivity(household.householdId, 15)
  : [];

const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canManage = canManageHousehold(householdRole);

const siteUrl = getSiteUrl(Astro.request);
const webhookDeliveries = await listRecentWebhookDeliveries(user.id, 15);
const newToken = consumeSecretFlash(Astro.cookies, FLASH_SHARE_TOKEN);
const statusToken = consumeSecretFlash(Astro.cookies, FLASH_STATUS_TOKEN);
const newHref = newToken ? `${siteUrl}/share/${newToken}` : null;
const newApiKey = consumeSecretFlash(Astro.cookies, FLASH_API_KEY);
const notice = Astro.url.searchParams.get("created")
  ? "Share link created — copy it below to send to family."
  : Astro.url.searchParams.get("revoked")
    ? "Share link revoked."
    : Astro.url.searchParams.get("api_key_created")
      ? "API key created — copy it now; it will not be shown again."
      : Astro.url.searchParams.get("api_key_revoked")
        ? "API key revoked."
        : Astro.url.searchParams.get("status_created")
          ? "Status page created — copy the link below."
          : Astro.url.searchParams.get("status_revoked")
            ? "Status page revoked."
        : Astro.url.searchParams.get("error") === "pro_required"
          ? "Pro plan required for share links and API keys."
          : null;
const noticeIsError = Astro.url.searchParams.get("error") === "pro_required";
---
<DashboardLayout title="Share links">
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Public share links</h2>
      <p class="card-subtitle">Read-only live views for family, guests, or a short renter check-in. Pro feature.</p>
      {notice && (
        <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-4"]}>{notice}</p>
      )}
      {!canManage && (
        <p class="alert-warning mt-4 mb-0" role="status">
          View-only — you cannot create or revoke share links.
        </p>
      )}
    </section>

    {newHref && (
      <section class="card ingest-key-callout" id="new-share-link">
        <h2 class="card-title">New share link</h2>
        <p class="card-subtitle">Copy and send this link. Anyone with it can view live sensors.</p>
        <p class="ingest-key-value break-all text-sm mb-4">
          <a href={newHref}>{newHref}</a>
        </p>
        <button
          type="button"
          class="btn-primary"
          data-copy={newHref}
          data-copy-label="Copy link"
          id="copy-new-share"
        >
          Copy link
        </button>
      </section>
    )}

    {newHref && entitlements.canCreateShareLinks && (
      <section class="card" id="ha-hacs-nudge">
        <h2 class="card-title">Use this link in Home Assistant</h2>
        <p class="card-subtitle mb-4">
          Install the official
          <a class="text-link" href="/integrations/home-assistant">HACS integration</a>,
          then paste the token from your share URL (<code>/share/YOUR_TOKEN</code>) in
          <strong>Settings → Devices &amp; services → ThermalTrace</strong>.
          Optional: add an inbound webhook below for <code>thermaltrace.snooze</code> automations.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/integrations/home-assistant">HACS install guide</a>
          <a class="btn-secondary" href="https://github.com/doodersrage/thermaltrace-home-assistant" target="_blank" rel="noreferrer">
            GitHub repo
          </a>
        </div>
      </section>
    )}

    {!entitlements.canCreateShareLinks ? (
      <UpgradeNudge feature="share_links" tier={entitlements.tier} />
    ) : canManage ? (
      <form action="/api/share/manage" method="post" class="card">
        <input type="hidden" name="action" value="create" />
        <input type="hidden" name="redirect" value="/dashboard/share" />
        <h2 class="card-title">Create link</h2>
        <div class="config-row-grid">
          <div class="form-field mb-0">
            <label class="form-label" for="label">Label</label>
            <input class="form-input" id="label" name="label" placeholder="Family live view" />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="scope">Scope</label>
            <select class="form-input" id="scope" name="scope">
              <option value="live">Live sensors</option>
              <option value="history">History (7-day chart)</option>
              <option value="metrics">Metrics (Prometheus / Grafana)</option>
            </select>
            <p class="form-hint">
              Metrics links expose scrape URLs at <code>/api/share/&lt;token&gt;/readings?format=prometheus</code>.
              Pro API keys are also available below.
            </p>
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="expires_days">Expires</label>
            <select class="form-input" id="expires_days" name="expires_days">
              <option value="0">Never (household)</option>
              <option value="2">2 days</option>
              <option value="7">7 days (guest / renter)</option>
              <option value="14">14 days</option>
              <option value="30">30 days</option>
            </select>
            <p class="form-hint">Use 7 days for a temporary Airbnb or landlord visit. Revoke anytime.</p>
          </div>
        </div>
        <button class="btn-primary mt-4" type="submit">Create</button>
      </form>
    ) : (
      <section class="card">
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          Share link creation requires editor access.
        </p>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">Your links</h2>
      {(links ?? []).length === 0 ? (
        <p class="mb-0">No share links yet.</p>
      ) : (
        <ul class="space-y-4">
          {(links ?? []).map((link) => {
            const href = `${siteUrl}/share/${link.token}`;
            const isNew = newToken === link.token;
            const expired =
              Boolean(link.expires_at) &&
              Date.parse(link.expires_at as string) <= Date.now();
            return (
              <li
                class:list={[
                  "flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between rounded-xl p-3",
                  isNew && "share-link-new",
                  expired && "share-link-expired",
                ]}
                id={isNew ? "share-link-highlighted" : undefined}
              >
                <div>
                  <strong>{link.label || link.scope}</strong>
                  {isNew && <span class="feed-health-ok ml-2">New</span>}
                  {expired && <span class="feed-health-error ml-2">Expired</span>}
                  <p class="m-0 text-sm break-all">
                    {expired ? (
                      <span class="text-[var(--color-text-muted)]">{href}</span>
                    ) : (
                      <a href={href}>{href}</a>
                    )}
                  </p>
                  <p class="m-0 text-sm text-[var(--color-text-muted)]">
                    Scope: {link.scope}
                    {link.expires_at
                      ? expired
                        ? ` · Expired ${new Date(link.expires_at).toLocaleDateString()}`
                        : ` · Expires ${new Date(link.expires_at).toLocaleDateString()}`
                      : " · No expiry"}
                  </p>
                  {link.scope === "live" && !expired && (
                    <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">
                      Embed: {siteUrl}/embed/{link.token}
                    </p>
                  )}
                  {link.scope === "metrics" && !expired && (
                    <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">
                      Scrape: {siteUrl}/api/share/{link.token}/readings?format=prometheus
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap gap-2">
                  {!expired && (
                    <button
                      type="button"
                      class="btn-secondary"
                      data-copy={href}
                      data-copy-label="Copy link"
                    >
                      Copy link
                    </button>
                  )}
                  <form action="/api/share/manage" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={link.id} />
                    <input type="hidden" name="redirect" value="/dashboard/share" />
                    <button class="btn-ghost" type="submit" onclick="return confirm('Revoke this share link?');">
                      {expired ? "Remove" : "Revoke"}
                    </button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    {entitlements.canCreateShareLinks && canManage && (
      <section class="card">
        <h2 class="card-title">Public status pages</h2>
        <p class="card-subtitle mb-4">
          Minimal read-only status board at <code>/status/&lt;token&gt;</code> — no login required.
        </p>
        {statusToken && (
          <div class="ingest-key-callout mb-4">
            <p class="ingest-key-value break-all text-sm mb-2">{siteUrl}/status/{statusToken}</p>
            <button type="button" class="btn-primary" data-copy={`${siteUrl}/status/${statusToken}`} data-copy-label="Copy link">
              Copy status URL
            </button>
          </div>
        )}
        <form action="/api/status/manage" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
          <input type="hidden" name="action" value="create" />
          <input type="hidden" name="redirect" value="/dashboard/share" />
          <div class="form-field mb-0">
            <label class="form-label" for="status-label">Label</label>
            <input class="form-input" id="status-label" name="label" value="Household status" />
          </div>
          <button class="btn-secondary" type="submit">Create status page</button>
        </form>
        {statusPages.length === 0 ? (
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">No status pages yet.</p>
        ) : (
          <ul class="space-y-3">
            {statusPages.map((page) => (
              <li class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <strong>{page.label}</strong>
                  <p class="m-0 text-sm break-all">
                    <a href={`${siteUrl}/status/${page.token}`}>{siteUrl}/status/{page.token}</a>
                  </p>
                </div>
                <form action="/api/status/manage" method="post">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="id" value={page.id} />
                  <input type="hidden" name="redirect" value="/dashboard/share" />
                  <button class="btn-ghost" type="submit">Revoke</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {entitlements.canCreateShareLinks && canManage && (
      <section class="card">
        <h2 class="card-title">Dashboard API keys</h2>
        <p class="card-subtitle mb-4">
          Scrape Prometheus metrics with <code>Authorization: Bearer &lt;key&gt;</code> at
          <code>/api/v1/metrics</code>.
        </p>
        {newApiKey && (
          <div class="ingest-key-callout mb-4">
            <p class="ingest-key-value break-all text-sm mb-2">{newApiKey}</p>
            <button type="button" class="btn-primary" data-copy={newApiKey} data-copy-label="Copy key">
              Copy key
            </button>
          </div>
        )}
        <form action="/api/api-keys" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
          <input type="hidden" name="action" value="create" />
          <input type="hidden" name="redirect" value="/dashboard/share" />
          <div class="form-field mb-0">
            <label class="form-label" for="api-key-name">Name</label>
            <input class="form-input" id="api-key-name" name="name" value="Metrics key" />
          </div>
          <button class="btn-secondary" type="submit">Create API key</button>
        </form>
        {apiKeys.length === 0 ? (
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">No active API keys.</p>
        ) : (
          <ul class="space-y-3">
            {apiKeys.map((key) => (
              <li class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <strong>{key.name}</strong>
                  <span class="text-sm text-[var(--color-text-muted)]"> · {key.key_prefix}…</span>
                </div>
                <form action="/api/api-keys" method="post">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="id" value={key.id} />
                  <input type="hidden" name="redirect" value="/dashboard/share" />
                  <button class="btn-ghost" type="submit">Revoke</button>
                </form>
              </li>
            ))}
          </ul>
        )}
        <p class="mt-4 mb-0 text-sm">
          <a class="text-link" href="/grafana/thermaltrace-dashboard.json" download>
            Download Grafana dashboard JSON
          </a>
        </p>
      </section>
    )}

    {!entitlements.canUseOutboundWebhook && (
      <UpgradeNudge feature="webhooks" tier={entitlements.tier} />
    )}

    {entitlements.canUseOutboundWebhook && (
      <section class="card" id="inbound-webhooks">
        <h2 class="card-title">Inbound webhooks</h2>
        <p class="card-subtitle mb-4">
          Let Home Assistant or Zapier POST to ThermalTrace. Actions:
          <code>snooze</code>, <code>vacation</code>, <code>clear_snooze</code>, <code>clear_vacation</code>, <code>status</code>.
          Example: <code>{`{"action":"snooze","hours":24}`}</code> to <code>POST /api/inbound/&lt;token&gt;</code>.
        </p>
        {!canManage && (
          <p class="alert-warning mb-4" role="status">View-only — cannot create or revoke inbound webhooks.</p>
        )}
        {inboundToken && (
          <div class="ingest-key-callout mb-4">
            <p class="text-sm mb-2">New webhook URL (copy now):</p>
            <p class="ingest-key-value break-all text-sm mb-2">{siteUrl}/api/inbound/{inboundToken}</p>
            {inboundSigningSecret && (
              <>
                <p class="text-sm mb-2">Signing secret (for X-GarageTemp-Signature, copy now):</p>
                <p class="ingest-key-value break-all text-sm mb-2">{inboundSigningSecret}</p>
              </>
            )}
            <button type="button" class="btn-primary" data-copy={`${siteUrl}/api/inbound/${inboundToken}`} data-copy-label="Copy URL">
              Copy URL
            </button>
          </div>
        )}
        {canManage && (
        <form action="/api/inbound-webhooks" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
          <input type="hidden" name="action" value="create" />
          <input type="hidden" name="redirect" value="/dashboard/share" />
          <div class="form-field mb-0">
            <label class="form-label" for="inbound-name">Name</label>
            <input class="form-input" id="inbound-name" name="name" value="HA automation" />
          </div>
          <button class="btn-secondary" type="submit">Create inbound webhook</button>
        </form>
        )}
        {inboundWebhooks.length === 0 ? (
          <p class="mb-0 text-sm text-[var(--color-text-muted)]">No inbound webhooks yet.</p>
        ) : (
          <ul class="space-y-3">
            {inboundWebhooks.map((wh) => (
              <li class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <strong>{wh.name}</strong>
                  <span class="text-sm text-[var(--color-text-muted)]"> · {wh.token_prefix}…</span>
                </div>
                <form action="/api/inbound-webhooks" method="post">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="webhook_id" value={wh.id} />
                  <input type="hidden" name="redirect" value="/dashboard/share" />
                  <button class="btn-ghost" type="submit">Revoke</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <section class="card">
      <h2 class="card-title">Ingest stats (7 days)</h2>
      <p class="card-subtitle mb-4">
        Daily POST success and error counts per push device.
        {ingestStats.length === 0 && " No ingest activity recorded yet — POST from a push device to populate."}
      </p>
      {ingestStats.length > 0 && (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">Device</th>
                <th class="py-2 pr-3">Day</th>
                <th class="py-2 pr-3">OK</th>
                <th class="py-2">Errors</th>
              </tr>
            </thead>
            <tbody>
              {ingestStats.slice(0, 20).map((row) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3">{row.device_name}</td>
                  <td class="py-2 pr-3">{row.day}</td>
                  <td class="py-2 pr-3">{row.success_count}</td>
                  <td class="py-2">{row.error_count}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <GrafanaWizard
      siteUrl={siteUrl}
      apiKeyPrefix={apiKeys[0]?.key_prefix ?? null}
      apiKey={newApiKey}
    />

    {entitlements.canUseOutboundWebhook && (
      <WebhookDeliveryLog deliveries={webhookDeliveries} />
    )}

    <ZapierSetupCard
      siteUrl={siteUrl}
      inboundWebhookUrl={
        inboundToken ? `${siteUrl}/api/inbound/${inboundToken}` : null
      }
      hasInboundWebhook={inboundWebhooks.length > 0 || Boolean(inboundToken)}
    />

    <HaSetupCard
      siteUrl={siteUrl}
      apiKey={newApiKey}
      inboundWebhookUrl={
        inboundToken ? `${siteUrl}/api/inbound/${inboundToken}` : null
      }
    />

    <section class="card">
      <h2 class="card-title">Recent activity</h2>
      {activity.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          Household actions (share links, alert saves, device transfers) will appear here.
        </p>
      ) : (
        <ul class="space-y-2 mb-0 text-sm">
          {activity.map((row) => (
            <li>
              <strong>{row.action}</strong>
              {row.detail ? `: ${row.detail}` : ""}
              <span class="text-[var(--color-text-muted)]">
                {" · "}
                {new Date(row.created_at).toLocaleString()}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Export your data</h2>
      <p class="card-subtitle mb-3">Download preferences, alert settings, history sample, and devices as JSON.</p>
      <a class="btn-secondary" href="/api/user/export">Download export.json</a>
    </section>
  </div>
</DashboardLayout>

{newHref && (
  <script is:inline>
    (() => {
      const el = document.getElementById("new-share-link");
      el?.scrollIntoView({ behavior: "smooth", block: "start" });
    })();
  </script>
)}
