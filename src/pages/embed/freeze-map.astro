---
export const prerender = false;

import { listLatestFreezeMapSnapshots } from "../../lib/freezeMap";
import { formatRelativeAge } from "../../lib/relativeTime";

const snapshots = await listLatestFreezeMapSnapshots();
const visible = snapshots.filter((row) => row.sample_count >= 3);
const capturedAt = snapshots[0]?.captured_at ?? null;
const captureAge = formatRelativeAge(capturedAt, "not yet");
const compact = Astro.url.searchParams.get("compact") === "1";

const coldest = [...visible]
  .filter((row) => row.min_temp_f != null)
  .sort((a, b) => (a.min_temp_f ?? 999) - (b.min_temp_f ?? 999))
  .slice(0, 3);

const mapPins = visible
  .filter((row) => row.lat != null && row.lon != null)
  .map((row) => ({
    lat: row.lat!,
    lon: row.lon!,
    label: row.city_label,
    avg: row.avg_temp_f,
    riskPct:
      row.sample_count > 0
        ? Math.round((row.freeze_risk_count / row.sample_count) * 100)
        : 0,
  }));
const mapPinsJson = JSON.stringify(mapPins);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Freeze map embed</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
        --border: #ccc;
        --muted: #666;
      }
      body { margin: 0; padding: 12px; background: transparent; }
      h1 { font-size: 1rem; margin: 0 0 8px; }
      p { font-size: 0.85rem; color: var(--muted); margin: 0 0 12px; }
      .map-wrap { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; min-height: 220px; }
      .map-wrap.compact { min-height: 160px; }
      table { width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-top: 12px; }
      th, td { text-align: left; padding: 6px 8px; border-top: 1px solid var(--border); }
      a { color: inherit; }
      .coldest { font-size: 0.8rem; margin: 0 0 10px; padding: 0; list-style: none; }
      .coldest li { margin: 0 0 4px; }
    </style>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </head>
  <body>
    <h1>Garage freeze-risk map</h1>
    <p>Opt-in city aggregates · updated {captureAge.label}</p>
    {coldest.length > 0 && (
      <ul class="coldest">
        {coldest.map((row, i) => (
          <li>
            <strong>#{i + 1} {row.city_label}</strong> · min {row.min_temp_f?.toFixed(1)}°F
          </li>
        ))}
      </ul>
    )}
    <div id="embed-freeze-map" class:list={["map-wrap", compact && "compact"]}></div>
    {!compact && visible.length > 0 && (
      <table>
        <thead>
          <tr><th>City</th><th>Avg °F</th><th>Risk</th></tr>
        </thead>
        <tbody>
          {visible.slice(0, 8).map((row) => (
            <tr>
              <td>{row.city_label}</td>
              <td>{row.avg_temp_f?.toFixed(1) ?? "—"}</td>
              <td>{row.sample_count > 0 ? `${Math.round((row.freeze_risk_count / row.sample_count) * 100)}%` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    <p style="margin-top:12px">
      <a href="/freeze-map" target="_blank" rel="noopener">Full map on ThermalTrace</a>
    </p>
    <script is:inline define:vars={{ mapPinsJson }}>
      (() => {
        const pins = JSON.parse(mapPinsJson);
        function init() {
          const el = document.getElementById("embed-freeze-map");
          if (!el || typeof L === "undefined") return;
          const map = L.map(el, { scrollWheelZoom: false }).setView([39.5, -98.35], 4);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "© OpenStreetMap",
            maxZoom: 18,
          }).addTo(map);
          for (const pin of pins) {
            const color = pin.riskPct >= 50 ? "#dc2626" : pin.riskPct >= 25 ? "#f59e0b" : "#16a34a";
            L.circleMarker([pin.lat, pin.lon], {
              radius: 8,
              fillColor: color,
              color: "#fff",
              weight: 1,
              fillOpacity: 0.85,
            })
              .bindPopup(`<strong>${pin.label}</strong><br/>${pin.avg?.toFixed(1) ?? "—"}°F · ${pin.riskPct}% at risk`)
              .addTo(map);
          }
          if (pins.length > 0) {
            map.fitBounds(pins.map((p) => [p.lat, p.lon]), { padding: [20, 20], maxZoom: 6 });
          }
        }
        if (typeof L !== "undefined") init();
        else window.addEventListener("load", init);
      })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  </body>
</html>
