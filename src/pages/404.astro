---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { BRAND_NAME } from "../lib/brand";
---
<Layout title="Page not found" description={`That page is not on ${BRAND_NAME}.`}>
  <div class="page-shell page-stack">
    <section class="card">
      <h1 class="card-title">Page not found</h1>
      <p class="card-subtitle mb-4">
        That URL isn’t on ThermalTrace — it may have moved, or the link is out of date.
      </p>
      <p class="mb-4 flex flex-wrap gap-3">
        <a class="btn-primary" href="/">Home</a>
        <a class="btn-secondary" href="/about">Guides</a>
        <a class="btn-secondary" href="/dashboard">Dashboard</a>
      </p>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        Looking for freeze alerts or ingest docs?
        <a class="text-link" href="/about/ingest-and-webhooks">Ingest &amp; webhooks</a>
        ·
        <a class="text-link" href="/contact">Contact</a>
      </p>
    </section>
  </div>
</Layout>
