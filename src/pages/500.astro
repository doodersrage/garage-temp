---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
---
<Layout title="Something went wrong" description="An unexpected error occurred." noindex>
  <div class="page-shell page-stack">
    <section class="card">
      <h1 class="card-title">Something went wrong</h1>
      <p class="card-subtitle mb-4">
        We hit an unexpected error loading this page. The incident was logged automatically.
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/">Back to home</a>
        {" "}
        <a class="text-link" href="/system-status">System status</a>
      </p>
    </section>
  </div>
</Layout>
