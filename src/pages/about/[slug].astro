---
import AboutArticle from "../../components/AboutArticle.astro";
import AboutPageSections from "../../components/AboutPageSections.astro";
import { getAboutPage } from "../../lib/aboutPages";
import { getExpandedAboutContent } from "../../lib/aboutExpandedContent";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/about");
}

const page = getAboutPage(slug);
const sections = getExpandedAboutContent(slug);

if (!page || !sections) {
  return Astro.redirect("/about");
}
---
<AboutArticle slug={page.slug} title={page.title} description={page.description}>
  <AboutPageSections sections={sections} />
</AboutArticle>
