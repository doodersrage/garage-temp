---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AboutHubNav from "../../components/AboutHubNav.astro";
import AboutProbeActivity from "../../components/AboutProbeActivity";
import AboutSearch from "../../components/AboutSearch";
import {
  getBreadcrumbSchema,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { aboutPages } from "../../lib/aboutPages";
import "../../styles/about.css";

const title = "About Garage Temperature Monitor";
const description =
  "Guides on temperature probes, historical data, Arduino firmware, Python feeds, Astro, Node.js, and the full monitoring stack behind this site.";

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
];

const guideCount = aboutPages.filter((page) => page.parentSlug).length;
---
<Layout title="About" description={description} schema={schema} skipAuth>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="About"
      title={title}
      lede="Live sensor readings, local weather, saved history, and the technology behind the project — from Arduino probes to the Astro dashboard."
    >
      <a slot="actions" class="btn-primary" href="/about/temperature-probe-case-study">Read the case study</a>
      <a slot="actions" class="btn-secondary" href="/about/probe-demo">Open probe demo</a>
    </PageHeader>

    <section class="card">
      <div class="about-prose">
        <p>
          Garage Temperature Monitor combines Arduino probes, JSON feeds, and a modern web dashboard
          so you can see current conditions, compare them with outdoor weather, and review trends over time.
        </p>
        <p>
          The guides below follow four learning paths—{guideCount} focused articles plus twelve topic
          overviews—covering probes, physics, historical data, firmware, backend scripts, and this website.
        </p>
      </div>
    </section>

    <section class="about-probe-hero">
      <div class="about-probe-hero-shell card overflow-hidden p-0">
        <div class="about-probe-hero-intro">
          <p class="about-probe-hero-eyebrow">Live simulation</p>
          <h2 class="about-probe-hero-title">Three probes, one garage</h2>
          <p class="about-probe-hero-lede">
            Watch temperature and humidity shift as sun load, outdoor air, and the door cycle change
            conditions zone by zone—just like the live JSON feed.
          </p>
        </div>
        <AboutProbeActivity client:visible />
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Search the guides</h2>
      <p class="card-subtitle">Find a topic across {guideCount + 12} articles.</p>
      <AboutSearch client:visible pages={aboutPages} />
    </section>

    <AboutHubNav />

    <section class="card">
      <h2 class="card-title">Open-source repositories</h2>
      <p class="card-subtitle">Projects you can inspect, fork, or adapt for your own build.</p>
      <div class="about-prose">
        <ul>
          <li>
            Arduino sketch and sensor firmware:
            <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
              arduino-network-json-temperature-sever
            </a>
          </li>
          <li>
            This website (Astro on Cloudflare):
            <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/garage-temp">
              garage-temp
            </a>
          </li>
          <li>
            JSON feed relay (FastAPI with Redis caching):
            <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/fast-api-relay">
              fast-api-relay
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
