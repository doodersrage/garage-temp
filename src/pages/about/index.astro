---

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AboutQuickStart from "../../components/AboutQuickStart.astro";
import AboutJourneys from "../../components/AboutJourneys.astro";
import AboutHubNav from "../../components/AboutHubNav.astro";
import AboutProbeActivity from "../../components/AboutProbeActivity";
import AboutSearch from "../../components/AboutSearch";
import {
  getBreadcrumbSchema,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { aboutPages, getAboutStats } from "../../lib/aboutPages";
import { buildAboutSearchIndex } from "../../lib/aboutSearchIndex";
import { getFeaturedAboutPages } from "../../lib/aboutNavigation";
import "../../styles/about.css";

const title = "About ThermalTrace";
const description =
  "Guides on temperature probes, freeze alerts, Arduino firmware, ESP ingest, household sharing, and the monitoring stack behind ThermalTrace.";

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
];

const stats = getAboutStats();
const featuredPages = getFeaturedAboutPages();
const searchIndex = buildAboutSearchIndex(aboutPages);
const featuredSearchIndex = buildAboutSearchIndex(featuredPages);
---
<Layout title="About" description={description} schema={schema} skipAuth>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="About"
      title={title}
      lede="Open-source guides on probes, freeze alerts, firmware, and the stack behind ThermalTrace—organized by the job you need done."
    >
      <a slot="actions" class="btn-primary" href="/register">Start free</a>
      <a slot="actions" class="btn-secondary" href="#about-journeys-title">Choose a path</a>
    </PageHeader>

    <AboutJourneys />

    <AboutQuickStart />

    <section class="card about-browse">
      <h2 class="card-title">Find a guide</h2>
      <p class="card-subtitle">
        Search {stats.totalCount} articles or browse by learning path below.
      </p>
      <AboutSearch client:visible pages={searchIndex} featured={featuredSearchIndex} />
    </section>

    <AboutHubNav />

    <section class="about-probe-hero">
      <div class="about-probe-hero-shell card overflow-hidden p-0">
        <div class="about-probe-hero-intro">
          <p class="about-probe-hero-eyebrow">Live simulation</p>
          <h2 class="about-probe-hero-title">Three probes, one space</h2>
          <p class="about-probe-hero-lede">
            Watch temperature and humidity shift as sun load, outdoor air, and airflow change
            conditions zone by zone—just like the live JSON feed.
          </p>
        </div>
        <AboutProbeActivity client:visible />
      </div>
    </section>

    <section class="card about-repos">
      <h2 class="card-title">Open-source repositories</h2>
      <p class="card-subtitle">Projects you can inspect, fork, or adapt for your own build.</p>
      <ul class="about-repos-list">
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
            <strong>arduino-network-json-temperature-sever</strong>
            <span>Arduino sketch and sensor firmware</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/garage-temp">
            <strong>garage-temp</strong>
            <span>This website (Astro on Cloudflare)</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/fast-api-relay">
            <strong>fast-api-relay</strong>
            <span>JSON feed relay (FastAPI with Redis caching)</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
