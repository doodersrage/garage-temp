---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProbeDemo from "../../components/ProbeDemo";
import FaqSection from "../../components/FaqSection.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { getAboutFaqs } from "../../lib/aboutFaqs";
import { BRAND_SPACES } from "../../lib/brand";
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import "../../styles/about.css";

const title = "Interactive probe demo";
const description =
  `Simulate multi-zone temperatures in ${BRAND_SPACES}. Adjust outdoor air, sun load, door state, and freeze threshold — see the same space-status logic and push/pull JSON shapes ThermalTrace uses in production.`;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/about/probe-demo");
const faqs = getAboutFaqs("probe-demo");
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: title,
    description,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
    { name: title, path: "/about/probe-demo" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="About · Simulator"
      title={title}
      lede={description}
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/temperature">
        Start free
      </a>
      <a slot="actions" class="btn-secondary" href="/demo">
        Live demo feed
      </a>
    </PageHeader>

    <AboutCcFigure photoId="garage-workbench" />

    <section class="card about-prose">
      <p class="mb-0">
        Readings refresh every two seconds with small sensor-like noise. Use
        <strong>Cold snap</strong> to see Overview-style freeze risk, then flip to
        <strong>Push ingest</strong> JSON — the same flat keys an ESP would POST after you create a
        device. For placement theory, see
        <a class="text-link" href="/about/temperature-probes">temperature probes</a>
        and
        <a class="text-link" href="/about/temperature-changes">what drives swings</a>.
      </p>
    </section>

    <ProbeDemo client:visible />

    <FaqSection faqs={faqs} title="Probe demo FAQ" />

    <nav class="card about-pagination" aria-label="About section pages">
      <a class="btn-secondary" href="/about/temperature-probes">
        <span class="btn-icon btn-icon--start" aria-hidden="true">←</span>
        Temperature probes guide
      </a>
      <a class="btn-secondary" href="/about/adding-devices">
        Adding devices
        <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Layout>
