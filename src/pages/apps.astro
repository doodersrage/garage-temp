---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import { COMPANION_APPS, COMPANION_APPS_HUB_PATH } from "../lib/companionApps";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, COMPANION_APPS_HUB_PATH);
const faqs = getMarketingFaqs("apps");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Apps", path: COMPANION_APPS_HUB_PATH },
  ]),
  getMarketingFaqSchema(pageUrl, "apps"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Companion apps"
  description={`Watch ${BRAND_NAME} from Android, desktop, Bay Buddy, or the PWA. These clients sign into your account; they do not sense temperature.`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Apps"
      title="Companion apps"
      lede={`${BRAND_NAME} clients for phone and desk. Probes stay on ESP/Arduino (or HTTPS feeds); apps sign in and show live freeze and flood risk for your household.`}
    >
      <a slot="actions" class="btn-primary" href="/android">Android</a>
      <a slot="actions" class="btn-secondary" href="/desktop">Desktop</a>
      <a slot="actions" class="btn-ghost" href="/bay-buddy">Bay Buddy</a>
    </PageHeader>

    <section class="grid gap-4 sm:grid-cols-2">
      {COMPANION_APPS.map((app) => (
        <article class="card h-full flex flex-col">
          <h2 class="card-title">{app.name}</h2>
          <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-2">
            {app.platform}
          </p>
          <p class="text-sm mb-4 flex-1">{app.summary}</p>
          <a class="btn-secondary self-start" href={app.path}>{app.cta}</a>
        </article>
      ))}
    </section>

    <section class="card">
      <h2 class="card-title">Hardware vs apps</h2>
      <p class="mb-0 text-sm">
        Need a claim puck, leak pad, or mount?
        {" "}
        <a class="text-link" href="/accessories">Hardware accessories</a>
        {" "}
        cover companion devices. Temperature kits stay on the
        {" "}
        <a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>.
      </p>
    </section>

    <FaqSection
      title="Apps FAQ"
      faqs={faqs}
      lede="Which client to install, and how they relate to probes and the web dashboard."
    />
  </div>
</Layout>
