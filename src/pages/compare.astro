---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlanComparisonTable from "../components/PlanComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/compare");
const compareFaqs = getMarketingFaqs("compare");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Compare", path: "/compare" },
  ]),
  getMarketingFaqSchema(pageUrl, "compare"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Compare monitoring options"
  description="ThermalTrace vs DIY scripts and generic IoT apps for garage freeze alerts, ESP/Arduino ingest, history export, and household sharing—without running your own servers."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Compare"
      title="Built for homeowners, not home servers"
      lede="ThermalTrace is for live probe temperature curves, freeze alerts, and optional SMS — without running your own infrastructure."
    >
      <a slot="actions" class="btn-primary" href="/pricing">See plans &amp; pricing</a>
      <a slot="actions" class="btn-secondary" href="/register">Start free</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">ThermalTrace vs alternatives</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">ThermalTrace compared to DIY scripts and generic IoT apps</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">ThermalTrace</th>
              <th scope="col">DIY script + cron</th>
              <th scope="col">Generic IoT app</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Freeze alerts (email/SMS/push)</th>
              <td>Built-in, per-household</td>
              <td>You wire Twilio + cron</td>
              <td>Varies; often push-only</td>
            </tr>
            <tr>
              <th scope="row">ESP/Arduino push ingest</th>
              <td>One-time device key</td>
              <td>Custom endpoint</td>
              <td>Often cloud-vendor lock-in</td>
            </tr>
            <tr>
              <th scope="row">History & CSV export</th>
              <td>Member+</td>
              <td>Self-hosted DB</td>
              <td>Subscription tiers</td>
            </tr>
            <tr>
              <th scope="row">Share links & Grafana</th>
              <td>Pro</td>
              <td>Manual setup</td>
              <td>Rare on consumer apps</td>
            </tr>
            <tr>
              <th scope="row">Household multi-user</th>
              <td>Free</td>
              <td>N/A</td>
              <td>Family plans extra</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Who it's for</h2>
      <ul class="text-sm space-y-2 mb-4">
        <li><strong>Free</strong> — one garage, live charts, email/chat alerts while you evaluate.</li>
        <li><strong>Member</strong> — CSV history and more devices through a cold season.</li>
        <li><strong>Pro</strong> — SMS, push, share links, and webhooks when someone needs to wake up at 2 a.m.</li>
      </ul>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/register">Start free — no card required</a>
        <a class="btn-secondary" href="/pricing">See plan prices</a>
        <a class="btn-ghost" href="/stories/garage-freeze-alert">Read a freeze case study</a>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Full feature matrix</h2>
      <p class="card-subtitle mb-4">Every entitlement at a glance — then pick a plan on pricing.</p>
      <PlanComparisonTable />
      <p class="mt-4 mb-0 flex flex-wrap gap-3">
        <a class="btn-primary" href="/pricing">Go to pricing</a>
        <a class="btn-secondary" href="/register">Create free account</a>
      </p>
    </section>

    <FaqSection faqs={compareFaqs} />
  </div>
</Layout>
