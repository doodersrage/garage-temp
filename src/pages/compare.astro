---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlanComparisonTable from "../components/PlanComparisonTable.astro";
---
<Layout
  title="Compare garage monitors"
  description="How Garage Temp compares to DIY scripts, Weather Underground, and generic IoT platforms for freeze alerts and history."
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Compare"
      title="Built for homeowners, not home servers"
      lede="Garage Temp is for live garage temperatures, freeze alerts, and optional SMS — without running your own infrastructure."
    >
      <a slot="actions" class="btn-primary" href="/pricing">See plans &amp; pricing</a>
      <a slot="actions" class="btn-secondary" href="/register">Start free</a>
      <a slot="actions" class="btn-ghost" href="/stories/garage-freeze-alert">Customer story</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Garage Temp vs alternatives</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[var(--color-text-muted)]">
              <th class="py-2 pr-3">Capability</th>
              <th class="py-2 pr-3">Garage Temp</th>
              <th class="py-2 pr-3">DIY script + cron</th>
              <th class="py-2">Generic IoT app</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3">Freeze alerts (email/SMS/push)</td>
              <td class="py-2 pr-3">Built-in, per-household</td>
              <td class="py-2 pr-3">You wire Twilio + cron</td>
              <td class="py-2">Varies; often push-only</td>
            </tr>
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3">ESP/Arduino push ingest</td>
              <td class="py-2 pr-3">One-time device key</td>
              <td class="py-2 pr-3">Custom endpoint</td>
              <td class="py-2">Often cloud-vendor lock-in</td>
            </tr>
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3">History & CSV export</td>
              <td class="py-2 pr-3">Member+</td>
              <td class="py-2 pr-3">Self-hosted DB</td>
              <td class="py-2">Subscription tiers</td>
            </tr>
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3">Share links & Grafana</td>
              <td class="py-2 pr-3">Pro</td>
              <td class="py-2 pr-3">Manual setup</td>
              <td class="py-2">Rare on consumer apps</td>
            </tr>
            <tr class="border-t border-[var(--color-border)]">
              <td class="py-2 pr-3">Household multi-user</td>
              <td class="py-2 pr-3">Free</td>
              <td class="py-2 pr-3">N/A</td>
              <td class="py-2">Family plans extra</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Who it's for</h2>
      <ul class="text-sm space-y-2 mb-4">
        <li><strong>Free</strong> — one garage, live charts, email/chat alerts while you evaluate.</li>
        <li><strong>Member</strong> — CSV history and more devices through a cold season.</li>
        <li><strong>Pro</strong> — SMS, push, share links, and webhooks when someone needs to wake up at 2 a.m.</li>
      </ul>
      <p class="mb-0">
        <a class="btn-primary" href="/pricing">Compare Free, Member, and Pro</a>
        {" "}
        <a class="text-link" href="/register">Create free account</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Full feature matrix</h2>
      <p class="card-subtitle mb-4">Every entitlement at a glance — then pick a plan.</p>
      <PlanComparisonTable />
      <p class="mt-4 mb-0">
        <a class="btn-primary" href="/pricing">Go to pricing</a>
      </p>
    </section>
  </div>
</Layout>
