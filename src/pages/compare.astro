---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";
import { compareGuides } from "../lib/compareGuides";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/compare");
const compareFaqs = getMarketingFaqs("compare");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Compare", path: "/compare" },
  ]),
  getMarketingFaqSchema(pageUrl, "compare"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Compare monitoring options"
  description="ThermalTrace vs DIY MQTT, Govee, SmartThings, and outdoor weather stations for freeze alerts in unconditioned spaces—without running your own servers."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Compare"
      title="Built for homeowners, not home servers"
      lede="ThermalTrace is for live probe sensors, freeze alerts, and optional SMS — without running your own infrastructure."
    >
      <a slot="actions" class="btn-primary" href="/pricing">See plans &amp; pricing</a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/temperature">Start free</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Detailed comparisons</h2>
      <p class="card-subtitle mb-4">
        Side-by-side guides for common alternatives — ops burden, alerts, and when each option fits.
      </p>
      <ul class="space-y-4 mb-0">
        {compareGuides.map((guide) => (
          <li>
            <a class="text-link font-semibold" href={guide.path}>{guide.title}</a>
            <p class="text-sm text-[var(--color-text-muted)] mt-1 mb-0">{guide.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">ThermalTrace vs alternatives</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">ThermalTrace compared to DIY scripts and Govee or SmartThings</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">ThermalTrace</th>
              <th scope="col">DIY script + cron</th>
              <th scope="col">Govee / SmartThings</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Freeze alerts (email/SMS/push)</th>
              <td>Built-in, per-household</td>
              <td>You wire Twilio + cron</td>
              <td>App push; SMS extra or absent</td>
            </tr>
            <tr>
              <th scope="row">ESP/Arduino push ingest</th>
              <td>One-time device key</td>
              <td>Custom endpoint</td>
              <td>Govee pods / SmartThings devices</td>
            </tr>
            <tr>
              <th scope="row">History & CSV export</th>
              <td>Member+</td>
              <td>Self-hosted DB</td>
              <td>Subscription tiers</td>
            </tr>
            <tr>
              <th scope="row">Share links & Grafana</th>
              <td>Pro</td>
              <td>Manual setup</td>
              <td>Rare on consumer apps</td>
            </tr>
            <tr>
              <th scope="row">Home Assistant (HACS)</th>
              <td><a class="text-link" href="/integrations/home-assistant">Official integration</a> (Pro share link)</td>
              <td>REST sensors + webhooks</td>
              <td>Varies by vendor</td>
            </tr>
            <tr>
              <th scope="row">Household multi-user</th>
              <td>Free</td>
              <td>N/A</td>
              <td>Family sharing is awkward</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Who it's for</h2>
      <ul class="text-sm space-y-2 mb-4">
        <li><strong>Free</strong> — one property, live charts, email/chat alerts while you evaluate.</li>
        <li><strong>Member</strong> — CSV history and more devices through a cold season.</li>
        <li><strong>Pro</strong> — SMS, push, share links, <a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a>, <a class="text-link" href="/claims-pack">claims pack</a>, and webhooks when someone needs to wake up at 2 a.m. See the <a class="text-link" href="/docs/api">HTTP API</a> for ingest and metrics.</li>
      </ul>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/register?next=/dashboard/temperature">Start free — no card required</a>
        <a class="btn-secondary" href="/pricing">See plan prices</a>
        <a class="btn-ghost" href="/stories/garage-freeze-alert">Read a freeze case study</a>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Plan limits live on pricing</h2>
      <p class="card-subtitle mb-4">
        Device counts, retention, and which alerts sit on Free vs Member vs Pro are compared on the pricing page so this page can stay focused on alternatives.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/pricing#plan-matrix">Open the plan comparison</a>
        <a class="btn-secondary" href="/register?next=/dashboard/temperature">Create free account</a>
      </div>
    </section>

    <FaqSection faqs={compareFaqs} />
  </div>
</Layout>
