---
import Layout from "../../layouts/Layout.astro";
import {
  buildMobileOAuthCustomUrl,
  buildMobileOAuthIntentUrl,
} from "../../lib/mobileAuthRedirect";
import {
  buildBayBuddyOAuthCustomUrl,
  buildDesktopOAuthCustomUrl,
  buildLoopbackOAuthUrl,
  consumeCompanionLoopbackCookie,
  getCompanionClientCookie,
  type CompanionClient,
} from "../../lib/companionAuth";

const exchange = Astro.url.searchParams.get("exchange")?.trim() ?? "";
const client = (Astro.url.searchParams.get("client")?.trim().toLowerCase() ||
  getCompanionClientCookie(Astro.cookies) ||
  "android") as CompanionClient;
const isBayBuddy = client === "baybuddy";
const isDesktop = client === "desktop";

const loopback = exchange ? consumeCompanionLoopbackCookie(Astro.cookies) : null;
if (exchange && loopback) {
  return Astro.redirect(buildLoopbackOAuthUrl(loopback, exchange));
}

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const intentUrl =
  exchange && !isBayBuddy && !isDesktop ? buildMobileOAuthIntentUrl(exchange) : "";
const customUrl = exchange
  ? isBayBuddy
    ? buildBayBuddyOAuthCustomUrl(exchange)
    : isDesktop
      ? buildDesktopOAuthCustomUrl(exchange)
      : buildMobileOAuthCustomUrl(exchange)
  : "";
const openHref = intentUrl || customUrl;

const title = isBayBuddy
  ? "Return to Bay Buddy"
  : isDesktop
    ? "Return to ThermalTrace Desktop"
    : "Return to the Android app";
const description = isBayBuddy
  ? "Finish ThermalTrace sign-in by returning to Bay Buddy."
  : isDesktop
    ? "Finish ThermalTrace sign-in by returning to ThermalTrace Desktop."
    : "Finish ThermalTrace sign-in by returning to the Android app.";
const openLabel = isBayBuddy
  ? "Open Bay Buddy"
  : isDesktop
    ? "Open ThermalTrace Desktop"
    : "Open ThermalTrace";
const handoffHint = isBayBuddy
  ? " If Bay Buddy is waiting, it should pick up automatically. If not, tap the button below."
  : isDesktop
    ? " If ThermalTrace Desktop is waiting on the loopback handoff, it should finish automatically. If not, this page is a fallback — reopen the app and Connect again."
    : " Chrome often stays here after a Google or YubiKey security step: tap the button to return to the app and finish MFA there if needed.";
const closeHint = isBayBuddy
  ? "You can close this tab once Bay Buddy shows your live garage mood."
  : isDesktop
    ? "You can close this tab once ThermalTrace Desktop shows your dashboard."
    : "If nothing happens, use the phone’s back button to return to the app, or open ThermalTrace from your app drawer.";
const missingHint = isBayBuddy
  ? "This page returns you to Bay Buddy after sign-in. Open Bay Buddy and choose Connect again."
  : isDesktop
    ? "This page returns you to ThermalTrace Desktop after sign-in. Open the desktop app and choose Connect again."
    : "This page is only used to return to the Android app after Google sign-in. Open ThermalTrace on your phone and try Google again.";
---
<Layout
  title={title}
  description={description}
  noindex
  skipAuth
  referrerPolicy="no-referrer"
>
  <article class="card max-w-lg mx-auto my-8">
    {
      exchange ? (
        <>
          <h1 class="card-title">{openLabel}</h1>
          <p class="card-subtitle">
            Sign-in finished in the browser.
            {handoffHint}
          </p>
          <p class="mt-4 mb-2">
            <a class="btn-primary" id="open-app" href={openHref}>
              {openLabel}
            </a>
          </p>
          <p class="text-sm text-[var(--color-text-muted)] mb-0">
            {closeHint}
          </p>
          <script is:inline define:vars={{ intentUrl, customUrl }}>
            (() => {
              const go = () => {
                if (intentUrl) {
                  window.location.href = intentUrl;
                  setTimeout(() => {
                    if (customUrl) window.location.href = customUrl;
                  }, 900);
                  return;
                }
                if (customUrl) window.location.href = customUrl;
              };
              setTimeout(go, 250);
              document.getElementById("open-app")?.addEventListener("click", (event) => {
                event.preventDefault();
                go();
              });
            })();
          </script>
        </>
      ) : (
        <>
          <h1 class="card-title">Missing sign-in token</h1>
          <p class="card-subtitle mb-0">
            {missingHint}
          </p>
        </>
      )
    }
  </article>
</Layout>
