---
import Layout from "../layouts/Layout.astro";
import { getAuthFromCookies, setAuthCookies } from "../lib/auth";
import { supabase } from "../lib/supabase";

const code = Astro.url.searchParams.get("code");
const error = Astro.url.searchParams.get("error");

if (code) {
  const { data, error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);

  if (!exchangeError && data.session) {
    setAuthCookies(Astro.cookies, data.session.access_token, data.session.refresh_token);
    return Astro.redirect("/reset-password");
  }
}

const { session } = await getAuthFromCookies(Astro.cookies);
const errorMessage =
  error === "weak"
    ? "Password must be at least 8 characters."
    : error === "mismatch"
      ? "Passwords do not match."
      : error === "session"
        ? "Your reset session expired. Request a new link."
        : error === "update"
          ? "Could not update password. Try again."
          : null;
---

<Layout
  title="Reset password"
  description="Choose a new password for your ThermalTrace account."
  noindex
>
  <div class="page-shell page-grid items-start">
    <section class="card animate-zoom-in">
      <h1 class="card-title">Choose a new password</h1>
      <p class="card-subtitle">
        {session
          ? "Enter and confirm your new password below."
          : "Open the reset link from your email to continue."}
      </p>

      {!session ? (
        <div class="empty-state">
          <p class="m-0">
            This page needs a valid reset link.
            <a class="text-link" href="/forgot-password">Request a new one</a>.
          </p>
        </div>
      ) : (
        <form class="form-panel" action="/api/auth/update-password" method="post">
          {errorMessage && (
            <div class="alert-warning mb-4" role="alert">
              <p class="m-0">{errorMessage}</p>
            </div>
          )}
          <div class="form-field">
            <label class="form-label" for="password">New password</label>
            <input class="form-input" type="password" name="password" id="password" minlength="8" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="confirm">Confirm password</label>
            <input class="form-input" type="password" name="confirm" id="confirm" minlength="8" required />
          </div>
          <button class="btn-primary" type="submit">Update password</button>
        </form>
      )}
    </section>
  </div>
</Layout>
