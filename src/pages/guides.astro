---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import EditorialPhotoStrip from "../components/EditorialPhotoStrip.astro";
import { getGuideHubCategories, guideHubCategoryTitle } from "../lib/guideHub";
import { guidesHubPhotos } from "../lib/aboutPhotos";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const categories = getGuideHubCategories();
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/guides");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
  ]),
];

const stripPhotoIds = guidesHubPhotos.map((p) => p.id);
const stripLabels = guidesHubPhotos.map((p) => p.label);
const stripHrefs = guidesHubPhotos.map((p) => p.href);
---
<Layout
  title="Guides"
  description="ThermalTrace guides by job: hardware setup, freeze and flood/leak alerts, household sharing, and the HTTP API — plus all articles in one library."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Guides"
      title="Set up probes, freeze/flood alerts, sharing, and the API"
      lede="Start with the job you need done. Hardware, freeze and flood/leak alerts, household sharing, and ingest/API docs in one place — then browse all articles if you want every guide."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/temperature">Start free</a>
      <a slot="actions" class="btn-secondary" href="/about">All articles</a>
    </PageHeader>

    <EditorialPhotoStrip
      photoIds={stripPhotoIds}
      labels={stripLabels}
      hrefs={stripHrefs}
    />

    <div class="guide-hub-grid">
      {categories.map((category) => (
        <section class="card guide-hub-category" id={category.id} aria-labelledby={`guide-${category.id}`}>
          <h2 class="card-title" id={`guide-${category.id}`}>{category.title}</h2>
          <p class="card-subtitle mb-4">{category.description}</p>
          <ul class="guide-hub-list">
            {category.links.map((link) => (
              <li>
                <a class="guide-hub-link" href={link.href}>
                  <span class="guide-hub-link-title">{link.label}</span>
                  <span class="guide-hub-link-summary">{link.summary}</span>
                </a>
                {link.alsoIn && link.alsoIn.length > 0 && (
                  <p class="guide-hub-also">
                    Also relevant to:{" "}
                    {link.alsoIn.map((id, i) => (
                      <span>
                        {i > 0 ? ", " : ""}
                        <a class="text-link" href={`/guides#${id}`}>{guideHubCategoryTitle(id)}</a>
                      </span>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
