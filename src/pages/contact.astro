---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import ContactForm from "../components/ContactForm"
---
<html>
    <head>
        <script is:inline src="https://www.google.com/recaptcha/api.js"></script>
    </head>
    <body>
        <Layout>
            <div class="flex flex-wrap justify-center max-w-6xl mx-auto">
                 <div class="w-full sm:w-1/2 md:w-1/2 lg:w-1/2 px-4">
                    <div class="copy-wrap animate-zoom-in">
                        <h1 class="text-3xl font-bold mb-4">Contact Us</h1>
                        <p class="mb-4">Feel free to reach out to us with any questions or feedback!</p>
                    </div>
                </div>
                <div class="w-full sm:w-1/2 md:w-1/2 lg:w-1/2 p-4 animate-blurred-fade-in">
                    <ContactForm client:load />
                </div>
            </div>
        </Layout>

    </body>
</html>