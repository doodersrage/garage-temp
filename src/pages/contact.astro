---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/contact");
const contactFaqs = getMarketingFaqs("contact");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
  getMarketingFaqSchema(pageUrl, "contact"),
].filter(Boolean) as Record<string, unknown>[];
---

<Layout
  title="Contact"
  description="Contact ThermalTrace about garage probes, Arduino/ESP ingest, freeze alerts, billing, or dashboard help—or start with the About guides."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Contact"
      title="Get in touch"
      lede="Building, debugging, or adapting garage monitoring? We read every message and reply as soon as we can."
    >
      <a slot="actions" class="btn-secondary" href="/about">Browse the guides</a>
    </PageHeader>

    <div class="page-grid items-start">
      <div class="page-stack page-stack-tight">
        <section class="card">
          <h2 class="card-title">How we can help</h2>
          <ul class="grid gap-2 pl-5 leading-relaxed [list-style:disc] mb-0">
            <li>Probe placement, averaging, or unexplained temperature swings</li>
            <li>Arduino firmware, wiring, or getting JSON feeds online</li>
            <li>Dashboard setup, history, CSV export, or account questions</li>
            <li>Android / Play listing questions or a launch-note request</li>
            <li>Feedback, feature ideas, or collaboration on the open-source repos</li>
          </ul>
        </section>

        <section class="card">
          <h2 class="card-title">Before you write</h2>
          <p class="card-subtitle mb-0">
            Many answers are already in the
            <a class="text-link" href="/about">about guides</a>,
            <a class="text-link" href="/about/probe-demo">probe demo</a>, and
            <a class="text-link" href="/about/arduino-sketches">Arduino sketches</a>.
            Useful details for a reply: board, sensors, expected vs observed readings, and any feed URLs.
          </p>
        </section>
      </div>

      <ContactForm client:visible />
    </div>

    <FaqSection faqs={contactFaqs} />
  </div>
</Layout>
