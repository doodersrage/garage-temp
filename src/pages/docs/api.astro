---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/docs/api");
const docsFaqs = getMarketingFaqs("docsApi");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "API documentation", path: "/docs/api" },
  ]),
  getMarketingFaqSchema(pageUrl, "docsApi"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="API documentation"
  description="ThermalTrace HTTP API for ESP/Arduino ingest, Prometheus metrics, share-link JSON, and inbound Home Assistant webhooks—plus OpenAPI download."
  schema={schema}
  speakableSelectors={[".card-title", ".card-subtitle", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <section class="card animate-slide-in-left">
      <h1 class="card-title">API documentation</h1>
      <p class="card-subtitle mb-4">
        OpenAPI spec for programmatic integrations. Pro plans include API keys for Prometheus metrics;
        push ingest uses per-device keys from the dashboard.
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/openapi.yaml" download>Download openapi.yaml</a>
        {" "}
        <a class="text-link" href="/dashboard/share">Manage API keys</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Quick reference</h2>
      <dl class="text-sm space-y-3 mb-0">
        <div>
          <dt class="font-semibold">POST /api/ingest/&lt;deviceKey&gt;</dt>
          <dd class="text-[var(--color-text-muted)]">
            Push JSON from ESP/Arduino or any HTTPS client. Kinds include temperature, humidity, CO₂, pressure, PM2.5, VOC, water level, energy, door, power, flood, and motion. Optional top-level <code>battery_pct</code> and <code>rssi</code>.
            Sample sketches:
            <a class="text-link" href="https://github.com/doodersrage/thermaltrace/tree/main/sketches" target="_blank" rel="noreferrer">sketches/</a>.
          </dd>
        </div>
        <div>
          <dt class="font-semibold">GET /api/v1/metrics</dt>
          <dd class="text-[var(--color-text-muted)]">Prometheus scrape target. Header <code>Authorization: Bearer &lt;api-key&gt;</code> (Pro).</dd>
        </div>
        <div>
          <dt class="font-semibold">POST /api/inbound/&lt;token&gt;</dt>
          <dd class="text-[var(--color-text-muted)]">Home Assistant / Zapier actions: snooze, vacation, status. Optional HMAC signature.</dd>
        </div>
        <div>
          <dt class="font-semibold">GET /api/share/&lt;token&gt;/readings</dt>
          <dd class="text-[var(--color-text-muted)]">Public JSON for share links (Pro).</dd>
        </div>
      </dl>
      <p class="mb-0 mt-4">
        Home Assistant:
        <a class="text-link" href="/integrations/home-assistant">HACS integration guide</a>
        {" · "}
        <a class="text-link" href="https://doodersrage.github.io/thermaltrace/ingest/home-assistant">Developer docs</a>
        {" · "}
        <a class="text-link" href="https://github.com/doodersrage/thermaltrace-home-assistant">GitHub repo</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">OpenAPI preview</h2>
      <pre class="text-xs overflow-x-auto p-4 rounded-lg bg-[var(--color-surface-muted)]"><code>{`openapi: 3.1.0
info:
  title: ThermalTrace API
  version: 1.0.0
paths:
  /api/ingest/{deviceKey}:
    post:
      summary: Push sensor readings
  /api/v1/metrics:
    get:
      summary: Prometheus metrics (Bearer API key)
  /api/inbound/{token}:
    post:
      summary: Inbound webhook actions`}</code></pre>
      <p class="mb-0 text-sm">
        Full spec: <a class="text-link" href="/openapi.yaml">/openapi.yaml</a>
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Guides &amp; next steps</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li>
          <a class="text-link" href="/about/ingest-and-webhooks">Ingest &amp; webhooks guide</a>
          — payload shapes, HA blueprints, and alert channels
        </li>
        <li>
          <a class="text-link" href="/about/json-probe-output-schema">JSON probe schema</a>
          — stable keys for dashboard mapping
        </li>
        <li>
          <a class="text-link" href="/pricing">Plans &amp; pricing</a>
          — Free ingest; Pro for metrics API keys, share JSON, and inbound webhooks
        </li>
        <li>
          <a
            class="text-link"
            href="https://doodersrage.github.io/thermaltrace/"
            target="_blank"
            rel="noreferrer"
          >Extended developer docs</a>
          — VitePress guides on GitHub Pages
        </li>
      </ul>
    </section>

    <FaqSection faqs={docsFaqs} />
  </div>
</Layout>
