---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import tempProbeV1 from '../assets/temp-probe-v1.jpg';
import tempProbeV2 from '../assets/temp-probe-v2.jpg';
import JSONProbe from '../assets/json-temp.jpg';
import { Swiper, SwiperWrapper, SwiperSlide } from "astro-swiper";
---

<Layout title="About">
  <div class="page-shell space-y-6">
    <div class="page-grid items-start">
      <section class="card overflow-hidden p-0">
        <Swiper
          options={{
            loop: true,
            autoplay: {
              delay: 4000,
              disableOnInteraction: false,
            },
          }}
        >
          <SwiperWrapper>
            <SwiperSlide><Image src={tempProbeV1} alt="Version 1 of the temperature probe Arduino board" class="h-full w-full object-cover" /></SwiperSlide>
            <SwiperSlide><Image src={tempProbeV2} alt="Version 2 of the temperature probe Arduino board" class="h-full w-full object-cover" /></SwiperSlide>
            <SwiperSlide><Image src={JSONProbe} alt="JSON temperature data output" class="h-full w-full object-cover" /></SwiperSlide>
          </SwiperWrapper>
        </Swiper>
      </section>

      <section class="card animate-slide-up-fade">
        <h1 class="card-title">About Garage Temperature Monitor</h1>
        <p class="card-subtitle">Live sensor readings, local weather, and saved history in one place.</p>
        <div class="space-y-4">
          <p>
            This website monitors temperature and humidity in a garage using real sensor data
            collected by an Arduino-based probe system. The home page shows current readings at
            a glance, along with local weather for context.
          </p>
          <p>
            Each time live garage data is loaded, average readings are saved so trends can be
            reviewed later. Signed-in users can customize what appears on the home page and export
            historic data for their own analysis.
          </p>
        </div>
      </section>
    </div>

    <section class="card">
      <h2 class="card-title">What this site does</h2>
      <p class="card-subtitle">Features available to visitors and signed-in users.</p>
      <div class="about-grid">
        <article class="about-item">
          <h3>Live garage readings</h3>
          <p>
            The home page fetches temperature and humidity from one or more JSON feeds and displays
            the latest values for each configured probe, including individual sensors and an average.
          </p>
        </article>
        <article class="about-item">
          <h3>Current weather</h3>
          <p>
            A weather block shows conditions for a configured location using OpenWeatherMap data,
            including temperature, humidity, wind, cloud cover, and the current condition.
          </p>
        </article>
        <article class="about-item">
          <h3>Reading history</h3>
          <p>
            Saved snapshots are stored over time so signed-in users can browse paginated historic
            readings on the history page and download the full record as a CSV file.
          </p>
        </article>
        <article class="about-item">
          <h3>Personalized display</h3>
          <p>
            After signing in, users can choose which home page blocks to show, configure temperature
            feeds and probes, and override the weather city used for their account.
          </p>
        </article>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">How the data flows</h2>
      <p class="card-subtitle">From hardware in the garage to the page you are viewing.</p>
      <ol class="about-steps">
        <li>
          <strong>Hardware collects readings.</strong>
          An Arduino with a network shield reads temperature and humidity from one or more probes
          in the garage.
        </li>
        <li>
          <strong>The feed publishes JSON.</strong>
          The device exposes readings as JSON, typically with a <code>temp</code> object containing
          probe keys such as <code>0</code>, <code>1</code>, and <code>avg</code>.
        </li>
        <li>
          <strong>The website fetches live data.</strong>
          This site requests those feeds, normalizes the probe values, and renders them on the home page.
        </li>
        <li>
          <strong>Readings are saved for history.</strong>
          When garage data is fetched, an average snapshot is stored so historic values can be listed
          and exported from the reading history page.
        </li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">Signed-in dashboard</h2>
      <p class="card-subtitle">Extra tools available after creating an account.</p>
      <ul class="about-list">
        <li>Show or hide the garage temperature and weather blocks on the home page.</li>
        <li>Add multiple HTTPS temperature feeds and map any probe key to a custom label.</li>
        <li>Choose which probes are visible for your account.</li>
        <li>Set a personal OpenWeather city ID for the weather block.</li>
        <li>Review paginated historic readings and download them as CSV from the history page.</li>
      </ul>
      <p class="mt-4">
        Ready to customize your view?
        <a class="text-link" href="/signin">Sign in</a>
        or
        <a class="text-link" href="/register">create an account</a>.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Source code</h2>
      <p class="card-subtitle">Open-source projects behind this site and the sensor hardware.</p>
      <div class="space-y-3">
        <p>
          Arduino sketch and sensor firmware:
          <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
            github.com/doodersrage/arduino-network-json-temperature-sever
          </a>
        </p>
        <p>
          Website front-end and dashboard (Astro):
          <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/garage-temp">
            github.com/doodersrage/garage-temp
          </a>
        </p>
        <p>
        JSON Feed backend (provided by Fast API with Redis caching): <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/fast-api-relay">github.com/doodersrage/fast-api-relay</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .swiper {
    width: 100%;
    max-width: 100%;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }

  .about-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .about-item {
    padding: 1rem;
    border: 1px solid var(--color-sage);
    border-radius: 0.75rem;
    background-color: rgb(196 214 176 / 0.25);
  }

  .about-item h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-plum);
    text-transform: none;
    letter-spacing: normal;
  }

  .about-item p {
    margin: 0;
  }

  .about-steps {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .about-steps li {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .about-steps strong {
    color: var(--color-plum);
  }

  .about-list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .about-list li {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  code {
    font-size: 0.875em;
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    background-color: rgb(252 222 156 / 0.45);
    color: var(--color-plum);
  }
</style>
