---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import tempProbeV1 from '../assets/temp-probe-v1.jpg';
import tempProbeV2 from '../assets/temp-probe-v2.jpg';
import JSONProbe from '../assets/json-temp.jpg';
import { Swiper, SwiperWrapper, SwiperSlide, SwiperButtonPrev, SwiperButtonNext, SwiperPagination } from "astro-swiper";
---

<Layout>
    <div class="flex flex-wrap justify-center max-w-6xl mx-auto">

        <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/2">
            <Swiper
                options={{
                    loop: true,
                    autoplay: {
                    delay: 2000,
                    disableOnInteraction: false,
                    waitForTransition: false,
                    navigation: {
                        nextEl: '.swiper-button-next',
                        prevEl: '.my-swiper-button-prev',
                    },
                    }
                }}>
                <SwiperWrapper>
                    <!-- Slides -->
                    <SwiperSlide><Image src={tempProbeV1} alt="version 1 of temperature problem Arduino board" /></SwiperSlide>
                    <SwiperSlide><Image src={tempProbeV2} alt="version 2 of temperature problem Arduino board" /></SwiperSlide>
                    <SwiperSlide><Image src={JSONProbe} alt="JSON temperature data output" /></SwiperSlide>
                </SwiperWrapper>
            </Swiper>
        </div>
        <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/2">
            <div class="copy-wrap animate-slide-up-fade">
                <h1 class="text-3xl font-bold mb-4">About</h1>
                <p class="mb-4">This is just a simnple website used to display temperature and humidity data using an Arduino sketch with a network shield outputting data into JSON format. The Arduino sketch can be found here: <a  class="text-shadow-sm text-green-500 font-medium text-fg-brand hover:underline" target="_blank" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">https://github.com/doodersrage/arduino-network-json-temperature-sever</a></p>
                <p>Source for the front-end you're currently looking at can be found here: <a  class="text-shadow-sm text-green-500 font-medium text-fg-brand hover:underline" target="_blank" href="https://github.com/doodersrage/garage-temp">https://github.com/doodersrage/garage-temp</a></p>
            </div>
        </div>
    </div>
</Layout>
<style>
  .swiper {
    max-width: 455px;
  }

  img {
    width: 100%;
  }
</style>