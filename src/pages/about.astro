---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import tempProbeV1 from '../assets/temp-probe-v1.jpg';
import tempProbeV2 from '../assets/temp-probe-v2.jpg';
import JSONProbe from '../assets/json-temp.jpg';
import { Swiper, SwiperWrapper, SwiperSlide } from "astro-swiper";
---

<Layout title="About">
  <div class="page-shell page-grid items-start">
    <section class="card overflow-hidden p-0">
      <Swiper
        options={{
          loop: true,
          autoplay: {
            delay: 4000,
            disableOnInteraction: false,
          },
        }}
      >
        <SwiperWrapper>
          <SwiperSlide><Image src={tempProbeV1} alt="Version 1 of the temperature probe Arduino board" class="h-full w-full object-cover" /></SwiperSlide>
          <SwiperSlide><Image src={tempProbeV2} alt="Version 2 of the temperature probe Arduino board" class="h-full w-full object-cover" /></SwiperSlide>
          <SwiperSlide><Image src={JSONProbe} alt="JSON temperature data output" class="h-full w-full object-cover" /></SwiperSlide>
        </SwiperWrapper>
      </Swiper>
    </section>

    <section class="card animate-slide-up-fade">
      <h1 class="card-title">About this project</h1>
      <p class="card-subtitle">A simple monitor for garage temperature and humidity.</p>
      <div class="space-y-4">
        <p>
          This site displays temperature and humidity data from an Arduino sketch with a network shield,
          outputting readings in JSON format.
        </p>
        <p>
          Arduino sketch:
          <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
            github.com/doodersrage/arduino-network-json-temperature-sever
          </a>
        </p>
        <p>
          Front-end source:
          <a class="text-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/garage-temp">
            github.com/doodersrage/garage-temp
          </a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .swiper {
    width: 100%;
    max-width: 100%;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }
</style>
