---
import Layout from "../layouts/Layout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
import { getRegisterErrorMessage } from "../lib/registerErrors";
import {
  REGISTER_NEXT_DEVICES,
  sanitizeRegisterNext,
} from "../lib/registerUrl";

const nextPath = Astro.url.searchParams.get("next") ?? "";
const safeNext = sanitizeRegisterNext(nextPath) ?? REGISTER_NEXT_DEVICES;
const errorMessage = getRegisterErrorMessage(Astro.url.searchParams.get("error"));
const emailValue = Astro.url.searchParams.get("email") ?? "";
const signInParams = new URLSearchParams();
signInParams.set("next", safeNext);
if (emailValue) signInParams.set("email", emailValue);
const refCode = Astro.url.searchParams.get("ref")?.trim().toLowerCase() ?? "";
const signInHref = `/signin?${signInParams.toString()}`;
---

<Layout
  title="Register"
  description="Create a free ThermalTrace account, no credit card. Connect ESP/Arduino probes, freeze and flood/leak alerts, and history for your household."
  noindex
>
  <div class="auth-page">
    <header class="auth-intro page-header">
      <h1 class="page-header-title">Create your account</h1>
      <p class="page-header-lede">
        Free forever, no credit card. After signup you’ll land on Devices to connect your first probe or wet-contact alert path.
      </p>
      <p class="form-hint mt-2 mb-0">
        Prefer a look first?
        <a class="text-link" href="/demo">Live demo (no account)</a>
      </p>
    </header>

    <div class="form-panel">
      {refCode && (
        <p class="form-hint mb-4">
          Referral code <strong>{refCode}</strong> applied. Pro trial includes an extra 7 days.
        </p>
      )}
      {errorMessage && (
        <div class="alert-warning mb-4" role="alert">
          <p class="m-0">{errorMessage}</p>
        </div>
      )}

      <OAuthButtons action="/api/auth/signin" next={safeNext} ref={refCode} primary />

      <form action="/api/auth/register" method="post">
        <input type="hidden" name="next" value={safeNext} />
        {refCode && <input type="hidden" name="ref" value={refCode} />}
        <div class="form-field">
          <label class="form-label" for="email">Email</label>
          <input
            class="form-input"
            type="email"
            name="email"
            id="email"
            value={emailValue}
            required
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="password">Password</label>
          <input
            class="form-input"
            type="password"
            name="password"
            id="password"
            required
            minlength={8}
            autocomplete="new-password"
          />
          <p class="form-hint">Use at least 8 characters.</p>
        </div>
        <div class="form-field">
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
        </div>
        <button class="btn-primary" type="submit">Create account with email</button>
        <p class="form-hint mt-3 mb-0">
          By creating an account you agree to our
          <a class="text-link" href="/terms">Terms</a>
          and
          <a class="text-link" href="/privacy">Privacy policy</a>.
        </p>
      </form>
    </div>

    <p class="auth-switch">
      Already have an account?
      <a class="text-link" href={signInHref}>Sign in</a>
    </p>
  </div>
</Layout>
