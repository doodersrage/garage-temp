---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Register">
  <div class="page-shell page-grid">
    <section class="card animate-zoom-in">
      <h1 class="card-title">Create an account</h1>
      <p class="card-subtitle">
        Register to save your home page display preferences.
      </p>
      <p>
        Already have an account?
        <a class="text-link" href="/signin">Sign in</a>
      </p>
    </section>

    <form class="form-panel animate-blurred-fade-in" action="/api/auth/register" method="post">
      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" name="email" id="email" required />
      </div>
      <div class="form-field">
        <label class="form-label" for="password">Password</label>
        <input class="form-input" type="password" name="password" id="password" required />
      </div>
      <div class="form-field">
        <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
      </div>
      <button class="btn-primary" type="submit">Create account</button>
    </form>
  </div>
</Layout>
