---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Register">
  <div class="flex flex-wrap justify-center gap-4 max-w-5xl mx-auto">
    <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/4 p-4">
      <div class="copy-wrap">
        <h1>Register</h1>
        <p>Already have an account? <a class="text-yellow-500 font-medium text-fg-brand hover:underline" href="/signin">Sign in</a></p>
      </div>
    </div>
    
    <div class="w-full sm:w-1/2 md:w-1/3 lg:w-1/4 p-4">
      <form action="/api/auth/register" method="post">
        <label for="email">Email</label>
        <input class="bg-gray-200 shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" type="email" name="email" id="email" />
        <label for="password">Password</label>
        <input class="bg-gray-200 shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" type="password" name="password" id="password" />
        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">Register</button>
      </form>
    </div>
  </div>
</Layout>