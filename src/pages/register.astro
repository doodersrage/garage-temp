---
import Layout from "../layouts/Layout.astro";
import OAuthButtons from "../components/OAuthButtons.astro";
import { getRegisterErrorMessage } from "../lib/registerErrors";

const nextPath = Astro.url.searchParams.get("next") ?? "";
const safeNext =
  nextPath.startsWith("/") && !nextPath.startsWith("//") ? nextPath : "";
const errorMessage = getRegisterErrorMessage(Astro.url.searchParams.get("error"));
const emailValue = Astro.url.searchParams.get("email") ?? "";
const signInParams = new URLSearchParams();
if (safeNext) signInParams.set("next", safeNext);
if (emailValue) signInParams.set("email", emailValue);
const signInHref = signInParams.toString()
  ? `/signin?${signInParams.toString()}`
  : "/signin";
---

<Layout
  title="Register"
  description="Create a free account to personalize garage readings, save history, configure probes, and unlock dashboard tools."
>
  <div class="page-shell page-grid auth-page-grid items-start">
    <div class="auth-form animate-blurred-fade-in space-y-4">
      <form class="form-panel" action="/api/auth/register" method="post">
        {safeNext && <input type="hidden" name="next" value={safeNext} />}
        {errorMessage && (
          <div class="alert-warning mb-4" role="alert">
            <p class="m-0">{errorMessage}</p>
          </div>
        )}
        <div class="form-field">
          <label class="form-label" for="email">Email</label>
          <input
            class="form-input"
            type="email"
            name="email"
            id="email"
            value={emailValue}
            required
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="password">Password</label>
          <input
            class="form-input"
            type="password"
            name="password"
            id="password"
            required
            minlength={8}
            autocomplete="new-password"
          />
          <p class="form-hint">Use at least 8 characters.</p>
        </div>
        <div class="form-field">
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
        </div>
        <button class="btn-primary" type="submit">Create account</button>
      </form>
      <OAuthButtons action="/api/auth/signin" next={safeNext} />
    </div>

    <section class="card auth-aside animate-zoom-in">
      <h1 class="card-title">Create an account</h1>
      <p class="card-subtitle">
        Free registration unlocks a dashboard tailored to your probes, preferences, and reading history.
      </p>
      <details class="auth-aside-details">
        <summary>Why create an account?</summary>
        <div class="grid gap-4 leading-relaxed mt-3">
          <p>
            Anyone can view live garage temperatures and weather on the home page. Signing up lets you choose what
            appears there, map your own JSON feeds to friendly probe names, and review every snapshot stored for your
            account—see the
            <a class="text-link" href="/about/accounts-and-dashboard">accounts and dashboard guide</a>.
          </p>
          <p>
            Saved history turns day-to-day readings into trends you can browse in the dashboard. If you are building your
            own probe stack, the <a class="text-link" href="/about">about section</a> covers placement, firmware, and data flow.
          </p>
        </div>
      </details>
      <p class="mt-6 mb-0">
        Already have an account?
        <a class="text-link" href={signInHref}>Sign in</a>
        · <a class="text-link" href="/contact">Contact us</a>
      </p>
    </section>
  </div>
</Layout>
