---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlanComparisonTable from "../components/PlanComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import { getAuthFromCookies } from "../lib/auth";
import {
  getUserEntitlements,
  FREE_HISTORY_DAYS,
  FREE_MAX_DEVICES,
  MEMBER_HISTORY_DAYS,
  MEMBER_MAX_DEVICES,
  PRO_HISTORY_DAYS,
  PRO_MAX_DEVICES,
  formatHistoryRetention,
} from "../lib/entitlements";
import { normalizeComparisonTier } from "../lib/planComparison";
import { getMemberPriceDisplay, getProPriceDisplay } from "../lib/stripePricing";
import { getUserSubscription } from "../lib/stripeSubscriptions";
import { isActiveSubscriptionStatus } from "../lib/stripe";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const { user } = await getAuthFromCookies(Astro.cookies);
const entitlements = user ? await getUserEntitlements(user.id) : null;
const subscription = user ? await getUserSubscription(user.id) : null;
const currentTier = entitlements ? normalizeComparisonTier(entitlements.tier) : null;
const hasBilling =
  subscription !== null && isActiveSubscriptionStatus(subscription.status);
const memberPrices = getMemberPriceDisplay();
const proPrices = getProPriceDisplay();
const defaultInterval =
  import.meta.env.PRICING_DEFAULT_INTERVAL === "monthly" ? "monthly" : "annual";

function priceForInterval(
  prices: ReturnType<typeof getMemberPriceDisplay>,
  interval: "monthly" | "annual",
): { main: string; sub: string | null } {
  if (interval === "monthly") {
    return {
      main: prices.monthly ?? "Contact us",
      sub: null,
    };
  }
  if (prices.annual) {
    return {
      main: prices.annual,
      sub: prices.annualMonthlyEquivalent
        ? `${prices.annualMonthlyEquivalent}/mo billed annually`
        : "Billed annually",
    };
  }
  return { main: prices.monthly ?? "Contact us", sub: null };
}

const memberMonthly = priceForInterval(memberPrices, "monthly");
const memberAnnual = priceForInterval(memberPrices, "annual");
const proMonthly = priceForInterval(proPrices, "monthly");
const proAnnual = priceForInterval(proPrices, "annual");
const maxAnnualSavings = Math.max(
  memberPrices.annualSavingsPct ?? 0,
  proPrices.annualSavingsPct ?? 0,
);
const annualSavingsLabel =
  maxAnnualSavings > 0 ? `Save up to ${maxAnnualSavings}%` : "Save ~20%";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/pricing");
const pricingFaqs = getMarketingFaqs("pricing");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" },
  ]),
  getMarketingFaqSchema(pageUrl, "pricing"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Plans & pricing"
  description="Compare ThermalTrace Free, Member, and Pro—device counts, 7-day vs 90-day vs 1-year history, cold-risk/NWS forecasts, and annual billing savings. Start free; upgrade when winter hits."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Pricing"
      title="Plans that grow with your probes"
      lede="Start free with live curves and threshold freeze alerts. Member adds 90-day history, more devices, and predictive forecast warnings. Pro unlocks official NWS cold-risk alerts, SMS, push, share links, webhooks, and a 14-day trial."
    >
      {user ? (
        <p class="page-header-meta">
          Signed in as <strong>{user.email}</strong>
          {currentTier && (
            <>
              {" · "}
              Current plan: <strong>{currentTier}</strong>
            </>
          )}
          {" · "}
          <a class="text-link" href="/dashboard">Dashboard</a>
        </p>
      ) : (
        <>
          <a slot="actions" class="btn-primary" href="/register">Create free account</a>
          <a slot="actions" class="btn-secondary" href="/signin">Sign in</a>
        </>
      )}
    </PageHeader>

    <section class="plan-tier-section">
      <div class="billing-interval-toggle" role="group" aria-label="Billing interval">
        <button
          type="button"
          class="billing-interval-btn"
          data-interval="monthly"
          aria-pressed={defaultInterval === "monthly" ? "true" : "false"}
        >
          Monthly
        </button>
        <button
          type="button"
          class="billing-interval-btn"
          data-interval="annual"
          aria-pressed={defaultInterval === "annual" ? "true" : "false"}
        >
          Annual
          <span class="billing-interval-badge">{annualSavingsLabel}</span>
        </button>
      </div>
      <p class="billing-interval-hint">
        Annual plans lock in {maxAnnualSavings > 0 ? `${maxAnnualSavings}%` : "about 20%"} off versus paying monthly.
      </p>

      <div class="plan-tier-grid">
        <article class="plan-tier-card">
          <div class="plan-tier-badge-slot" aria-hidden="true"></div>
          <h2 class="plan-tier-name">Free</h2>
          <p class="plan-tier-price">$0</p>
          <div class="plan-tier-meta">
            <p class="plan-tier-savings">&nbsp;</p>
            <p class="plan-tier-sub">&nbsp;</p>
          </div>
          <p class="plan-tier-tagline">Live monitoring for one garage</p>
          <ul class="plan-tier-list">
            <li>{FREE_MAX_DEVICES} push devices</li>
            <li>{formatHistoryRetention(FREE_HISTORY_DAYS)} of history</li>
            <li>Threshold freeze alerts</li>
          </ul>
          <div class="plan-tier-footer">
            {!user ? (
              <a class="btn-secondary" href="/register">Get started</a>
            ) : currentTier === "free" ? (
              <p>Current plan</p>
            ) : (
              <p>Included in your plan</p>
            )}
          </div>
        </article>

        <article class="plan-tier-card plan-tier-card-featured">
          <div class="plan-tier-badge-slot">
            <p class="plan-tier-badge">Most popular</p>
          </div>
          <h2 class="plan-tier-name">Member</h2>
          <p
            class="plan-tier-price"
            data-price-monthly={memberMonthly.main}
            data-price-annual={memberAnnual.main}
          >
            {defaultInterval === "annual" ? memberAnnual.main : memberMonthly.main}
          </p>
          <div class="plan-tier-meta">
            <p
              class="plan-tier-savings"
              data-savings-monthly=""
              data-savings-annual={memberPrices.annualSavingsPct != null && memberPrices.annualSavingsPct > 0
                ? `Save ${memberPrices.annualSavingsPct}% with annual billing`
                : "Save ~20% with annual billing"}
            >
              {defaultInterval === "annual"
                ? (memberPrices.annualSavingsPct != null && memberPrices.annualSavingsPct > 0
                  ? `Save ${memberPrices.annualSavingsPct}% with annual billing`
                  : "Save ~20% with annual billing")
                : "\u00a0"}
            </p>
            <p
              class="plan-tier-sub"
              data-sub-monthly=""
              data-sub-annual={memberAnnual.sub ?? ""}
            >
              {defaultInterval === "annual" ? (memberAnnual.sub ?? "\u00a0") : "\u00a0"}
            </p>
          </div>
          <p class="plan-tier-tagline">History export, more headroom, and forecast freeze</p>
          <ul class="plan-tier-list">
            <li>{MEMBER_MAX_DEVICES} push devices</li>
            <li>{formatHistoryRetention(MEMBER_HISTORY_DAYS)} of history</li>
            <li>
              <span class="plan-feature-badge">Cold-risk</span>
              Forecast freeze alerts
            </li>
            <li>CSV history export</li>
          </ul>
          <div class="plan-tier-footer">
            {user ? (
              currentTier === "free" ? (
                <form action="/api/stripe/checkout" method="post" class="checkout-form">
                  <input type="hidden" name="plan" value="member" />
                  <input type="hidden" name="interval" value={defaultInterval} data-interval-input />
                  <button class="btn-primary" type="submit">Upgrade to Member</button>
                </form>
              ) : (
                <p>Included in your plan</p>
              )
            ) : (
              <a class="btn-primary" href="/signin?next=/pricing">Sign in to subscribe</a>
            )}
          </div>
        </article>

        <article class="plan-tier-card">
          <div class="plan-tier-badge-slot" aria-hidden="true"></div>
          <h2 class="plan-tier-name">Pro</h2>
          <p
            class="plan-tier-price"
            data-price-monthly={proMonthly.main === "Contact us" ? proMonthly.main : `${proMonthly.main}/mo`}
            data-price-annual={proAnnual.main === "Contact us" ? proAnnual.main : `${proAnnual.main}/yr`}
          >
            {defaultInterval === "annual"
              ? (proAnnual.main === "Contact us" ? proAnnual.main : `${proAnnual.main}/yr`)
              : (proMonthly.main === "Contact us" ? proMonthly.main : `${proMonthly.main}/mo`)}
          </p>
          <div class="plan-tier-meta">
            <p
              class="plan-tier-savings"
              data-savings-monthly=""
              data-savings-annual={proPrices.annualSavingsPct != null && proPrices.annualSavingsPct > 0
                ? `Save ${proPrices.annualSavingsPct}% annually`
                : "Save ~20% annually"}
            >
              {defaultInterval === "annual"
                ? (proPrices.annualSavingsPct != null && proPrices.annualSavingsPct > 0
                  ? `Save ${proPrices.annualSavingsPct}% annually`
                  : "Save ~20% annually")
                : "\u00a0"}
            </p>
            <p
              class="plan-tier-sub"
              data-sub-monthly="14-day free trial"
              data-sub-annual={proAnnual.sub ? `${proAnnual.sub} · 14-day free trial` : "14-day free trial"}
            >
              {defaultInterval === "annual"
                ? (proAnnual.sub ? `${proAnnual.sub} · 14-day free trial` : "14-day free trial")
                : "14-day free trial"}
            </p>
          </div>
          <p class="plan-tier-tagline">NWS cold-risk, alerts anywhere, integrations</p>
          <ul class="plan-tier-list">
            <li>{PRO_MAX_DEVICES} push devices</li>
            <li>{formatHistoryRetention(PRO_HISTORY_DAYS)}+ of history</li>
            <li>
              <span class="plan-feature-badge">Cold-risk</span>
              Forecast + official NWS alerts
            </li>
            <li>
              SMS, push, webhooks, share links &amp;
              <a class="text-link" href="/docs/api">API keys</a>
            </li>
          </ul>
          <div class="plan-tier-footer">
            {user ? (
              currentTier !== "pro" ? (
                <form action="/api/stripe/checkout" method="post" class="checkout-form">
                  <input type="hidden" name="plan" value="pro" />
                  <input type="hidden" name="interval" value={defaultInterval} data-interval-input />
                  <button class="btn-primary" type="submit">Start Pro trial</button>
                </form>
              ) : (
                <p>You're on Pro</p>
              )
            ) : (
              <a class="btn-primary" href="/signin?next=/pricing">Sign in for Pro trial</a>
            )}
          </div>
        </article>
      </div>
      {user && hasBilling && (
        <form action="/api/stripe/portal" method="post" class="mt-4">
          <button class="btn-secondary" type="submit">Manage billing</button>
        </form>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Full feature comparison</h2>
      <p class="card-subtitle mb-4">
        Device counts and retention windows sit side-by-side so you can see what upgrades. Cold-risk badges mark which plan includes predictive forecast and NWS freeze alerts.
      </p>
      <PlanComparisonTable highlightTier={currentTier} />
    </section>

    <FaqSection
      faqs={pricingFaqs}
      lede="Plan limits, upgrades, and billing—answered for freeze-season shoppers."
    />

    <section class="card">
      <h2 class="card-title">Still deciding?</h2>
      <p class="mb-0">
        Read the <a class="text-link" href="/stories/garage-freeze-alert">garage freeze case study</a>,
        see the <a class="text-link" href="/about/accounts-and-dashboard">accounts guide</a>,
        or <a class="text-link" href="/contact">contact us</a> if you're unsure which tier fits.
      </p>
    </section>
  </div>

  <script define:vars={{ defaultInterval }}>
    const STORAGE_KEY = "thermaltrace-pricing-interval";

    function readInterval() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "monthly" || stored === "annual") return stored;
      } catch {
        /* ignore */
      }
      return defaultInterval === "monthly" ? "monthly" : "annual";
    }

    function applyInterval(interval) {
      document.querySelectorAll(".billing-interval-btn").forEach((btn) => {
        const active = btn.getAttribute("data-interval") === interval;
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("billing-interval-btn-active", active);
      });

      document.querySelectorAll("[data-price-monthly]").forEach((el) => {
        const price = el.getAttribute(`data-price-${interval}`) ?? "";
        el.textContent = price;
      });

      document.querySelectorAll(".plan-tier-sub").forEach((el) => {
        const sub = el.getAttribute(`data-sub-${interval}`) ?? "\u00a0";
        el.textContent = sub || "\u00a0";
      });

      document.querySelectorAll(".plan-tier-savings").forEach((el) => {
        const savings = el.getAttribute(`data-savings-${interval}`) ?? "";
        el.textContent = savings || "\u00a0";
      });

      document.querySelectorAll("[data-interval-input]").forEach((input) => {
        input.value = interval;
      });

      try {
        localStorage.setItem(STORAGE_KEY, interval);
      } catch {
        /* ignore */
      }
    }

    const initial = readInterval();
    applyInterval(initial);

    document.querySelectorAll(".billing-interval-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const interval = btn.getAttribute("data-interval");
        if (interval === "monthly" || interval === "annual") {
          applyInterval(interval);
        }
      });
    });

    document.querySelectorAll("form.checkout-form").forEach((form) => {
      form.addEventListener("submit", () => {
        const plan =
          form.querySelector('input[name="plan"]')?.getAttribute("value") ?? "unknown";
        const interval =
          form.querySelector('input[name="interval"]')?.getAttribute("value") ?? "unknown";
        const gtag = window.gtag;
        if (typeof gtag === "function") {
          gtag("event", "begin_checkout", {
            item_list_id: "pricing",
            items: [{ item_id: plan, item_name: plan, item_category: interval }],
          });
        }
      });
    });
  </script>
</Layout>
