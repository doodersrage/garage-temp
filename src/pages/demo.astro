---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/demo");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Live demo", path: "/demo" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ThermalTrace live garage demo",
    description:
      "Public live garage probe readings before you create an account — then register to connect your own ESP or Arduino.",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
  },
];
---
<Layout
  title="Live garage temperature demo"
  description="See live ThermalTrace garage probe readings with no account required. Then register to connect your ESP32 or Arduino and set freeze alerts."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Try it"
      title="Live garage demo"
      lede="No signup wall. Watch real demo probe readings refresh, then create an account when you are ready to point your own hardware at ThermalTrace."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/temperature">Connect my probes</a>
      <a slot="actions" class="btn-secondary" href="/about/kit-qr-onboarding">Kit QR onboarding</a>
      <a slot="actions" class="btn-ghost" href="/about/probe-demo">Interactive simulator</a>
    </PageHeader>

    <section class="card">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
        <h2 class="card-title mb-0">Demo probes</h2>
        <p class="text-sm text-[var(--color-text-muted)] m-0" id="demo-updated">Loading…</p>
      </div>
      <div id="demo-readings" class="space-y-3 text-sm" aria-live="polite">
        <p class="m-0 text-[var(--color-text-muted)]">Fetching live demo feed…</p>
      </div>
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
        This uses the public demo garage feed. Your account will show your devices only.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Next: your kit</h2>
      <ol class="text-sm space-y-2 mb-4">
        <li>Create a free account and add a push device.</li>
        <li>Flash ESP/Arduino with your device key (see <a class="text-link" href="/about/kit-qr-onboarding">kit QR</a>).</li>
        <li>Set a freeze threshold and send a test alert.</li>
      </ol>
      <a class="btn-primary" href="/register?next=/dashboard/temperature">Start free</a>
    </section>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.getElementById("demo-readings");
    const updated = document.getElementById("demo-updated");
    if (!root) return;

    async function refresh() {
      try {
        const res = await fetch("/api/home/demo-temps");
        const data = await res.json();
        const groups = Array.isArray(data.groups) ? data.groups : [];
        if (updated) {
          const t = data.updatedAt ? new Date(data.updatedAt) : new Date();
          updated.textContent = `Updated ${t.toLocaleTimeString()}`;
        }
        if (groups.length === 0) {
          root.innerHTML = "<p class=\"m-0\">No demo readings available right now.</p>";
          return;
        }
        root.innerHTML = groups
          .map((group) => {
            const name = String(group.feedName ?? "Feed").replace(/</g, "&lt;");
            const err = group.error
              ? `<p class="m-0 text-[var(--color-danger)]">${String(group.error).replace(/</g, "&lt;")}</p>`
              : "";
            const probes = (group.probes ?? [])
              .map((p) => {
                const label = String(p.label ?? p.key ?? "Probe").replace(/</g, "&lt;");
                const f = p.data?.f;
                const val =
                  typeof f === "number" && Number.isFinite(f) ? `${f.toFixed(1)}°F` : "—";
                return `<li><strong>${label}</strong> · ${val}</li>`;
              })
              .join("");
            return `<div><p class="m-0 mb-1 font-semibold">${name}</p>${err}<ul class="m-0 pl-4">${probes}</ul></div>`;
          })
          .join("");
      } catch {
        root.innerHTML = "<p class=\"m-0\">Could not load demo readings.</p>";
      }
    }

    refresh();
    setInterval(refresh, 15000);
  })();
</script>
