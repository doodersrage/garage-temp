---
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import DemoTempsPanel from "../components/DemoTempsPanel";
import WeatherPanel from "../components/WeatherPanel";
import HomeStatusChip from "../components/HomeStatusChip.astro";
import FaqSection from "../components/FaqSection.astro";
import { fetchAppStatusSummary } from "../lib/appStatus";
import { getMarketingFaqs } from "../lib/marketingFaqs";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import freezeAlertLifestyle from "../assets/thermaltrace-freeze-alert-lifestyle.jpg";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/demo");
const demoFaqs = getMarketingFaqs("home").filter((faq) =>
  /account|connect ESP|freeze alert|free\?/i.test(faq.question),
);
const appStatus = await fetchAppStatusSummary();
const owmApiKey = String(import.meta.env.NEXT_PUBLIC_OPENWEATHER_API_KEY ?? "")
  .replace(/\r/g, "")
  .trim();
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Live demo", path: "/demo" },
  ]),
  getFaqPageSchema(pageUrl, demoFaqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ThermalTrace live probe demo",
    description:
      "Public live probe readings before you create an account — then register to connect your own ESP or Arduino.",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Live probe temperature demo"
  description="See live ThermalTrace probe readings with no account required. Then register to connect your own ESP32 or Arduino and set freeze alerts."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Try it — no account"
      title="Live probe demo"
      lede="Real demo probe readings refresh here. Same ingest path your ESP or Arduino will use — then create a free account when you are ready to point your own hardware at ThermalTrace."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/temperature">Connect my probes</a>
      <a slot="actions" class="btn-secondary" href="/about/kit-qr-onboarding">Kit QR onboarding</a>
      <a slot="actions" class="btn-ghost" href="/about/probe-demo">Interactive simulator</a>
    </PageHeader>

    <HomeStatusChip status={appStatus} />

    <div class="home-live" aria-label="Live demo readings">
      <DemoTempsPanel client:visible intervalMs={15000} />
      <WeatherPanel client:visible cityId={null} guest owmApiKey={owmApiKey || null} />
    </div>

    <section class="demo-freeze" aria-labelledby="demo-freeze-title">
      <div class="demo-freeze-copy">
        <h2 class="demo-freeze-title" id="demo-freeze-title">Same data that fires freeze alerts</h2>
        <p class="demo-freeze-lede">
          When a probe crosses your threshold, ThermalTrace can reach you on email, Discord, Telegram, Slack — and on Pro, SMS and browser push. Set the line once; test it before the next cold night.
        </p>
        <ul class="demo-freeze-channels" aria-label="Alert channels">
          <li>Email · Discord · Telegram · Slack</li>
          <li>SMS · push · webhooks on Pro</li>
          <li>Leak / flood sensors alert automatically when wet</li>
        </ul>
        <div class="demo-freeze-actions">
          <a class="btn-primary" href="/register?next=/dashboard/alerts">Start free — set alerts</a>
          <a class="btn-secondary" href="/stories/garage-freeze-alert">Freeze alert story</a>
          <a class="btn-ghost" href="/about/alert-channel-cookbook">Channel cookbook</a>
        </div>
      </div>
      <figure class="demo-freeze-visual">
        <Image
          src={freezeAlertLifestyle}
          alt="Homeowner checking a freeze alert on a phone in a cold workshop"
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 42vw"
          class="demo-freeze-img"
        />
      </figure>
    </section>

    <section class="home-steps" aria-labelledby="demo-steps-title">
      <div class="home-steps-intro">
        <h2 class="home-steps-title" id="demo-steps-title">Your kit next</h2>
        <p class="home-steps-lede">
          Free account, no credit card — from blank dashboard to a live curve in one sitting.
        </p>
      </div>
      <ol class="home-steps-list">
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">1</span>
          <div>
            <h3 class="home-step-title">Create a push device</h3>
            <p class="home-step-copy">
              Sign up and open Devices, or use <strong>Try without hardware</strong> on Overview for the demo pull feed. Copy the ingest URL or QR from the 30-minute callout.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">2</span>
          <div>
            <h3 class="home-step-title">POST JSON</h3>
            <p class="home-step-copy">
              POST to <code>/api/ingest/&lt;key&gt;</code>. Sensors auto-import on first POST — rename on Devices afterward.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">3</span>
          <div>
            <h3 class="home-step-title">Watch Home &amp; set alerts</h3>
            <p class="home-step-copy">
              Confirm live values, set a freeze threshold, and send a test alert before the next cold night.
            </p>
          </div>
        </li>
      </ol>
      <div class="home-steps-actions">
        <a class="btn-primary" href="/register?next=/dashboard/temperature">Start free — open Devices</a>
        <a class="btn-secondary" href="/about/adding-devices">Adding devices guide</a>
      </div>
    </section>

    <section class="home-compat" aria-label="Works with">
      <p class="home-compat-label">Works with</p>
      <ul class="home-compat-list">
        <li>ESP32</li>
        <li>Arduino</li>
        <li>HTTPS JSON push</li>
        <li>HTTPS JSON pull</li>
        <li>MQTT bridge</li>
        <li><a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a></li>
        <li>Discord · Telegram · Slack</li>
      </ul>
      <p class="home-compat-note">
        Keep MQTT on your LAN; mirror to ThermalTrace over HTTPS for household freeze alerts and history.
        <a class="text-link" href="/about/adding-devices#mqtt-bridge">MQTT bridge recipe</a>
      </p>
    </section>

    <section class="demo-explore" aria-labelledby="demo-explore-title">
      <h2 class="demo-explore-title" id="demo-explore-title">Keep exploring</h2>
      <p class="demo-explore-lede">
        Still deciding? Try the placement simulator, skim the public freeze map, or scan a kit QR flow.
      </p>
      <ul class="demo-explore-list">
        <li>
          <a class="text-link" href="/about/probe-demo">Interactive probe simulator</a>
          <span class="demo-explore-hint">Door, sun, and outdoor inputs without hardware</span>
        </li>
        <li>
          <a class="text-link" href="/freeze-map">Community freeze map</a>
          <span class="demo-explore-hint">Opt-in city aggregates — no account required</span>
        </li>
        <li>
          <a class="text-link" href="/about/kit-qr-onboarding">Kit QR onboarding</a>
          <span class="demo-explore-hint">Scan → claim device → first POST</span>
        </li>
        <li>
          <a class="text-link" href="/stories/garage-freeze-alert">Freeze case study</a>
          <span class="demo-explore-hint">Why a second probe near pipes matters</span>
        </li>
      </ul>
    </section>

    <FaqSection
      faqs={demoFaqs}
      lede="Quick answers before you create an account."
    />
  </div>
</Layout>

<style>
  .demo-freeze {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .demo-freeze {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
  }

  .demo-freeze-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-text);
  }

  .demo-freeze-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .demo-freeze-channels {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .demo-freeze-channels li + li {
    margin-top: 0.35rem;
  }

  .demo-freeze-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .demo-freeze-visual {
    margin: 0;
  }

  .demo-freeze-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 12px);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .demo-explore-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--color-text);
  }

  .demo-explore-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .demo-explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .demo-explore-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }
  }

  .demo-explore-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .demo-explore-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
