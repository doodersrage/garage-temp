---
import Layout from "../layouts/Layout.astro";
import { getAuthFromCookies } from "../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);

if (user) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Sign in">
  <div class="page-shell page-grid">
    <section class="card animate-zoom-in">
      <h1 class="card-title">Sign in</h1>
      <p class="card-subtitle">
        Access your dashboard and customize what appears on the home page.
      </p>
      <p>
        New here?
        <a class="text-link" href="/register">Create an account</a>
      </p>
    </section>

    <form class="form-panel animate-blurred-fade-in" action="/api/auth/signin" method="post">
      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" name="email" id="email" required />
      </div>
      <div class="form-field">
        <label class="form-label" for="password">Password</label>
        <input class="form-input" type="password" name="password" id="password" required />
      </div>
      <div class="form-field">
        <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
      </div>
      <div class="flex flex-col gap-3">
        <button class="btn-primary" type="submit">Sign in</button>
        <button class="btn-secondary" value="github" name="provider" type="submit">Sign in with GitHub</button>
      </div>
    </form>
  </div>
</Layout>
