---
import Layout from "../layouts/Layout.astro";

const { cookies, redirect } = Astro;

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  return redirect("/dashboard");
}
---

<Layout title="Sign in">
  <div class="flex flex-wrap justify-center max-w-6xl mx-auto">
    <div class="w-full sm:w-1/2 md:w-1/2 lg:w-1/2 px-4">
      <div class="copy-wrap animate-zoom-in">
        <h1>Sign in</h1>
        <p>New here? <a class="text-shadow-sm text-green-500 font-medium text-fg-brand hover:underline" href="/register">Create an account</a></p>
      </div>
    </div>
    <div class="w-full sm:w-1/2 md:w-1/2 lg:w-1/2 p-4 animate-blurred-fade-in">
      <form class="shadow-md" action="/api/auth/signin" method="post">
        <label class="text-base/7 font-semibold" for="email">Email</label>
        <input class="bg-gray-200 shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" type="email" name="email" id="email" />
        <label class="text-base/7 font-semibold" for="password">Password</label>
        <input class="bg-gray-200 shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" type="password" name="password" id="password" />
        <div>
            <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
        </div>
        <div class="justify-center flex flex-col gap-2">
          <button class="my-4 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">Login</button>
          <button class="my-4 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" value="github" name="provider" type="submit">Sign in with GitHub</button>
        </div>
      </form>
    </div>
  </div>
</Layout>