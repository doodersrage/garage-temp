---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { ACCESSORIES } from "../lib/accessories";
import { BRAND_NAME } from "../lib/brand";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/accessories");
const faqs = getMarketingFaqs("accessories");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Accessories", path: "/accessories" },
  ]),
  getMarketingFaqSchema(pageUrl, "accessories"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Hardware accessories"
  description={`Companion devices and kit pieces for ${BRAND_NAME}: mood lights, door and leak contacts, labels, and mounts.`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Hardware"
      title="Hardware accessories"
      lede={`Companion devices and kit pieces for ${BRAND_NAME}. Temperature probes stay on the freeze-kit path — these prove presence, show moods, POST contacts, or finish a garage install.`}
    >
      <a slot="actions" class="btn-primary" href="/claim-puck">Claim puck</a>
      <a slot="actions" class="btn-secondary" href="/about/esp32-freeze-kit">Freeze kit BOM</a>
      <a slot="actions" class="btn-ghost" href="/bay-buddy">Bay Buddy</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Catalog</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">ThermalTrace hardware accessories</caption>
          <thead>
            <tr>
              <th scope="col">Accessory</th>
              <th scope="col">Role</th>
              <th scope="col">Kind</th>
            </tr>
          </thead>
          <tbody>
            {
              ACCESSORIES.map((item) => (
                <tr>
                  <th scope="row">
                    <a class="text-link" href={item.path}>
                      {item.name}
                    </a>
                  </th>
                  <td>{item.tagline}</td>
                  <td class="whitespace-nowrap">
                    {item.kind === "companion"
                      ? "Companion"
                      : item.kind === "sensor-contact"
                        ? "Contact sensor"
                        : "Kit / merch"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <FaqSection
      title="Accessories FAQ"
      faqs={faqs}
      lede="How accessories relate to probes, Bay Buddy, and the claim puck."
    />
  </div>
</Layout>
