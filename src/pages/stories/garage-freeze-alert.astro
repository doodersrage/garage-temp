---
export const prerender = false;

import StoryArticle from "../../components/StoryArticle.astro";
import { getStory } from "../../lib/stories";
import freezeAlertLifestyle from "../../assets/thermaltrace-freeze-alert-lifestyle.jpg";

const story = getStory("garage-freeze-alert");
if (!story) {
  return Astro.redirect("/stories");
}
---
<StoryArticle
  story={story}
  heroImage={freezeAlertLifestyle}
  heroCaption="Freeze-risk moment — phone alert beside plumbing. Notification shown is stylized, not a product screenshot."
/>
