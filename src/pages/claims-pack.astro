---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { getAuthFromCookies } from "../lib/auth";
import { CLAIMS_DISCLAIMER } from "../lib/claimsPack";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import type { AboutFaqItem } from "../lib/aboutFaqs";

const { user } = await getAuthFromCookies(Astro.cookies);

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/claims-pack");

const claimsFaqs: AboutFaqItem[] = [
  {
    question: "Is the claims pack a legal document?",
    answer: CLAIMS_DISCLAIMER,
  },
  {
    question: "What plan is the claims pack on?",
    answer:
      "The claims pack is a Pro feature. Free and Member plans can still see live readings and history, but generating and emailing a claims pack requires Pro.",
  },
  {
    question: "Can I send this directly to my insurance adjuster?",
    answer:
      "Yes. From your history page you can either download the report to attach to your own email, or send it directly to an adjuster's email address from ThermalTrace. Either way, the recipient gets a durable link they can reopen and re-verify later.",
  },
  {
    question: "What makes an export \"verifiable\"?",
    answer:
      "Every generated pack is saved with a SHA-256 hash of its contents and a permanent link. Reopening that link re-renders the exact data that was exported and shows the same verification code, so anyone holding the link can confirm the report hasn't been altered since it was generated.",
  },
  {
    question: "Will using this get me a discount from my insurer?",
    answer:
      "Some insurers offer discounts for homes with leak or freeze monitoring, but this varies by carrier and ThermalTrace doesn't have a formal partnership with any insurer today. Bring your claims pack to that conversation and ask — it's documentation of your monitoring setup, not a guarantee of a discount.",
  },
];

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Claims pack", path: "/claims-pack" },
  ]),
  getFaqPageSchema(pageUrl, claimsFaqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Claims & insurance evidence pack"
  description="Turn ThermalTrace's freeze and leak monitoring history into a verifiable claims pack — freeze-exposure stats, device tables, and an alert timeline you can download, email to an adjuster, or bring to your insurer."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Documentation"
      title="Proof your monitoring caught it"
      lede="A pipe freeze or a leak doesn't wait for a good time. The claims pack turns your ThermalTrace history into a single report — freeze-exposure stats, device and probe tables, and a timeline of every alert — built for a claim, a dispute, or just having the paper trail before you need it."
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/history#claims-pack" : "/register?next=/dashboard/temperature"}>
        {user ? "Generate a claims pack" : "Start free — build your pack"}
      </a>
      <a slot="actions" class="btn-secondary" href="/pricing">See Pro pricing</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">What's in the pack</h2>
      <p class="card-subtitle mb-4">
        One printable HTML report, generated on demand from your own sensor history for any date range.
      </p>
      <ul class="text-sm space-y-2 mb-0">
        <li><strong>Freeze-exposure stats</strong> — hours spent at or below your alert threshold, and the coldest reading in the window.</li>
        <li><strong>Device and probe tables</strong> — every sensor that reported in the range, with the space it's assigned to.</li>
        <li><strong>Critical-alert timeline</strong> — every threshold-crossing alert that fired, with timestamps.</li>
        <li><strong>Linked CSVs</strong> — the underlying readings and alert-event exports, for an adjuster who wants the raw data.</li>
      </ul>
      <p class="mt-4 mb-0 text-sm">
        Who it's for: documenting an active freeze or leak claim, backing up a dispute over when a failure started, or just having a record on hand — even if you never end up needing it.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Built to hold up, not just print out</h2>
      <p class="mb-4 text-sm">
        A one-time download can get lost in a downloads folder or edited before anyone sees it. Every claims pack
        you generate is also saved as a durable, tokenized export: it gets a permanent link and a SHA-256
        verification code computed over its contents.
      </p>
      <ul class="text-sm space-y-2 mb-0">
        <li>Reopen the link any time to see the exact report that was generated — not a live, possibly-changed view.</li>
        <li>The verification code lets you or an adjuster confirm the report matches what was originally sent.</li>
        <li>Email it directly to an adjuster's inbox from your dashboard, with the link built in.</li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Ask your insurer about it</h2>
      <p class="mb-4 text-sm">
        Some insurers offer premium discounts or credits for homes with active leak or freeze monitoring —
        it reduces their claim risk. ThermalTrace doesn't have a formal partnership with any insurer today,
        so treat this as a conversation starter rather than a promised discount: bring your claims pack, ask
        whether monitoring like this qualifies for anything on your policy, and let your carrier tell you
        what they actually offer.
      </p>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        {CLAIMS_DISCLAIMER}
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">How to generate one</h2>
      <ol class="text-sm space-y-2 mb-0">
        <li>Connect at least one probe and let ThermalTrace collect a bit of history (freeze alerts work from day one; the claims pack covers whatever range you've been monitoring).</li>
        <li>Upgrade to Pro if you haven't already — the claims pack is a Pro feature.</li>
        <li>From <a class="text-link" href="/dashboard/history#claims-pack">History</a>, pick a date range and download the pack, or send it straight to an adjuster's email.</li>
      </ol>
      <p class="mt-4 mb-0">
        <a class="btn-primary" href={user ? "/dashboard/history#claims-pack" : "/register?next=/dashboard/temperature"}>
          {user ? "Generate a claims pack" : "Start free — build your pack"}
        </a>
      </p>
    </section>

    <FaqSection faqs={claimsFaqs} lede="Straight answers on what the pack is, and isn't." />
  </div>
</Layout>
