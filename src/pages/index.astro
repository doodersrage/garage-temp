---
import Layout from '../layouts/Layout.astro';
import GetTemps from '../components/GetTemps.astro';
import Weather from '../components/Weather.astro';
---

<Layout>
	<div class="flex flex-wrap justify-center max-w-6xl mx-auto">
		<div class="w-full px-4">
			<GetTemps server:defer>
				<div slot="fallback">Loading garage temperature data...</div>
			</GetTemps>
		</div>
		<div class="w-full px-4">
			<Weather server:defer>
				<div slot="fallback">Loading weather data...</div>
			</Weather>
		</div>
	</div>
</Layout>
