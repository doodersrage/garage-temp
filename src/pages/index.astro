---
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import LiveTempsPanel from '../components/LiveTempsPanel';
import { getAuthFromCookies } from '../lib/auth';
import { getUserPreferences } from '../lib/userPreferences';

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;
const preferences = isAuthenticated ? await getUserPreferences(user) : null;

const showGarageTemps = !isAuthenticated || preferences!.showGarageTemps;
const showWeather = !isAuthenticated || preferences!.showWeather;
---

<Layout description="ThermalTrace tracks, logs, and analyzes temperature probe curves with live dashboards, freeze alerts, and history.">
	{!isAuthenticated ? (
		<div class="home-marketing">
			<section class="home-hero home-hero--bleed">
				<div class="home-hero-inner">
					<h1 class="home-hero-brand">ThermalTrace</h1>
					<p class="home-hero-lead">
						An open-source dashboard to track, log, and analyze temperature probe curves —
						with freeze-aware alerts before pipes and storage take damage.
					</p>
					<div class="home-hero-actions">
						<a class="btn-primary" href="/register">Create free account</a>
						<a class="btn-secondary" href="/pricing">See plans</a>
					</div>
				</div>
			</section>

			<div class="page-shell page-stack">
				<div class="home-live" aria-label="Live demo readings">
					{showGarageTemps && <DemoTempsPanel client:visible />}
					{showWeather && <WeatherPanel client:visible cityId={null} guest />}
				</div>

				<section class="home-features" aria-label="Product highlights">
					<article class="home-feature">
						<h2 class="home-feature-title">Freeze-aware alerts</h2>
						<p class="home-feature-copy">
							Threshold, forecast, and NWS-backed cold risk across email, SMS, push, and webhooks.
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Your sensors</h2>
						<p class="home-feature-copy">
							ESP/Arduino push ingest or HTTPS JSON feeds — map spaces, doors, flood, and power too.
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Household ready</h2>
						<p class="home-feature-copy">
							Share access, history, and status pages without handing out a login password.
						</p>
					</article>
				</section>

				<section class="card home-guides">
					<div class="home-guides-copy">
						<h2 class="card-title">Built for probe curves</h2>
						<p class="card-subtitle mb-0">
							Probe placement, wiring, firmware, and the data path from sensor wire to chart.
						</p>
					</div>
					<div class="home-guides-actions">
						<a class="btn-primary" href="/about">Explore the guides</a>
						<a class="btn-secondary" href="/about/probe-demo">Probe demo</a>
					</div>
				</section>
			</div>
		</div>
	) : (
		<div class="page-shell page-stack">
			<div class="grid gap-6">
				{showGarageTemps && <LiveTempsPanel client:visible />}
				{showWeather && (
					<WeatherPanel client:visible cityId={preferences?.weatherCityId ?? null} />
				)}
				{!showGarageTemps && !showWeather && (
					<div class="empty-state">
						<p class="empty-state-title">Home panels are hidden</p>
						<p class="mb-0">Update your display preferences to show live readings again.</p>
						<div class="empty-state-actions">
							<a class="btn-primary" href="/dashboard/settings">Open settings</a>
						</div>
					</div>
				)}
			</div>
		</div>
	)}
</Layout>
