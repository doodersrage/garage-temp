---
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import LiveTempsPanel from '../components/LiveTempsPanel';
import { getAuthFromCookies } from '../lib/auth';
import { getUserPreferences } from '../lib/userPreferences';

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;
const preferences = isAuthenticated ? await getUserPreferences(user) : null;

const showGarageTemps = !isAuthenticated || preferences!.showGarageTemps;
const showWeather = !isAuthenticated || preferences!.showWeather;
---

<Layout description="Live garage temperature and humidity readings with local weather, saved history, and a configurable dashboard.">
	<div class="page-shell page-stack">
		{!isAuthenticated && (
			<section class="home-hero animate-slide-up-fade">
				<p class="home-hero-brand">Garage Temperature Monitor</p>
				<p class="home-hero-lead">
					Watch freeze risk in real time, compare indoor conditions with outdoor weather,
					and get alerts before pipes and storage take damage.
				</p>
				<div class="home-hero-actions">
					<a class="btn-primary" href="/register">Create free account</a>
					<a class="btn-secondary" href="/pricing">See plans</a>
				</div>
			</section>
		)}

		<div class="grid gap-6">
			{showGarageTemps && isAuthenticated && (
				<LiveTempsPanel client:visible />
			)}
			{showGarageTemps && !isAuthenticated && (
				<DemoTempsPanel client:visible />
			)}
			{showWeather && (
				<WeatherPanel client:visible cityId={preferences?.weatherCityId ?? null} />
			)}
			{isAuthenticated && !showGarageTemps && !showWeather && (
				<div class="empty-state">
					<p class="empty-state-title">Home panels are hidden</p>
					<p class="mb-0">Update your display preferences to show live readings again.</p>
					<div class="empty-state-actions">
						<a class="btn-primary" href="/dashboard">Open display preferences</a>
					</div>
				</div>
			)}
		</div>

		{!isAuthenticated && (
			<section class="card">
				<h2 class="card-title">Make it yours</h2>
				<p class="card-subtitle">
					The readings above are a public demo. Create a free account to connect your own probes, save history, set alerts, and share with family.
				</p>
				<div class="flex flex-wrap gap-3 mt-4">
					<a class="btn-primary" href="/register">Create free account</a>
					<a class="btn-secondary" href="/signin">Sign in</a>
				</div>
			</section>
		)}

		<section class="card">
			<h2 class="card-title">About these readings</h2>
			<p class="card-subtitle">Probes, weather, history, and the technology behind this site.</p>
			<div class="grid gap-4 leading-relaxed">
				<p>
					This site combines DHT22 probes, JSON feeds, and local weather so you can compare garage conditions
					with the outdoors. The guides explain
					<a class="text-link" href="/about/temperature-probes">probe placement and averaging</a>,
					<a class="text-link" href="/about/temperature-changes">what drives daily and seasonal swings</a>, and the
					<a class="text-link" href="/about/data-flow">path from sensor wire to screen</a>.
				</p>
				<p>
					The <a class="text-link" href="/about">about section</a> covers firmware, wiring, backend scripts, and
					this Astro application in depth—including an
					<a class="text-link" href="/about/probe-demo">interactive probe demo</a>,
					<a class="text-link" href="/about/arduino-sketches">Arduino sketches</a> with
					<a class="text-link" href="/about/arduino-circuit-wiring">circuit</a> and
					<a class="text-link" href="/about/arduino-pin-wiring">pin-level wiring</a>, and guides on
					<a class="text-link" href="/about/historical-data">historical data</a> and
					<a class="text-link" href="/about/accounts-and-dashboard">dashboard tools</a>.
				</p>
			</div>
			<a class="btn-primary mt-6 inline-flex" href="/about">Explore the about guides</a>
		</section>
	</div>
</Layout>
