---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import LiveTempsPanel from '../components/LiveTempsPanel';
import FaqSection from '../components/FaqSection.astro';
import HomeStatusChip from '../components/HomeStatusChip.astro';
import HomePwaCard from '../components/HomePwaCard.astro';
import { BRAND_NAME_TM } from '../lib/brand';
import { getAuthFromCookies } from '../lib/auth';
import { getUserPreferences } from '../lib/userPreferences';
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from '../lib/schemaMarkup';
import { getMarketingFaqs, getMarketingFaqSchema } from '../lib/marketingFaqs';
import { getMemberPriceDisplay, getProPriceDisplay } from '../lib/stripePricing';
import { fetchAppStatusSummary } from '../lib/appStatus';
import garageInstallLifestyle from '../assets/thermaltrace-garage-install-lifestyle.jpg';

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;
const preferences = isAuthenticated ? await getUserPreferences(user) : null;

const showGarageTemps = !isAuthenticated || preferences!.showGarageTemps;
const showWeather = !isAuthenticated || preferences!.showWeather;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/");
const homeFaqs = getMarketingFaqs("home");
const schema = [
  getBreadcrumbSchema(siteUrl, [{ name: "Home", path: "/" }]),
  getMarketingFaqSchema(pageUrl, "home"),
].filter(Boolean) as Record<string, unknown>[];

const homeDescription =
  "ThermalTrace is an open-source dashboard for garage and workshop sensors—temperature, humidity, air quality, doors, leaks, power, and energy—with freeze-aware alerts and history you can chart and export.";

const memberPrice = getMemberPriceDisplay().monthly;
const proPrice = getProPriceDisplay().monthly;
const appStatus = !isAuthenticated ? await fetchAppStatusSummary() : null;
const owmApiKey = String(import.meta.env.NEXT_PUBLIC_OPENWEATHER_API_KEY ?? "")
  .replace(/\r/g, "")
  .trim();
---

<Layout
  title="Garage sensor dashboard & freeze alerts"
  description={homeDescription}
  schema={schema}
  softwareApplication
  speakableSelectors={[".home-hero-brand", ".home-hero-audience", ".home-hero-lead", ".faq-answer"]}
>
	{!isAuthenticated ? (
		<div class="home-marketing">
			<section class="home-hero home-hero--bleed">
				<div class="home-hero-inner home-hero-grid">
					<div class="home-hero-copy">
						<p class="home-hero-audience">
							Built for homeowners, hobbyists, and makers with ESP32, Arduino, or any HTTPS JSON probe.
						</p>
						<h1 class="home-hero-brand">{BRAND_NAME_TM}</h1>
						<p class="home-hero-lead">
							Open-source monitoring for garage and workshop sensors —
							live curves, freeze-aware alerts, and history before pipes and storage take damage.
						</p>
						<div class="home-hero-actions">
							<a class="btn-primary" href="/demo">Try live demo</a>
							<a class="btn-secondary" href="/register?next=/dashboard/temperature">Create free account</a>
							<a
								class="btn-secondary"
								href="https://github.com/doodersrage/thermaltrace"
								target="_blank"
								rel="noreferrer"
							>View source</a>
						</div>
						<p class="home-hero-plans">
							<a class="text-link" href="/pricing">
								Free forever · no credit card
								<span aria-hidden="true"> · </span>
								{memberPrice ? `Member ${memberPrice}/mo` : "Member"}
								<span aria-hidden="true"> · </span>
								{proPrice ? `Pro ${proPrice}/mo` : "Pro"}
							</a>
						</p>
					</div>
					<figure class="home-hero-visual">
						<Image
							src={garageInstallLifestyle}
							alt="Garage probe install beside copper pipes — checking readings on phone and laptop"
							widths={[480, 720, 960]}
							sizes="(max-width: 959px) 100vw, 42vw"
							class="home-hero-visual-img"
						/>
					</figure>
				</div>
			</section>

			<div class="page-shell page-stack">
				<HomeStatusChip status={appStatus} />

				<div class="home-live" aria-label="Live demo readings">
					{showGarageTemps && <DemoTempsPanel client:visible />}
					{showWeather && <WeatherPanel client:visible cityId={null} guest owmApiKey={owmApiKey || null} />}
				</div>

				<section class="home-steps" aria-labelledby="home-steps-title">
					<div class="home-steps-intro">
						<h2 class="home-steps-title" id="home-steps-title">3 steps to first reading</h2>
						<p class="home-steps-lede">
							Free account, no credit card — from blank dashboard to a live curve in one sitting.
						</p>
					</div>
					<ol class="home-steps-list">
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">1</span>
							<div>
								<h3 class="home-step-title">Create a push device</h3>
								<p class="home-step-copy">
									Sign up and open Devices. Copy the one-time ingest URL (or QR) for your ESP/Arduino.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">2</span>
							<div>
								<h3 class="home-step-title">Map sensors &amp; POST JSON</h3>
								<p class="home-step-copy">
									Add a temp + humidity pair (or a single key), then POST to
									<code>/api/ingest/&lt;key&gt;</code>. The page waits for the first reading.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">3</span>
							<div>
								<h3 class="home-step-title">Watch Home &amp; set alerts</h3>
								<p class="home-step-copy">
									Confirm live values, set a freeze threshold, and send a test alert before the next cold night.
								</p>
							</div>
						</li>
					</ol>
					<div class="home-steps-actions">
						<a class="btn-primary" href="/register?next=/dashboard/temperature">Start free — open Devices</a>
						<a class="btn-secondary" href="/about/adding-devices">Adding devices guide</a>
					</div>
				</section>

				<section class="home-compat" aria-label="Works with">
					<p class="home-compat-label">Works with</p>
					<ul class="home-compat-list">
						<li>ESP32</li>
						<li>Arduino</li>
						<li>HTTPS JSON push</li>
						<li>HTTPS JSON pull</li>
						<li>MQTT bridge</li>
						<li><a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a></li>
						<li>Discord · Telegram · Slack</li>
					</ul>
					<p class="home-compat-note">
						Keep MQTT on your LAN; mirror to ThermalTrace over HTTPS for household freeze alerts and history.
						<a class="text-link" href="/integrations/home-assistant">HACS integration</a>
						·
						<a class="text-link" href="/about/adding-devices#mqtt-bridge">MQTT bridge recipe</a>
						·
						<a class="text-link" href="/compare/diy-mqtt">vs DIY MQTT</a>
					</p>
				</section>

				<HomePwaCard />

				<section class="home-features" aria-label="Product highlights">
					<article class="home-feature">
						<h2 class="home-feature-title">Freeze-aware alerts</h2>
						<p class="home-feature-copy">
							Threshold freeze alerts on every plan, plus automatic leak alerts when a flood sensor is wet. Member adds forecast cold-risk and Pro adds official NWS freeze alerts—across email, SMS, push, and webhooks.
							<a class="text-link" href="/about/cold-snap-playbook">Cold-snap playbook</a>
							·
							<a class="text-link" href="/about/alert-channel-cookbook">Channel cookbook</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Your sensors</h2>
						<p class="home-feature-copy">
							ESP/Arduino push ingest or HTTPS JSON feeds — probes, doors, leaks, air quality, power, energy, and motion.
							<a class="text-link" href="/about/ingest-and-webhooks">Ingest guide</a>
							·
							<a class="text-link" href="/docs/api">HTTP API</a>
							·
							<a class="text-link" href="/about/dht22-sensor-overview">DHT22 overview</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Household ready</h2>
						<p class="home-feature-copy">
							Share access, history, and status pages without handing out a login password. Pro adds guest share links and a printable <a class="text-link" href="/claims-pack">claims evidence pack</a> when you need a paper trail.
							<a class="text-link" href="/about/household-sharing-walkthrough">Sharing walkthrough</a>
						</p>
					</article>
				</section>

				<section class="card home-guides">
					<div class="home-guides-copy">
						<h2 class="card-title">Guides by job</h2>
						<p class="card-subtitle mb-0">
							Hardware setup, freeze alerts, sharing, and the API — then the full About library if you want every article.
						</p>
					</div>
					<div class="home-guides-actions">
						<a class="btn-primary" href="/guides">Open the guides hub</a>
						<a class="btn-secondary" href="/about">All articles</a>
						<a class="btn-secondary" href="/about/esp32-ota-firmware">ESP32 setup</a>
					</div>
				</section>

				<p class="home-oss mb-0">
					The dashboard and sample sensor sketches are public.
					<a class="text-link" href="https://github.com/doodersrage/thermaltrace" target="_blank" rel="noreferrer">View source on GitHub</a>.
				</p>

				<FaqSection
					faqs={homeFaqs}
					lede="Straight answers for homeowners wiring probes and setting freeze alerts."
				/>
			</div>
		</div>
	) : (
		<div class="page-shell page-stack">
			<div class="grid gap-6">
				{showGarageTemps && <LiveTempsPanel client:visible />}
				{showWeather && (
					<WeatherPanel client:visible cityId={preferences?.weatherCityId ?? null} owmApiKey={owmApiKey || null} />
				)}
				{!showGarageTemps && !showWeather && (
					<div class="empty-state">
						<p class="empty-state-title">Home panels are hidden</p>
						<p class="mb-0">Update your display preferences to show live readings again.</p>
						<div class="empty-state-actions">
							<a class="btn-primary" href="/dashboard/settings">Open settings</a>
						</div>
					</div>
				)}
			</div>
		</div>
	)}
</Layout>
