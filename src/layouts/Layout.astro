---
import { Image, Font } from 'astro:assets';
import '../styles/global.css'
const currentYear = new Date().getFullYear();
import logo from '../assets/gtm.svg';
import { getAuthFromCookies } from "../lib/auth";
import { resolveTheme } from "../lib/userPreferences";
import SchemaMarkup from "../components/SchemaMarkup.astro";
import {
  getDefaultDescription,
  getSiteSchemas,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { BRAND_NAME, BRAND_NAME_TM } from "../lib/brand";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SentryClient from "../components/SentryClient.astro";
import { shouldLoadGoogleAnalytics } from "../lib/analytics";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  skipAuth?: boolean;
}

const { title, description, schema, ogImage, skipAuth = false } = Astro.props;
const pageTitle = title ? `${title} · ${BRAND_NAME}` : BRAND_NAME;
const metaDescription = description ?? getDefaultDescription();
const siteUrl = resolveSiteUrl(Astro.site);
const ogImageUrl = ogImage ?? `${siteUrl}/og-dashboard.png`;

const { user } = skipAuth
  ? { user: null }
  : await getAuthFromCookies(Astro.cookies);

const themeCookie = Astro.cookies.get("theme")?.value;
const userTheme = (user?.user_metadata as Record<string, unknown> | undefined)?.theme;
const themePref =
  themeCookie === "light" || themeCookie === "system" || themeCookie === "dark"
    ? themeCookie
    : userTheme === "light" || userTheme === "system"
      ? userTheme
      : "dark";
const resolvedTheme = resolveTheme(themePref);

const currentPath = Astro.url.pathname;
const pageUrl = resolvePageUrl(siteUrl, currentPath);
const extraSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const schemas = getSiteSchemas({
  siteUrl,
  pageUrl,
  pageName: pageTitle,
  pageDescription: metaDescription,
  extraSchemas,
});

const navItems = [
  { href: "/pricing", label: "Pricing", match: (path: string) => path.startsWith("/pricing") },
  { href: "/compare", label: "Compare", match: (path: string) => path.startsWith("/compare") },
  {
    href: "/freeze-map",
    label: "Freeze map",
    match: (path: string) => path.startsWith("/freeze-map"),
  },
  {
    href: "/about",
    label: "About",
    match: (path: string) => path === "/about" || path.startsWith("/about/"),
  },
  { href: "/contact", label: "Contact", match: (path: string) => path.startsWith("/contact") },
];
const isDashboard = currentPath.startsWith("/dashboard");
const loadAnalytics = shouldLoadGoogleAnalytics(currentPath);
const loadTurnstile =
  currentPath.startsWith("/contact") ||
  currentPath.startsWith("/signin") ||
  currentPath.startsWith("/register") ||
  currentPath.startsWith("/forgot-password");
const registerServiceWorker =
  currentPath.startsWith("/dashboard") || currentPath.startsWith("/signin");
---
<!doctype html>
<html lang="en" data-theme={resolvedTheme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={metaDescription} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content={resolvedTheme === "light" ? "#f1f5f9" : "#090b0f"} />
		<link rel="canonical" href={pageUrl} />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" preload />
		<SchemaMarkup schemas={schemas} />
		{loadAnalytics && (
			<GoogleAnalytics
				pageTitle={pageTitle}
				pageUrl={pageUrl}
				hostname={Astro.url.hostname}
			/>
		)}
		<SentryClient />
	</head>
	<body class:list={[isDashboard && "is-dashboard"]}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="flex min-h-screen flex-col">
			<header class="site-header">
				<div class="site-header-inner">
					<a href="/" class="site-logo-link">
						<Image src={logo} height={44} width={260} alt="ThermalTrace" class="site-logo" />
					</a>
					<button
						type="button"
						class="site-nav-toggle btn-ghost lg:hidden"
						aria-expanded="false"
						aria-controls="site-nav"
						id="site-nav-toggle"
					>
						Menu
					</button>
					<nav id="site-nav" class="site-nav" aria-label="Main">
						{!isDashboard && (
							<div class="site-nav-primary">
								{navItems.map(({ href, label, match }) => (
									<a
										href={href}
										class:list={["nav-link", match(currentPath) && "nav-link-active"]}
									>
										{label}
									</a>
								))}
							</div>
						)}
						<div class="site-nav-actions">
							{user ? (
								<>
									<a
										href="/dashboard"
										class:list={[
											"nav-link",
											(currentPath === "/dashboard" ||
												currentPath.startsWith("/dashboard/")) &&
												"nav-link-active",
										]}
									>
										Dashboard
									</a>
									<a href="/api/auth/signout" class="nav-link">Sign out</a>
								</>
							) : (
								<>
									<a
										href="/signin"
										class:list={[
											"nav-link",
											currentPath === "/signin" && "nav-link-active",
										]}
									>
										Sign in
									</a>
									{!isDashboard && (
										<a href="/register" class="nav-cta">Get started</a>
									)}
								</>
							)}
						</div>
					</nav>
				</div>
			</header>
			<main id="main-content" class="flex-grow">
				<slot />
			</main>
			{!isDashboard && (
				<footer class="site-footer">
					<div class="site-footer-inner">
						<div class="site-footer-grid">
							<div>
								<p class="site-footer-brand">{BRAND_NAME_TM}</p>
								<p class="site-footer-copy">
									Open-source temperature probe curves, freeze alerts, and history — track, log, and analyze conditions before cold snaps do damage.
								</p>
							</div>
							<div>
								<p class="site-footer-heading">Product</p>
								<ul class="site-footer-links">
									<li><a href="/pricing">Pricing</a></li>
									<li><a href="/compare">Compare</a></li>
									<li><a href="/freeze-map">Freeze map</a></li>
									<li><a href="/system-status">System status</a></li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">Learn</p>
								<ul class="site-footer-links">
									<li><a href="/about">About & guides</a></li>
									<li><a href="/about/temperature-probe-case-study">Case study</a></li>
									<li><a href="/about/probe-demo">Probe demo</a></li>
									<li><a href="/stories/garage-freeze-alert">Customer story</a></li>
									<li>
										<a
											href="https://github.com/doodersrage/thermaltrace"
											target="_blank"
											rel="noreferrer"
										>GitHub</a>
									</li>
									<li>
										<a
											href="https://doodersrage.github.io/thermaltrace/"
											target="_blank"
											rel="noreferrer"
										>Developer docs</a>
									</li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">Account</p>
								<ul class="site-footer-links">
									{user ? (
										<>
											<li><a href="/dashboard">Dashboard</a></li>
											<li><a href="/dashboard/settings">Settings</a></li>
											<li><a href="/api/auth/signout">Sign out</a></li>
										</>
									) : (
										<>
											<li><a href="/signin">Sign in</a></li>
											<li><a href="/register">Create account</a></li>
										</>
									)}
									<li><a href="/contact">Contact</a></li>
									<li><a href="/privacy">Privacy</a></li>
									<li><a href="/terms">Terms</a></li>
								</ul>
							</div>
						</div>
						<p class="site-footer-legal">
							Copyright © {currentYear} ThermalTrace. All rights reserved.
							{" · "}
							<a href="/privacy">Privacy</a>
							{" · "}
							<a href="/terms">Terms</a>
						</p>
					</div>
				</footer>
			)}
		</div>
		{loadTurnstile && (
			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
		)}
		<script src="/nudge-dismiss.js" defer is:inline />
		<script is:inline define:vars={{ registerServiceWorker }}>
			(() => {
				const toggle = document.getElementById("site-nav-toggle");
				const nav = document.getElementById("site-nav");
				if (!toggle || !nav) return;

				const setOpen = (open) => {
					nav.classList.toggle("site-nav-open", open);
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
					toggle.textContent = open ? "Close" : "Menu";
				};

				toggle.addEventListener("click", (event) => {
					event.stopPropagation();
					setOpen(!nav.classList.contains("site-nav-open"));
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") setOpen(false);
				});

				document.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Node)) return;
					if (!nav.contains(target) && !toggle.contains(target)) {
						setOpen(false);
					}
				});

				nav.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => setOpen(false));
				});
			})();

			document.addEventListener("click", async (event) => {
				const target = event.target;
				if (!(target instanceof HTMLElement)) return;
				const btn = target.closest("[data-copy]");
				if (!(btn instanceof HTMLElement)) return;
				const text = btn.getAttribute("data-copy");
				if (!text) return;
				const label = btn.getAttribute("data-copy-label") || "Copy";
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = "Copied";
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				} catch {
					btn.textContent = "Copy failed";
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				}
			});

			if (registerServiceWorker && "serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js?v=3").catch(() => {});
				});
			}
		</script>
	</body>
</html>
