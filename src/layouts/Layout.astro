---
import { Image } from 'astro:assets';
import '../styles/global.css'
const currentYear = new Date().getFullYear();
import logo from '../assets/gtm.svg';
import { getAuthFromCookies } from "../lib/auth";
import SchemaMarkup from "../components/SchemaMarkup.astro";
import {
  getDefaultDescription,
  getSiteSchemas,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, schema, ogImage } = Astro.props;
const pageTitle = title ? `${title} · Garage Temperature Monitor` : 'Garage Temperature Monitor';
const metaDescription = description ?? getDefaultDescription();
const siteUrl = resolveSiteUrl(Astro.site);
const ogImageUrl = ogImage ?? `${siteUrl}/logo.svg`;

const { user } = await getAuthFromCookies(Astro.cookies);

const currentPath = Astro.url.pathname;
const pageUrl = resolvePageUrl(siteUrl, currentPath);
const extraSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const schemas = getSiteSchemas({
  siteUrl,
  pageUrl,
  pageName: pageTitle,
  pageDescription: metaDescription,
  extraSchemas,
});

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={metaDescription} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#090b0f" />
		<link rel="canonical" href={pageUrl} />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<SchemaMarkup schemas={schemas} />
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YKDZ0787JG"></script>
		<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-YKDZ0787JG');
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="flex min-h-screen flex-col">
			<header class="site-header">
				<div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
					<a href="/" class="site-logo-link flex items-center gap-3">
						<Image src={logo} height={48} width={311} alt="Garage Temperature Probe" class="site-logo" />
					</a>
					<button
						type="button"
						class="site-nav-toggle btn-ghost lg:hidden"
						aria-expanded="false"
						aria-controls="site-nav"
						id="site-nav-toggle"
					>
						Menu
					</button>
					<nav id="site-nav" class="site-nav" aria-label="Main">
						{navItems.map(({ href, label }) => (
							<a
								href={href}
								class:list={["nav-link", currentPath === href && "nav-link-active"]}
							>
								{label}
							</a>
						))}
						{user ? (
							<>
								<a href="/dashboard" class:list={["nav-link", currentPath === "/dashboard" && "nav-link-active"]}>Dashboard</a>
								<a href="/api/auth/signout" class="nav-link">Sign out</a>
							</>
						) : (
							<a href="/signin" class:list={["nav-link", currentPath === "/signin" && "nav-link-active"]}>Sign in</a>
						)}
					</nav>
				</div>
			</header>
			<main id="main-content" class="flex-grow">
				<slot />
			</main>
			<footer class="site-footer">
				<div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-center gap-2 px-4 py-6 text-center sm:px-6 lg:px-8">
					<p class="m-0">Copyright © {currentYear} Garage Temperature Monitor. All rights reserved.</p>
				</div>
			</footer>
		</div>
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
		<script is:inline>
			const toggle = document.getElementById("site-nav-toggle");
			const nav = document.getElementById("site-nav");
			if (toggle && nav) {
				toggle.addEventListener("click", () => {
					const open = nav.classList.toggle("site-nav-open");
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
				});
			}
		</script>
	</body>
</html>
