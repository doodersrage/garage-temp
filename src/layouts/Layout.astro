---
import { Image } from 'astro:assets';
import '../styles/global.css'
const currentYear = new Date().getFullYear();
import logo from '../assets/gtm.svg';
import { getAuthFromCookies } from "../lib/auth";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · Garage Temperature Monitor` : 'Garage Temperature Monitor';

const { user } = await getAuthFromCookies(Astro.cookies);

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YKDZ0787JG"></script>
		<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-YKDZ0787JG');
		</script>
	</head>
	<body>
		<div class="flex min-h-screen flex-col">
			<header class="site-header">
				<div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
					<a href="/" class="flex items-center gap-3">
						<Image src={logo} height={48} alt="Garage Temperature Monitor logo" />
					</a>
					<nav class="flex flex-wrap items-center justify-end gap-1">
						{navItems.map(({ href, label }) => (
							<a
								href={href}
								class:list={["nav-link", currentPath === href && "nav-link-active"]}
							>
								{label}
							</a>
						))}
						{user ? (
							<>
								<a href="/dashboard" class:list={["nav-link", currentPath === "/dashboard" && "nav-link-active"]}>Dashboard</a>
								<a href="/dashboard/history" class:list={["nav-link", currentPath === "/dashboard/history" && "nav-link-active"]}>History</a>
								<a href="/api/auth/signout" class="nav-link">Sign out</a>
							</>
						) : (
							<a href="/signin" class:list={["nav-link", currentPath === "/signin" && "nav-link-active"]}>Sign in</a>
						)}
					</nav>
				</div>
			</header>
			<main class="flex-grow">
				<slot />
			</main>
			<footer class="site-footer">
				<div class="mx-auto flex w-full max-w-6xl items-center justify-center px-4 py-6 sm:px-6 lg:px-8">
					Copyright © {currentYear} Garage Temperature Monitor. All rights reserved.
				</div>
			</footer>
		</div>
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
	</body>
</html>
