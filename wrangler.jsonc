{
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "garage-temp",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	"send_email": [
		{
		"name": "MAILER",
		"destination_address": "doodersrage@gmail.com"
		}
  	],
	"triggers": {
		"crons": ["0 * * * *"]
	}
}