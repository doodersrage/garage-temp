{
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "garage-temp",
	"main": "./src/worker.ts",
	"workers_dev": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Static @astrojs/sitemap XML was 404ing from Assets; serve SSR routes instead.
		"run_worker_first": [
			"/sitemap-0.xml",
			"/sitemap-index.xml",
			"/robots.txt"
		]
	},
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Primary domain + legacy hostnames (middleware 301s legacy → apex).
	"routes": [
		{
			"pattern": "thermaltrace.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.thermaltrace.dev",
			"custom_domain": true
		},
		{
			"pattern": "garage-temp.robmcd.name",
			"custom_domain": true
		},
		{
			"pattern": "thermaltrace.robmcd.name",
			"custom_domain": true
		}
	],
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	"send_email": [
		{
			"name": "MAILER"
			// Unrestricted: required for drip/trial/alert mail to arbitrary user addresses.
			// Requires Cloudflare Email Sending enabled for the SMTP_MAIL_FROM domain
			// (Dashboard → Email → Email Sending, or: wrangler email sending enable <domain>).
			// Contact form still sends to SMTP_MAIL_TO.
		}
	],
	"triggers": {
		"crons": ["0 * * * *", "15,30,45 * * * *"]
	},
	"r2_buckets": [
		{
			"binding": "HISTORY_ARCHIVE",
			"bucket_name": "thermaltrace-history"
		}
	],
	"browser": {
		"binding": "BROWSER"
	}
}