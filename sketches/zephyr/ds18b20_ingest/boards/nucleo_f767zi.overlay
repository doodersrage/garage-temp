/*
 * DS18B20 on Arduino D4 of Nucleo-F767ZI (PF14).
 * External 4.7k pull-up from data to 3.3V is still required — SoC pull-ups are weak.
 */

/ {
	w1: w1 {
		compatible = "zephyr,w1-gpio";
		gpios = <&gpiof 14 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		ds18b20: ds18b20 {
			compatible = "maxim,ds18b20";
			family-code = <0x28>;
			resolution = <12>;
			status = "okay";
		};
	};
};
