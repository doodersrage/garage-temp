{
  "name": "ThermalTrace",
  "short_name": "ThermalTrace",
  "description": "Open-source dashboard to track, log, and analyze temperature probe curves — with live readings, freeze alerts, and history.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090b0f",
  "theme_color": "#090b0f",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon.ico",
      "sizes": "48x48",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard"
    },
    {
      "name": "History",
      "short_name": "History",
      "url": "/dashboard/history"
    }
  ]
}
